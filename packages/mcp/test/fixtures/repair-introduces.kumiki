slot n  : Int  = 0
slot cn : Text = ""
reducer bump on=ui.click(Btn) do= n := cnt + 1
tile Btn  = button(text="go")
tile Page = column(Btn, text(n))
test bumps =
    reducer-test bump
        given  = {slots: {n: 0}, event: {type: ui.click, target: Btn}}
        expect = {slots: {n: 9}}
app A
    caps   = []
    routes = {"/" -> Page, "/404" -> Page}
    init   = []
