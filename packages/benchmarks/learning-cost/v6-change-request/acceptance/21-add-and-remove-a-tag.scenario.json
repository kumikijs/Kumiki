{
  "effects": {
    "loadProjects": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ],
    "loadTasks": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ],
    "loadComments": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ]
  },
  "defaultEffect": {
    "outcome": "ok",
    "value": {
      "_tag": "None"
    }
  },
  "steps": [
    {
      "do": {
        "navigate": "/"
      }
    },
    {
      "do": {
        "fill": "#project-name",
        "value": "Website"
      }
    },
    {
      "do": {
        "clickText": "Create project"
      }
    },
    {
      "do": {
        "clickText": "New task"
      }
    },
    {
      "do": {
        "fill": "#task-title",
        "value": "Design header"
      }
    },
    {
      "do": {
        "clickText": "Create task"
      }
    },
    {
      "do": {
        "fill": "#tag-input",
        "value": "urgent"
      }
    },
    {
      "label": "Add tag adds it",
      "do": {
        "clickText": "Add tag"
      },
      "expect": {
        "domIncludes": ["urgent"]
      }
    },
    {
      "label": "Remove tag removes it",
      "do": {
        "clickText": "Remove tag"
      },
      "expect": {
        "domExcludes": ["urgent"]
      }
    }
  ]
}
