{
  "effects": {
    "loadProjects": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ],
    "loadTasks": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ],
    "loadComments": [
      {
        "outcome": "ok",
        "value": {
          "_tag": "None"
        }
      }
    ]
  },
  "defaultEffect": {
    "outcome": "ok",
    "value": {
      "_tag": "None"
    }
  },
  "steps": [
    {
      "do": {
        "navigate": "/"
      }
    },
    {
      "do": {
        "fill": "#project-name",
        "value": "Website"
      }
    },
    {
      "do": {
        "clickText": "Create project"
      }
    },
    {
      "do": {
        "clickText": "New task"
      }
    },
    {
      "do": {
        "fill": "#task-title",
        "value": "Design header"
      }
    },
    {
      "do": {
        "choose": "#task-priority",
        "value": "High"
      }
    },
    {
      "do": {
        "clickText": "Create task"
      }
    },
    {
      "do": {
        "clickText": "Back"
      }
    },
    {
      "label": "the project shows the task's title, status and priority",
      "expect": {
        "domIncludes": ["Design header", "Backlog", "High"],
        "domExcludes": ["No tasks"]
      }
    }
  ]
}
