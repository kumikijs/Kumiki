# Kanban Board SPA in Kumiki

# --- Types ---

type CardId = nominal Text

type Column = Todo | Doing | Done

type Card = {
    id: CardId,
    title: Text,
    column: Column,
    createdAt: Time
}

# --- Slots ---

slot cards        : Map(CardId, Card)       = {}
slot draft        : Text                    = ""
slot storageError : Option(Text)  transient = None

# --- Effects ---

effect loadCards
    cap=storage.read
    in=Unit
    out=Result(Option(Map(CardId, Card)), Text)
    policy=once
    map-request={key: "kanban-cards", decode: Decoder.Json(Map(CardId, Card))}

effect saveCards
    cap=storage.write
    in=Map(CardId, Card)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kanban-cards", value: $1}

# --- Pure Functions ---

fn columnLabel(col: Column) -> Text
    = match col with
        | Todo  -> "Todo"
        | Doing -> "Doing"
        | Done  -> "Done"

fn prevColumn(col: Column) -> Column
    = match col with
        | Todo  -> Todo
        | Doing -> Todo
        | Done  -> Doing

fn nextColumn(col: Column) -> Column
    = match col with
        | Todo  -> Doing
        | Doing -> Done
        | Done  -> Done

fn isFirstColumn(col: Column) -> Bool
    = match col with
        | Todo  -> true
        | Doing -> false
        | Done  -> false

fn isLastColumn(col: Column) -> Bool
    = match col with
        | Todo  -> false
        | Doing -> false
        | Done  -> true

fn cardTitle(cs: Map(CardId, Card), id: CardId) -> Text
    = match cs.get(id) with
        | Some(c) -> c.title
        | None    -> ""

fn cardColumn(cs: Map(CardId, Card), id: CardId) -> Column
    = match cs.get(id) with
        | Some(c) -> c.column
        | None    -> Todo

fn columnCards(cs: Map(CardId, Card), col: Column) -> List(CardId)
    = cs.entries
        .filter($2.column == col)
        .sort-by($2.createdAt)
        .map($1)

fn columnCount(cs: Map(CardId, Card), col: Column) -> Int
    = cs.filter($2.column == col).size

# --- Reducers ---

reducer addCard
    on=ui.submit(NewCardForm)
    do= let trimmed = draft.trim
        if !trimmed.is-empty then {
            let id = CardId.fresh()
            cards[id] := {id: id, title: trimmed, column: Todo, createdAt: now}
            draft := ""
            emit saveCards(cards)
        }

reducer moveLeft
    on=ui.click(MoveLeftBtn)
    do= match cards.get($el.cardId) with
          | Some(c) -> {
              if c.column != Todo then {
                  cards[$el.cardId].column := prevColumn(c.column)
                  emit saveCards(cards)
              }
            }

reducer moveRight
    on=ui.click(MoveRightBtn)
    do= match cards.get($el.cardId) with
          | Some(c) -> {
              if c.column != Done then {
                  cards[$el.cardId].column := nextColumn(c.column)
                  emit saveCards(cards)
              }
            }

reducer deleteCard
    on=ui.click(DeleteBtn)
    do= if cards.has($el.cardId) then {
            cards := cards.remove($el.cardId)
            emit saveCards(cards)
        }

reducer cardsLoaded
    on=loadCards.ok($maybeCards, _)
    do= cards := $maybeCards.get-or({})
        storageError := None

reducer cardsLoadFailed
    on=loadCards.err($err, _)
    do= storageError := Some($err)

reducer cardsSaved
    on=saveCards.ok(_, _)
    do= storageError := None

reducer cardsSaveFailed
    on=saveCards.err($err, _)
    do= storageError := Some($err)

# --- Tiles ---

tile NewCardForm
    = form(
        row(
          input(bind=draft, placeholder="Add a new card...") {
            w: "full",
            pad: "sm",
            radius: "sm"
          },
          button(text="Add", type="submit", disabled=draft.trim.is-empty) {
            bg: "primary",
            color: "bg",
            pad-x: "md",
            pad-y: "sm",
            radius: "sm"
          }
        ) {gap: "sm", align: "center"}
      )

tile MoveLeftBtn in=CardId
    = button(text="←", type="button", disabled=isFirstColumn(cardColumn(cards, $1))) {
        cardId: $1,
        aria-label: "Move card left",
        bg: "surface",
        color: "fg",
        pad-x: "sm",
        pad-y: "xs",
        radius: "sm"
      }

tile MoveRightBtn in=CardId
    = button(text="→", type="button", disabled=isLastColumn(cardColumn(cards, $1))) {
        cardId: $1,
        aria-label: "Move card right",
        bg: "surface",
        color: "fg",
        pad-x: "sm",
        pad-y: "xs",
        radius: "sm"
      }

tile DeleteBtn in=CardId
    = button(text="✕", type="button") {
        cardId: $1,
        aria-label: "Delete card",
        bg: "danger",
        color: "bg",
        pad-x: "sm",
        pad-y: "xs",
        radius: "sm"
      }

tile CardItem in=CardId
    = card(
        column(
          text(cardTitle(cards, $1)) {weight: "medium", color: "fg"},
          row(
            row(
              MoveLeftBtn($1),
              MoveRightBtn($1)
            ) {gap: "xs"},
            DeleteBtn($1)
          ) {justify: "between", align: "center"}
        ) {gap: "sm"}
      ) {bg: "bg", pad: "md", radius: "md", shadow: "sm"}

tile KanbanColumn in=Column
    = panel(
        column(
          heading(fmt("{0} ({1})", columnLabel($1), columnCount(cards, $1)), level=2) {
            size: "lg",
            weight: "bold",
            color: "fg"
          },
          divider(),
          when(columnCount(cards, $1) == 0,
            text("No cards") {color: "muted", size: "sm"}),
          column(
            for id in columnCards(cards, $1)
              CardItem(id) {key: id.show}
          ) {gap: "sm"}
        ) {gap: "md"}
      ) {bg: "surface", pad: "md", radius: "md"}

tile KanbanBoard
    = page(
        column(
          row(
            heading("Kanban Board", level=1) {size: "xl", weight: "bold", color: "fg"},
            text(fmt("{0} cards", cards.size)) {color: "muted", size: "sm"}
          ) {justify: "between", align: "center"},
          NewCardForm,
          when(storageError.is-some,
            box(
              text(storageError.get-or("")) {color: "danger", size: "sm"}
            ) {bg: "surface", pad: "sm", radius: "sm"}),
          grid(
            KanbanColumn(Todo),
            KanbanColumn(Doing),
            KanbanColumn(Done)
          ) {cols: 3, gap: "md"}
        ) {gap: "lg", pad: "lg", max-w: 1200}
      )

tile NotFound
    = page(
        column(
          heading("404", level=1) {size: "xl", weight: "bold", color: "fg"},
          text("Page not found") {color: "muted"},
          link("Back to board", to="/") {color: "primary"}
        ) {gap: "md", pad: "lg", align: "center"}
      )

# --- Theme ---

theme KanbanTheme = {
    colors: {
        bg:      "#ffffff",
        fg:      "#1a1a1a",
        muted:   "#666666",
        primary: "#0070f3",
        success: "#0a7c2f",
        warning: "#b07c00",
        danger:  "#c4222a",
        surface: "#f5f6f8",
        border:  "#e0e4e8"
    },
    spacing: {
        xs: "4px",
        sm: "8px",
        md: "16px",
        lg: "24px",
        xl: "40px"
    },
    radius: {
        none: "0",
        sm:   "4px",
        md:   "8px",
        lg:   "16px",
        pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {
            xs: "12px",
            sm: "14px",
            md: "16px",
            lg: "20px",
            xl: "28px"
        },
        weight: {
            normal: "400",
            medium: "500",
            bold:   "700"
        },
        line-height: "1.5"
    },
    shadow: {
        none: "none",
        sm:   "0 1px 2px rgba(0,0,0,0.08)",
        md:   "0 4px 8px rgba(0,0,0,0.1)",
        lg:   "0 8px 24px rgba(0,0,0,0.15)"
    },
    breakpoints: {
        sm: "640px",
        md: "768px",
        lg: "1024px",
        xl: "1280px"
    }
}

# --- App ---

app KanbanApp
    caps   = [storage.read, storage.write, nav.push]
    routes = {
        "/"    -> KanbanBoard,
        "/404" -> NotFound
    }
    init   = [loadCards()]
    theme  = KanbanTheme
    meta   = {
        title:       "Kanban Board",
        description: "Three-column Kanban board built with Kumiki"
    }
