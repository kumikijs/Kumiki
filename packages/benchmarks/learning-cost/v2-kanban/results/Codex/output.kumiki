type Column = Todo | Doing | Done
type CardId = nominal Text
type Card = {id: CardId, title: Text, column: Column, createdAt: Time}

slot cards : Map(CardId, Card) = {}
slot draft : Text = ""
slot ready : Bool = false
slot storageProblem : Text = ""

effect loadCards cap=storage.read
    in=Unit
    out=Result(Option(Map(CardId, Card)), Text)
    policy=once
    map-request={key: "kanban-cards", decode: Decoder.Json(Map(CardId, Card))}

effect saveCards cap=storage.write
    in=Map(CardId, Card)
    out=Result(Unit, Text)
    policy=queue
    map-request={key: "kanban-cards", value: $1}

reducer start on=app.start do=
    emit loadCards()

reducer cardsLoaded on=loadCards.ok($saved, _) do=
    cards := $saved.get-or({})
    ready := true

reducer loadFailed on=loadCards.err($error, _) do=
    storageProblem := $error
    ready := true

reducer saveFailed on=saveCards.err($error, _) do=
    storageProblem := $error

reducer addCard on=ui.click(AddButton) do=
    if ready && draft.trim() != "" then {
        let id = CardId.fresh()
        cards[id] := {id: id, title: draft.trim(), column: Todo, createdAt: now}
        draft := ""
        emit saveCards(cards)
    }

reducer moveLeft on=ui.click(LeftButton) do=
    match cards.get($el.cardId) with
    | Some(card) -> {
        cards[$el.cardId].column := previous(card.column)
        emit saveCards(cards)
    }
    | None -> ()

reducer moveRight on=ui.click(RightButton) do=
    match cards.get($el.cardId) with
    | Some(card) -> {
        cards[$el.cardId].column := next(card.column)
        emit saveCards(cards)
    }
    | None -> ()

reducer deleteCard on=ui.click(DeleteButton) do=
    cards := cards.remove($el.cardId)
    emit saveCards(cards)

fn previous(column: Column) -> Column =
    match column with
    | Todo -> Todo
    | Doing -> Todo
    | Done -> Doing

fn next(column: Column) -> Column =
    match column with
    | Todo -> Doing
    | Doing -> Done
    | Done -> Done

fn columnName(column: Column) -> Text =
    match column with
    | Todo -> "Todo"
    | Doing -> "Doing"
    | Done -> "Done"

fn cardCount(all: Map(CardId, Card), column: Column) -> Int =
    all.filter($2.column == column).size

fn orderedCards(all: Map(CardId, Card), column: Column) -> List(CardId) =
    all.filter($2.column == column).entries.sort-by($2.createdAt).map($1)

tile AddButton = button(text="Add", disabled=not ready || draft.trim() == "")
    {bg: "primary", color: "onPrimary", pad: "sm", radius: "sm"}

tile LeftButton in=Card = button(text="←", disabled=$1.column == Todo)
    {cardId: $1.id, aria-label: "Move card left", pad: "xs", radius: "sm"}

tile RightButton in=Card = button(text="→", disabled=$1.column == Done)
    {cardId: $1.id, aria-label: "Move card right", pad: "xs", radius: "sm"}

tile DeleteButton in=Card = button(text="✕")
    {cardId: $1.id, aria-label: "Delete card", color: "danger", pad: "xs", radius: "sm"}

tile CardView in=Card =
    column(
        text($1.title),
        row(
            LeftButton($1),
            RightButton($1),
            DeleteButton($1)
        ) {gap: "xs"}
    ) {bg: "card", pad: "md", radius: "md", gap: "sm", shadow: "sm"}

tile BoardColumn in=Column =
    column(
        heading(columnName($1) + " (" + cardCount(cards, $1).show + ")", level=2),
        for id in orderedCards(cards, $1)
            CardView(cards[id]) {key: id.show}
    ) {bg: "surface", pad: "md", radius: "md", gap: "sm"}

tile Board =
    page(
        column(
            heading("Kanban board"),
            row(
                input(bind=draft, placeholder="New card", disabled=not ready),
                AddButton
            ) {gap: "sm"},
            when(not ready, text("Loading cards…")),
            when(storageProblem != "", text("Storage error: " + storageProblem) {color: "danger"}),
            grid(
                BoardColumn(Todo),
                BoardColumn(Doing),
                BoardColumn(Done)
            ) {cols: 3, gap: "md"}
        ) {gap: "lg", pad: "lg"}
    ) {bg: "background", color: "foreground"}

tile NotFound = page(heading("Page not found"))

theme BoardTheme = {
    colors: {
        background: "#f4f6fb",
        foreground: "#20283a",
        surface: "#e4e9f2",
        card: "#ffffff",
        primary: "#3157c8",
        onPrimary: "#ffffff",
        danger: "#b42318"
    },
    spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px"},
    radius: {sm: "4px", md: "8px"},
    shadow: {sm: "0 1px 3px rgba(0,0,0,0.12)"}
}

app Kanban
    caps = [storage.read, storage.write]
    routes = {"/" -> Board, "/404" -> NotFound}
    init = []
    theme = BoardTheme
