# ============================================================
# Types
# ============================================================

type ProjectId = nominal Text where uuid
type TaskId    = nominal Text where uuid
type CommentId = nominal Text where uuid

type Status    = Backlog | InProgress | Review | Done
type Priority  = Low | Med | High | Critical
type ViewMode  = ListView | BoardView
type DueStatus = Overdue | Today | Soon | Upcoming | NoDue

type Project = {
    id: ProjectId,
    name: Text,
    description: Text,
    color: Text,
    archived: Bool,
    createdAt: Time
}

type Task = {
    id: TaskId,
    projectId: ProjectId,
    title: Text,
    description: Text,
    status: Status,
    priority: Priority,
    assignee: Text,
    dueDate: Option(Time),
    tags: List(Text),
    parentTaskId: Option(TaskId),
    createdAt: Time,
    updatedAt: Time
}

type Comment = {
    id: CommentId,
    taskId: TaskId,
    author: Text,
    body: Text,
    createdAt: Time
}

type FilterState = {
    status: Option(Status),
    priority: Option(Priority),
    assignee: Text,
    search: Text
}

type DraftProject = {
    name: Text,
    description: Text,
    color: Text
}

type DraftTask = {
    title: Text,
    description: Text,
    priority: Priority,
    assignee: Text,
    tags: Text,
    dueDate: Text
}

type BoardColInput = {
    projectId: ProjectId,
    status: Status
}

type TagItem = {
    taskId: TaskId,
    tag: Text
}

# ============================================================
# Slots
# ============================================================

slot projects          : Map(ProjectId, Project) = {}
slot tasks             : Map(TaskId, Task)       = {}
slot comments          : Map(CommentId, Comment) = {}
slot viewMode          : ViewMode                = ListView
slot filter            : FilterState             = {status: None, priority: None, assignee: "", search: ""}
slot themeName         : Text                    = "Light"
slot draftProject      : DraftProject            = {name: "", description: "", color: "#0070f3"}
slot draftTask         : DraftTask               = {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
slot draftParentTaskId : Option(TaskId)          = None
slot tagDraft          : Text                    = ""
slot commentDraft      : Text                    = ""
slot ready             : Bool                    = false
slot loadedCount       : Int           transient = 0
slot storageError      : Option(Text)  transient = None

# ============================================================
# Effects
# ============================================================

effect saveProjects cap=storage.write
                    in=Map(ProjectId, Project)
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "pm_projects", value: $1}

effect saveTasks    cap=storage.write
                    in=Map(TaskId, Task)
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "pm_tasks", value: $1}

effect saveComments cap=storage.write
                    in=Map(CommentId, Comment)
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "pm_comments", value: $1}

effect loadProjects cap=storage.read
                    in=Unit
                    out=Result(Option(Map(ProjectId, Project)), Text)
                    policy=once
                    map-request={key: "pm_projects", decode: Decoder.Json(Map(ProjectId, Project))}

effect loadTasks    cap=storage.read
                    in=Unit
                    out=Result(Option(Map(TaskId, Task)), Text)
                    policy=once
                    map-request={key: "pm_tasks", decode: Decoder.Json(Map(TaskId, Task))}

effect loadComments cap=storage.read
                    in=Unit
                    out=Result(Option(Map(CommentId, Comment)), Text)
                    policy=once
                    map-request={key: "pm_comments", decode: Decoder.Json(Map(CommentId, Comment))}

# ============================================================
# Pure Functions
# ============================================================

fn statusLabel(s: Status) -> Text
   = match s with
       | Backlog    -> "Backlog"
       | InProgress -> "In Progress"
       | Review     -> "Review"
       | Done       -> "Done"

fn statusColor(s: Status) -> Text
   = match s with
       | Backlog    -> "muted"
       | InProgress -> "primary"
       | Review     -> "warning"
       | Done       -> "success"

fn priorityLabel(p: Priority) -> Text
   = match p with
       | Low      -> "Low"
       | Med      -> "Med"
       | High     -> "High"
       | Critical -> "Critical"

fn priorityColor(p: Priority) -> Text
   = match p with
       | Low      -> "muted"
       | Med      -> "primary"
       | High     -> "warning"
       | Critical -> "danger"

fn nextStatus(s: Status) -> Status
   = match s with
       | Backlog    -> InProgress
       | InProgress -> Review
       | Review     -> Done
       | Done       -> Done

fn viewToggleLabel(m: ViewMode) -> Text
   = match m with
       | ListView  -> "Board view"
       | BoardView -> "List view"

fn statusOptions() -> List({label: Text, value: Status})
   = [
       {label: "Backlog",     value: Backlog},
       {label: "In Progress", value: InProgress},
       {label: "Review",      value: Review},
       {label: "Done",        value: Done}
     ]

fn priorityOptions() -> List({label: Text, value: Priority})
   = [
       {label: "Low",      value: Low},
       {label: "Med",      value: Med},
       {label: "High",     value: High},
       {label: "Critical", value: Critical}
     ]

fn statusFilterOptions() -> List({label: Text, value: Option(Status)})
   = [
       {label: "All",         value: None},
       {label: "Backlog",     value: Some(Backlog)},
       {label: "In Progress", value: Some(InProgress)},
       {label: "Review",      value: Some(Review)},
       {label: "Done",        value: Some(Done)}
     ]

fn priorityFilterOptions() -> List({label: Text, value: Option(Priority)})
   = [
       {label: "All",      value: None},
       {label: "Low",      value: Some(Low)},
       {label: "Med",      value: Some(Med)},
       {label: "High",     value: Some(High)},
       {label: "Critical", value: Some(Critical)}
     ]

fn formatDate(t: Time) -> Text
   = t.format("yyyy-MM-dd")

fn formatOptionalDate(opt: Option(Time)) -> Text
   = match opt with
       | Some(d) -> formatDate(d)
       | None    -> ""

fn dueDateStatus(dueDate: Option(Time)) -> DueStatus
   = match dueDate with
       | None    -> NoDue
       | Some(d) ->
           let todayStr = formatDate(now)
           in let dueStr = formatDate(d)
              in if dueStr == todayStr then Today
                 else if dueStr < todayStr then Overdue
                 else if d < now.plus(Duration.h(72)) then Soon
                 else Upcoming

fn dueStatusLabel(ds: DueStatus) -> Text
   = match ds with
       | Overdue  -> "Overdue"
       | Today    -> "Today"
       | Soon     -> "Soon"
       | Upcoming -> "Upcoming"
       | NoDue    -> ""

fn dueStatusColor(ds: DueStatus) -> Text
   = match ds with
       | Overdue  -> "danger"
       | Today    -> "warning"
       | Soon     -> "warning"
       | Upcoming -> "muted"
       | NoDue    -> "muted"

fn trimTagList(parts: List(Text)) -> List(Text)
   = parts.map($1.trim)

fn parseTags(raw: Text) -> List(Text)
   = if raw.trim.is-empty then []
     else trimTagList(raw.split(",")).filter(!$1.is-empty).unique

fn parseOptionalTaskId(opt: Option(Text)) -> Option(TaskId)
   = match opt with
       | Some(raw) -> TaskId.parse(raw)
       | None      -> None

fn orTaskId(primary: Option(TaskId), fallback: Option(TaskId)) -> Option(TaskId)
   = match primary with
       | Some(id) -> Some(id)
       | None     -> fallback

fn isChildOf(parentOpt: Option(TaskId), parentId: TaskId) -> Bool
   = match parentOpt with
       | Some(pid) -> pid == parentId
       | None      -> false

fn matchesFilter(t: Task, f: FilterState) -> Bool
   = let statusOk = (match f.status with
                       | Some(st) -> t.status == st
                       | None     -> true)
     in let priorityOk = (match f.priority with
                            | Some(pr) -> t.priority == pr
                            | None     -> true)
        in let assigneeQ = f.assignee.trim.lower
           in let assigneeOk = if assigneeQ.is-empty then true else t.assignee.lower.contains(assigneeQ)
              in let searchQ = f.search.trim.lower
                 in let searchOk = if searchQ.is-empty then true else t.title.lower.contains(searchQ)
                    in statusOk && priorityOk && assigneeOk && searchOk

fn sortedProjectIds(ps: Map(ProjectId, Project)) -> List(ProjectId)
   = ps.entries
       .sort-by(-$2.createdAt.to-ms)
       .map($1)

fn activeTaskCount(ts: Map(TaskId, Task), projectId: ProjectId) -> Int
   = ts.filter($2.projectId == projectId && $2.status != Done).size

fn tasksForProject(ts: Map(TaskId, Task), projectId: ProjectId) -> List(TaskId)
   = ts.entries
       .filter($2.projectId == projectId)
       .sort-by(-$2.updatedAt.to-ms)
       .map($1)

fn subtasksFor(ts: Map(TaskId, Task), parentId: TaskId) -> List(TaskId)
   = ts.entries
       .filter(isChildOf($2.parentTaskId, parentId))
       .sort-by($2.createdAt.to-ms)
       .map($1)

fn filteredTasks(ts: Map(TaskId, Task), projectId: ProjectId, f: FilterState) -> List(TaskId)
   = ts.entries
       .filter($2.projectId == projectId && matchesFilter($2, f))
       .sort-by(-$2.updatedAt.to-ms)
       .map($1)

fn tasksByStatus(ts: Map(TaskId, Task), projectId: ProjectId, f: FilterState, st: Status) -> List(TaskId)
   = ts.entries
       .filter($2.projectId == projectId && $2.status == st && matchesFilter($2, f))
       .sort-by(-$2.updatedAt.to-ms)
       .map($1)

fn commentsForTask(cs: Map(CommentId, Comment), taskId: TaskId) -> List(CommentId)
   = cs.entries
       .filter($2.taskId == taskId)
       .sort-by($2.createdAt.to-ms)
       .map($1)

fn routeProjectId(r: Route) -> Option(ProjectId)
   = match r.params.get("id") with
       | Some(raw) -> ProjectId.parse(raw)
       | None      -> None

fn routeTaskId(r: Route) -> Option(TaskId)
   = match r.params.get("taskId") with
       | Some(raw) -> TaskId.parse(raw)
       | None      -> None

fn currentProject(r: Route, ps: Map(ProjectId, Project)) -> Option(Project)
   = match routeProjectId(r) with
       | Some(pid) -> ps.get(pid)
       | None      -> None

fn currentTask(r: Route, ts: Map(TaskId, Task)) -> Option(Task)
   = match routeTaskId(r) with
       | Some(tid) -> ts.get(tid)
       | None      -> None

# ============================================================
# Reducers — Lifecycle & Persistence
# ============================================================

reducer loadAll
    on=app.start
    do= emit loadProjects()
        emit loadTasks()
        emit loadComments()

reducer projectsLoaded
    on=loadProjects.ok($maybeProjects, _)
    do= projects := $maybeProjects.get-or({}).merge(projects)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer projectsLoadErr
    on=loadProjects.err($err, _)
    do= storageError := Some($err)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer tasksLoaded
    on=loadTasks.ok($maybeTasks, _)
    do= tasks := $maybeTasks.get-or({}).merge(tasks)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer tasksLoadErr
    on=loadTasks.err($err, _)
    do= storageError := Some($err)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer commentsLoaded
    on=loadComments.ok($maybeComments, _)
    do= comments := $maybeComments.get-or({}).merge(comments)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer commentsLoadErr
    on=loadComments.err($err, _)
    do= storageError := Some($err)
        loadedCount := loadedCount + 1
        if loadedCount >= 3 then ready := true

reducer saveProjectsErr
    on=saveProjects.err($err, _)
    do= storageError := Some($err)

reducer saveTasksErr
    on=saveTasks.err($err, _)
    do= storageError := Some($err)

reducer saveCommentsErr
    on=saveComments.err($err, _)
    do= storageError := Some($err)

reducer toggleTheme
    on=ui.click(ToggleThemeBtn)
    do= themeName := if themeName == "Light" then "Dark" else "Light"

reducer onEnterNewTask
    on=route.enter("/projects/:id/new-task")
    do= draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
        draftParentTaskId := parseOptionalTaskId($route.query.get("parent"))

reducer onEnterTaskDetail
    on=route.enter("/projects/:id/tasks/:taskId")
    do= tagDraft := ""
        commentDraft := ""

# ============================================================
# Reducers — Projects
# ============================================================

reducer createProject
    on=ui.submit(CreateProjectForm)
    do= let trimmedName = draftProject.name.trim
        if !trimmedName.is-empty then {
            let pid = ProjectId.fresh()
            let chosenColor = if draftProject.color.trim.is-empty then "#0070f3" else draftProject.color.trim
            projects[pid] := {
                id: pid,
                name: trimmedName,
                description: draftProject.description.trim,
                color: chosenColor,
                archived: false,
                createdAt: now
            }
            draftProject := {name: "", description: "", color: "#0070f3"}
            emit saveProjects(projects)
            emit navigate({path: "/projects/" + pid.show, params: {}, query: {}})
        }

reducer archiveProject
    on=ui.click(ArchiveProjectBtn)
    do= let pid = $el.projectId
        if projects.has(pid) then {
            projects[pid].archived := true
            emit saveProjects(projects)
        }

reducer unarchiveProject
    on=ui.click(UnarchiveBtn)
    do= let pid = $el.projectId
        if projects.has(pid) then {
            projects[pid].archived := false
            emit saveProjects(projects)
        }

reducer deleteProject
    on=ui.click(DeleteProjectBtn)
    do= let pid = $el.projectId
        let deletedTaskIds = tasksForProject(tasks, pid)
        projects := projects.remove(pid)
        tasks := tasks.filter($2.projectId != pid)
        comments := comments.filter(!deletedTaskIds.contains($2.taskId))
        emit saveProjects(projects)
        emit saveTasks(tasks)
        emit saveComments(comments)

# ============================================================
# Reducers — Tasks
# ============================================================

reducer openNewTask
    on=ui.click(NewTaskBtn)
    do= match routeProjectId(route) with
          | Some(pid) -> emit navigate({path: "/projects/" + pid.show + "/new-task", params: {}, query: {}})
          | None      -> ()

reducer cancelNewTask
    on=ui.click(CancelNewTaskBtn)
    do= match routeProjectId(route) with
          | Some(pid) -> {
              match draftParentTaskId with
                | Some(parentId) -> emit navigate({path: "/projects/" + pid.show + "/tasks/" + parentId.show, params: {}, query: {}})
                | None           -> emit navigate({path: "/projects/" + pid.show, params: {}, query: {}})
            }
          | None -> emit navigate({path: "/", params: {}, query: {}})

reducer backToProject
    on=ui.click(BackToProjectBtn)
    do= match routeProjectId(route) with
          | Some(pid) -> emit navigate({path: "/projects/" + pid.show, params: {}, query: {}})
          | None      -> emit navigate({path: "/", params: {}, query: {}})

reducer openSubtaskForm
    on=ui.click(AddSubtaskBtn)
    do= match tasks.get($el.taskId) with
          | Some(t) -> emit navigate({
              path: "/projects/" + t.projectId.show + "/new-task",
              params: {},
              query: {"parent": t.id.show}
            })
          | None -> ()

reducer createTask
    on=ui.submit(NewTaskForm)
    do= let trimmedTitle = draftTask.title.trim
        if !trimmedTitle.is-empty then {
            match routeProjectId(route) with
              | Some(pid) -> {
                  if projects.has(pid) then {
                      let tid = TaskId.fresh()
                      let parentId = orTaskId(parseOptionalTaskId(route.query.get("parent")), draftParentTaskId)
                      let due = Time.parse(draftTask.dueDate.trim)
                      let parsedTags = parseTags(draftTask.tags)
                      tasks[tid] := {
                          id: tid,
                          projectId: pid,
                          title: trimmedTitle,
                          description: draftTask.description.trim,
                          status: Backlog,
                          priority: draftTask.priority,
                          assignee: draftTask.assignee.trim,
                          dueDate: due,
                          tags: parsedTags,
                          parentTaskId: parentId,
                          createdAt: now,
                          updatedAt: now
                      }
                      draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
                      draftParentTaskId := None
                      emit saveTasks(tasks)
                      emit navigate({path: "/projects/" + pid.show + "/tasks/" + tid.show, params: {}, query: {}})
                  }
                }
              | None -> ()
        }

reducer updateTaskStatus
    on=ui.change(DetailStatusSelect)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].status := $event.value
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer updateTaskPriority
    on=ui.change(DetailPrioritySelect)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].priority := $event.value
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer updateTaskTitle
    on=ui.input(DetailTitleInput)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].title := $event.value
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer updateTaskDescription
    on=ui.input(DetailDescInput)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].description := $event.value
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer updateTaskAssignee
    on=ui.input(DetailAssigneeInput)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].assignee := $event.value
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer updateTaskDueDate
    on=ui.change(DetailDueInput)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].dueDate := Time.parse($event.value.trim)
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer addTaskTag
    on=ui.click(AddTagBtn)
    do= let tid = $el.taskId
        let tg = tagDraft.trim
        if !tg.is-empty && tasks.has(tid) then {
            if !tasks[tid].tags.contains(tg) then {
                tasks[tid].tags := tasks[tid].tags.push(tg)
                tasks[tid].updatedAt := now
                emit saveTasks(tasks)
            }
            tagDraft := ""
        }

reducer removeTaskTag
    on=ui.click(RemoveTagBtn)
    do= let tid = $el.taskId
        let tg = $el.tag
        if tasks.has(tid) then {
            tasks[tid].tags := tasks[tid].tags.filter($1 != tg)
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

reducer deleteTask
    on=ui.click(DeleteTaskBtn)
    do= match tasks.get($el.taskId) with
          | Some(t) -> {
              let pid = t.projectId
              tasks := tasks.remove(t.id)
              comments := comments.filter($2.taskId != t.id)
              emit saveTasks(tasks)
              emit saveComments(comments)
              emit navigate({path: "/projects/" + pid.show, params: {}, query: {}})
            }
          | None -> ()

reducer moveTaskStatus
    on=ui.click(AdvanceTaskBtn)
    do= let tid = $el.taskId
        if tasks.has(tid) then {
            tasks[tid].status := nextStatus(tasks[tid].status)
            tasks[tid].updatedAt := now
            emit saveTasks(tasks)
        }

# ============================================================
# Reducers — Comments
# ============================================================

reducer addComment
    on=ui.click(AddCommentBtn)
    do= let body = commentDraft.trim
        if !body.is-empty then {
            match tasks.get($el.taskId) with
              | Some(t) -> {
                  let cid = CommentId.fresh()
                  comments[cid] := {
                      id: cid,
                      taskId: t.id,
                      author: "User",
                      body: body,
                      createdAt: now
                  }
                  commentDraft := ""
                  emit saveComments(comments)
                }
              | None -> ()
        }

reducer deleteComment
    on=ui.click(DeleteCommentBtn)
    do= comments := comments.remove($el.commentId)
        emit saveComments(comments)

# ============================================================
# Reducers — UI State
# ============================================================

reducer setFilterStatus
    on=ui.change(FilterStatusSelect)
    do= filter.status := $event.value

reducer setFilterPriority
    on=ui.change(FilterPrioritySelect)
    do= filter.priority := $event.value

reducer setFilterAssignee
    on=ui.input(FilterAssigneeInput)
    do= filter.assignee := $event.value

reducer setSearch
    on=ui.input(FilterSearchInput)
    do= filter.search := $event.value

reducer clearFilter
    on=ui.click(ClearFilterBtn)
    do= filter := {status: None, priority: None, assignee: "", search: ""}

reducer setViewMode
    on=ui.click(ViewToggleBtn)
    do= viewMode := match viewMode with
                      | ListView  -> BoardView
                      | BoardView -> ListView

# ============================================================
# Tiles — Shared Controls & Layout
# ============================================================

tile NavHeader
    = region(
        row(
          row(
            link(to="/", text="Project Manager") {size: "lg", weight: "bold"},
            link(to="/", text="Projects"),
            link(to="/settings", text="Settings")
          ) {gap: "md", align: "center"},
          text("Theme: " + themeName) {size: "xs", color: "muted"}
        ) {justify: "between", align: "center", pad-x: "lg", pad-y: "md", bg: "surface"}
      ) {role: "navigation", aria-label: "Main navigation"}

tile ProjectMissing
    = box(
        column(
          heading("Project not found") {level: 2, size: "lg"},
          text("The requested project could not be found.") {color: "muted"},
          link(to="/", text="Back to projects")
        ) {gap: "sm"}
      ) {pad: "lg"}

tile TaskMissing
    = box(
        column(
          heading("Task not found") {level: 2, size: "lg"},
          text("The requested task could not be found.") {color: "muted"},
          link(to="/", text="Back to projects")
        ) {gap: "sm"}
      ) {pad: "lg"}

tile TaskDueBadge in=Option(Time)
    = match $1 with
        | Some(d) -> row(
                       text(formatDate(d)) {size: "xs"},
                       text(dueStatusLabel(dueDateStatus(Some(d)))) {size: "xs", color: dueStatusColor(dueDateStatus(Some(d)))}
                     ) {gap: "xs", align: "center"}
        | None    -> text("")

tile TaskTagList in=List(Text)
    = row(
        for tg in $1
          box(text(tg) {size: "xs"}) {bg: "surface", pad-x: "xs", radius: "pill"}
      ) {gap: "xs", wrap: true}

# ============================================================
# Tiles — Projects Page (/)
# ============================================================

tile ArchiveProjectBtn in=ProjectId
    = button(text="Archive", type="button") {projectId: $1, pad-x: "sm", pad-y: "xs", radius: "sm"}

tile UnarchiveBtn in=ProjectId
    = button(text="Unarchive", type="button") {projectId: $1, pad-x: "sm", pad-y: "xs", radius: "sm"}

tile DeleteProjectBtn in=ProjectId
    = button(text="Delete project", type="button") {projectId: $1, color: "danger", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile CreateProjectForm
    = form(
        panel(
          column(
            heading("New Project") {level: 2, size: "lg"},
            column(
              label("Project name") {for: "project-name"},
              input(id="project-name", bind=draftProject.name, placeholder="Enter project name")
            ) {gap: "xs"},
            column(
              label("Description") {for: "project-description"},
              textarea(id="project-description", bind=draftProject.description, placeholder="Describe this project") {rows: 3}
            ) {gap: "xs"},
            column(
              label("Color") {for: "project-color"},
              input(id="project-color", type="color", bind=draftProject.color)
            ) {gap: "xs"},
            row(
              button(text="Create project", type="submit") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}
            )
          ) {gap: "md"}
        ) {bg: "surface", pad: "md", radius: "md", shadow: "sm"}
      )

tile ProjectCard in=ProjectId
    = match projects.get($1) with
        | Some(p) -> card(
                       column(
                         row(
                           row(
                             box(text("") {size: "xs"}) {w: 12, h: 12, radius: "pill", style: {"background": p.color}},
                             link(to="/projects/" + p.id.show, text=p.name) {size: "lg", weight: "bold"},
                             when(p.archived,
                               box(text("Archived") {size: "xs", color: "warning"}) {bg: "bg", pad-x: "xs", radius: "sm"})
                           ) {gap: "sm", align: "center"},
                           row(
                             if p.archived
                             then UnarchiveBtn(p.id)
                             else ArchiveProjectBtn(p.id),
                             DeleteProjectBtn(p.id)
                           ) {gap: "sm", align: "center"}
                         ) {justify: "between", align: "center", wrap: true},
                         when(!p.description.is-empty,
                           text(p.description) {color: "muted"}),
                         row(
                           text(activeTaskCount(tasks, p.id).show + " active tasks") {size: "sm", color: "muted"},
                           text("Created " + formatDate(p.createdAt)) {size: "xs", color: "muted"}
                         ) {gap: "md", align: "center"}
                       ) {gap: "sm"}
                     ) {bg: "surface", pad: "md", radius: "md", shadow: "sm"}
        | None    -> text("")

tile ProjectListSection
    = if projects.is-empty
      then box(text("No projects") {color: "muted"}) {pad: "lg"}
      else column(
             for pid in sortedProjectIds(projects)
               ProjectCard(pid) {key: pid.show}
           ) {gap: "md"}

tile ProjectsPage
    = page(
        NavHeader,
        box(
          column(
            heading("Projects") {level: 1, size: "xl"},
            CreateProjectForm,
            ProjectListSection
          ) {gap: "lg"}
        ) {max-w: 1000, pad: "lg"}
      )

# ============================================================
# Tiles — Project Page (/projects/:id)
# ============================================================

tile NewTaskBtn
    = button(text="New task", type="button") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile ViewToggleBtn
    = button(text=viewToggleLabel(viewMode), type="button") {bg: "surface", pad-x: "md", pad-y: "sm", radius: "sm"}

tile FilterStatusSelect
    = select(id="filter-status", value=filter.status, options=statusFilterOptions())

tile FilterPrioritySelect
    = select(id="filter-priority", value=filter.priority, options=priorityFilterOptions())

tile FilterAssigneeInput
    = input(id="filter-assignee", value=filter.assignee, placeholder="Filter by assignee")

tile FilterSearchInput
    = input(id="filter-search", value=filter.search, placeholder="Search by title")

tile ClearFilterBtn
    = button(text="Clear filters", type="button") {pad-x: "sm", pad-y: "xs", radius: "sm"}

tile FilterBar
    = panel(
        row(
          column(
            label("Status") {for: "filter-status"},
            FilterStatusSelect
          ) {gap: "xs"},
          column(
            label("Priority") {for: "filter-priority"},
            FilterPrioritySelect
          ) {gap: "xs"},
          column(
            label("Assignee") {for: "filter-assignee"},
            FilterAssigneeInput
          ) {gap: "xs"},
          column(
            label("Search") {for: "filter-search"},
            FilterSearchInput
          ) {gap: "xs"},
          ClearFilterBtn
        ) {gap: "md", align: "end", wrap: true}
      ) {bg: "surface", pad: "md", radius: "md"}

tile AdvanceTaskBtn in=TaskId
    = button(text="Advance", type="button") {taskId: $1, pad-x: "sm", pad-y: "xs", radius: "sm"}

tile TaskListCard in=TaskId
    = match tasks.get($1) with
        | Some(t) -> card(
                       column(
                         row(
                           link(to="/projects/" + t.projectId.show + "/tasks/" + t.id.show, text=t.title) {weight: "bold"},
                           row(
                             text(statusLabel(t.status)) {size: "xs", color: statusColor(t.status)},
                             text(priorityLabel(t.priority)) {size: "xs", color: priorityColor(t.priority)}
                           ) {gap: "sm", align: "center"}
                         ) {justify: "between", align: "center", wrap: true},
                         row(
                           when(!t.assignee.is-empty,
                             text("Assignee: " + t.assignee) {size: "xs", color: "muted"}),
                           TaskDueBadge(t.dueDate)
                         ) {gap: "md", align: "center", wrap: true},
                         when(!t.tags.is-empty,
                           TaskTagList(t.tags))
                       ) {gap: "xs"}
                     ) {bg: "surface", pad: "md", radius: "md", shadow: "sm"}
        | None    -> text("")

tile ProjectListView in=ProjectId
    = if filteredTasks(tasks, $1, filter).is-empty
      then box(text("No tasks") {color: "muted"}) {pad: "lg"}
      else column(
             for tid in filteredTasks(tasks, $1, filter)
               TaskListCard(tid) {key: tid.show}
           ) {gap: "sm"}

tile BoardTaskCard in=TaskId
    = match tasks.get($1) with
        | Some(t) -> card(
                       column(
                         link(to="/projects/" + t.projectId.show + "/tasks/" + t.id.show, text=t.title) {weight: "bold"},
                         row(
                           text(statusLabel(t.status)) {size: "xs", color: statusColor(t.status)},
                           text(priorityLabel(t.priority)) {size: "xs", color: priorityColor(t.priority)}
                         ) {gap: "sm", align: "center"},
                         when(!t.assignee.is-empty,
                           text("Assignee: " + t.assignee) {size: "xs", color: "muted"}),
                         TaskDueBadge(t.dueDate),
                         when(!t.tags.is-empty,
                           TaskTagList(t.tags)),
                         row(
                           AdvanceTaskBtn(t.id)
                         ) {justify: "end"}
                       ) {gap: "xs"}
                     ) {bg: "bg", pad: "sm", radius: "sm", shadow: "sm"}
        | None    -> text("")

tile BoardColumn in=BoardColInput
    = panel(
        column(
          row(
            heading(statusLabel($1.status)) {level: 3, size: "md"},
            text(tasksByStatus(tasks, $1.projectId, filter, $1.status).length.show) {size: "sm", color: "muted"}
          ) {justify: "between", align: "center"},
          divider(),
          column(
            for tid in tasksByStatus(tasks, $1.projectId, filter, $1.status)
              BoardTaskCard(tid) {key: tid.show}
          ) {gap: "sm"}
        ) {gap: "sm"}
      ) {bg: "surface", pad: "md", radius: "md"}

tile ProjectBoardView in=ProjectId
    = column(
        when(filteredTasks(tasks, $1, filter).is-empty,
          box(text("No tasks") {color: "muted"}) {pad: "md"}),
        grid(
          BoardColumn({projectId: $1, status: Backlog}),
          BoardColumn({projectId: $1, status: InProgress}),
          BoardColumn({projectId: $1, status: Review}),
          BoardColumn({projectId: $1, status: Done})
        ) {cols: {base: 1, md: 2, lg: 4}, gap: "md"}
      ) {gap: "md"}

tile ProjectView in=Project
    = column(
        row(
          column(
            row(
              box(text("") {size: "xs"}) {w: 14, h: 14, radius: "pill", style: {"background": $1.color}},
              heading($1.name) {level: 1, size: "xl"},
              when($1.archived,
                box(text("Archived") {size: "xs", color: "warning"}) {bg: "surface", pad-x: "xs", radius: "sm"})
            ) {gap: "sm", align: "center"},
            when(!$1.description.is-empty,
              text($1.description) {color: "muted"})
          ) {gap: "xs"},
          row(
            ViewToggleBtn,
            NewTaskBtn
          ) {gap: "sm", align: "center"}
        ) {justify: "between", align: "center", wrap: true},
        FilterBar,
        match viewMode with
          | ListView  -> ProjectListView($1.id)
          | BoardView -> ProjectBoardView($1.id)
      ) {gap: "lg"}

tile ProjectPage
    = page(
        NavHeader,
        box(
          match currentProject(route, projects) with
            | Some(proj) -> ProjectView(proj)
            | None       -> ProjectMissing
        ) {max-w: 1200, pad: "lg"}
      )

# ============================================================
# Tiles — New Task Page (/projects/:id/new-task)
# ============================================================

tile CancelNewTaskBtn
    = button(text="Cancel", type="button") {pad-x: "md", pad-y: "sm", radius: "sm"}

tile ParentTaskBanner in=TaskId
    = match tasks.get($1) with
        | Some(parent) -> box(
                            text("Subtask of: " + parent.title) {size: "sm", color: "muted"}
                          ) {bg: "surface", pad: "sm", radius: "sm"}
        | None         -> text("")

tile NewTaskForm
    = form(
        panel(
          column(
            column(
              label("Title") {for: "task-title"},
              input(id="task-title", bind=draftTask.title, placeholder="Enter task title")
            ) {gap: "xs"},
            column(
              label("Description") {for: "task-description"},
              textarea(id="task-description", bind=draftTask.description, placeholder="Describe the task") {rows: 4}
            ) {gap: "xs"},
            row(
              column(
                label("Priority") {for: "task-priority"},
                select(id="task-priority", bind=draftTask.priority, options=priorityOptions())
              ) {gap: "xs"},
              column(
                label("Assignee") {for: "task-assignee"},
                input(id="task-assignee", bind=draftTask.assignee, placeholder="Assignee name")
              ) {gap: "xs"},
              column(
                label("Due date") {for: "task-due"},
                input(id="task-due", type="date", bind=draftTask.dueDate)
              ) {gap: "xs"}
            ) {gap: "md", wrap: true},
            column(
              label("Tags") {for: "task-tags"},
              input(id="task-tags", bind=draftTask.tags, placeholder="Comma-separated tags (e.g. bug, ui)")
            ) {gap: "xs"},
            row(
              button(text="Create task", type="submit") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"},
              CancelNewTaskBtn
            ) {gap: "sm"}
          ) {gap: "md"}
        ) {bg: "surface", pad: "md", radius: "md", shadow: "sm"}
      )

tile NewTaskContent in=Project
    = column(
        heading(if draftParentTaskId.is-some then "New Subtask" else "New Task") {level: 1, size: "xl"},
        text("Project: " + $1.name) {color: "muted"},
        match draftParentTaskId with
          | Some(parentId) -> ParentTaskBanner(parentId)
          | None           -> text(""),
        NewTaskForm
      ) {gap: "md"}

tile NewTaskPage
    = page(
        NavHeader,
        box(
          match currentProject(route, projects) with
            | Some(proj) -> NewTaskContent(proj)
            | None       -> ProjectMissing
        ) {max-w: 800, pad: "lg"}
      )

# ============================================================
# Tiles — Task Detail Page (/projects/:id/tasks/:taskId)
# ============================================================

tile BackToProjectBtn
    = button(text="Back", type="button") {pad-x: "sm", pad-y: "xs", radius: "sm"}

tile DeleteTaskBtn in=TaskId
    = button(text="Delete task", type="button") {taskId: $1, color: "danger", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile DetailStatusSelect in=Task
    = select(id="detail-status", value=$1.status, options=statusOptions()) {taskId: $1.id}

tile DetailPrioritySelect in=Task
    = select(id="detail-priority", value=$1.priority, options=priorityOptions()) {taskId: $1.id}

tile DetailTitleInput in=Task
    = input(id="detail-title", value=$1.title, placeholder="Task title") {taskId: $1.id}

tile DetailDescInput in=Task
    = textarea(id="detail-description", value=$1.description, placeholder="Task description") {rows: 3, taskId: $1.id}

tile DetailAssigneeInput in=Task
    = input(id="detail-assignee", value=$1.assignee, placeholder="Unassigned") {taskId: $1.id}

tile DetailDueInput in=Task
    = input(id="detail-due", type="date", value=formatOptionalDate($1.dueDate)) {taskId: $1.id}

tile AddTagBtn in=TaskId
    = button(text="Add tag", type="button") {taskId: $1, pad-x: "sm", pad-y: "xs", radius: "sm"}

tile RemoveTagBtn in=TagItem
    = button(text="Remove tag", type="button") {taskId: $1.taskId, tag: $1.tag, size: "xs"}

tile AddSubtaskBtn in=TaskId
    = button(text="Add subtask", type="button") {taskId: $1, bg: "primary", color: "bg", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile AddCommentBtn in=TaskId
    = button(text="Add comment", type="button") {taskId: $1, bg: "primary", color: "bg", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile DeleteCommentBtn in=CommentId
    = button(text="Delete comment", type="button") {commentId: $1, color: "danger", size: "xs"}

tile SubtaskRow in=TaskId
    = match tasks.get($1) with
        | Some(st) -> row(
                        link(to="/projects/" + st.projectId.show + "/tasks/" + st.id.show, text=st.title) {weight: "medium"},
                        row(
                          text(statusLabel(st.status)) {size: "xs", color: statusColor(st.status)},
                          text(priorityLabel(st.priority)) {size: "xs", color: priorityColor(st.priority)}
                        ) {gap: "sm", align: "center"}
                      ) {justify: "between", align: "center", bg: "surface", pad: "sm", radius: "sm"}
        | None     -> text("")

tile CommentRow in=CommentId
    = match comments.get($1) with
        | Some(c) -> box(
                       column(
                         row(
                           row(
                             text(c.author) {weight: "bold", size: "sm"},
                             text(formatDate(c.createdAt)) {size: "xs", color: "muted"}
                           ) {gap: "sm", align: "center"},
                           DeleteCommentBtn(c.id)
                         ) {justify: "between", align: "center"},
                         text(c.body)
                       ) {gap: "xs"}
                     ) {bg: "surface", pad: "sm", radius: "sm"}
        | None    -> text("")

tile ParentLinkBanner in=TaskId
    = match tasks.get($1) with
        | Some(parent) -> row(
                            text("Parent task:") {size: "sm", color: "muted"},
                            link(to="/projects/" + parent.projectId.show + "/tasks/" + parent.id.show, text=parent.title)
                          ) {gap: "xs", align: "center"}
        | None         -> text("")

tile TaskDetailDueDisplay in=Option(Time)
    = match $1 with
        | Some(d) -> row(
                       text("Due:") {size: "sm", color: "muted"},
                       text(formatDate(d)) {weight: "medium"},
                       text(dueStatusLabel(dueDateStatus(Some(d)))) {size: "xs", color: dueStatusColor(dueDateStatus(Some(d)))}
                     ) {gap: "xs", align: "center"}
        | None    -> text("No due date") {size: "sm", color: "muted"}

tile TaskDetailView in=Task
    = column(
        row(
          BackToProjectBtn,
          DeleteTaskBtn($1.id)
        ) {justify: "between", align: "center"},
        match $1.parentTaskId with
          | Some(parentId) -> ParentLinkBanner(parentId)
          | None           -> text(""),
        column(
          heading($1.title) {level: 1, size: "xl"},
          row(
            text(statusLabel($1.status)) {size: "sm", color: statusColor($1.status), weight: "medium"},
            text(priorityLabel($1.priority)) {size: "sm", color: priorityColor($1.priority), weight: "medium"},
            TaskDetailDueDisplay($1.dueDate)
          ) {gap: "md", align: "center", wrap: true},
          text(if $1.description.is-empty then "No description" else $1.description)
        ) {gap: "sm"},
        panel(
          column(
            heading("Details") {level: 2, size: "lg"},
            row(
              column(
                label("Status") {for: "detail-status"},
                DetailStatusSelect($1)
              ) {gap: "xs"},
              column(
                label("Priority") {for: "detail-priority"},
                DetailPrioritySelect($1)
              ) {gap: "xs"},
              column(
                label("Assignee") {for: "detail-assignee"},
                DetailAssigneeInput($1)
              ) {gap: "xs"},
              column(
                label("Due date") {for: "detail-due"},
                DetailDueInput($1)
              ) {gap: "xs"}
            ) {gap: "md", wrap: true},
            column(
              label("Edit title") {for: "detail-title"},
              DetailTitleInput($1)
            ) {gap: "xs"},
            column(
              label("Edit description") {for: "detail-description"},
              DetailDescInput($1)
            ) {gap: "xs"}
          ) {gap: "md"}
        ) {bg: "surface", pad: "md", radius: "md"},
        panel(
          column(
            heading("Tags") {level: 2, size: "lg"},
            row(
              for tg in $1.tags
                row(
                  text(tg) {size: "sm"},
                  RemoveTagBtn({taskId: $1.id, tag: tg})
                ) {bg: "bg", pad-x: "sm", pad-y: "xs", radius: "pill", gap: "xs", align: "center"}
            ) {gap: "sm", wrap: true},
            row(
              label("New tag") {for: "tag-input"},
              input(id="tag-input", bind=tagDraft, placeholder="New tag"),
              AddTagBtn($1.id)
            ) {gap: "sm", align: "center", wrap: true}
          ) {gap: "sm"}
        ) {bg: "surface", pad: "md", radius: "md"},
        panel(
          column(
            row(
              heading("Subtasks") {level: 2, size: "lg"},
              AddSubtaskBtn($1.id)
            ) {justify: "between", align: "center"},
            if subtasksFor(tasks, $1.id).is-empty
            then text("No subtasks yet") {size: "sm", color: "muted"}
            else column(
                   for subId in subtasksFor(tasks, $1.id)
                     SubtaskRow(subId) {key: subId.show}
                 ) {gap: "xs"}
          ) {gap: "sm"}
        ) {bg: "surface", pad: "md", radius: "md"},
        panel(
          column(
            heading("Comments") {level: 2, size: "lg"},
            if commentsForTask(comments, $1.id).is-empty
            then text("No comments yet") {size: "sm", color: "muted"}
            else column(
                   for cid in commentsForTask(comments, $1.id)
                     CommentRow(cid) {key: cid.show}
                 ) {gap: "sm"},
            row(
              label("New comment") {for: "comment-input"},
              input(id="comment-input", bind=commentDraft, placeholder="Write a comment..."),
              AddCommentBtn($1.id)
            ) {gap: "sm", align: "center", wrap: true}
          ) {gap: "sm"}
        ) {bg: "surface", pad: "md", radius: "md"}
      ) {gap: "lg"}

tile TaskDetailPage
    = page(
        NavHeader,
        box(
          match currentTask(route, tasks) with
            | Some(t) -> TaskDetailView(t)
            | None    -> TaskMissing
        ) {max-w: 900, pad: "lg"}
      )

# ============================================================
# Tiles — Settings Page (/settings) & Not Found (/404)
# ============================================================

tile ToggleThemeBtn
    = button(
        text=if themeName == "Light" then "Switch to Dark" else "Switch to Light",
        type="button"
      ) {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile SettingsPage
    = page(
        NavHeader,
        box(
          column(
            heading("Settings") {level: 1, size: "xl"},
            panel(
              column(
                heading("Appearance") {level: 2, size: "lg"},
                text("Current theme: " + themeName) {color: "muted"},
                row(ToggleThemeBtn)
              ) {gap: "sm"}
            ) {bg: "surface", pad: "md", radius: "md"},
            when(storageError.is-some,
              box(text("Storage notice: " + storageError.get-or("")) {color: "danger", size: "sm"}) {pad: "sm"})
          ) {gap: "lg"}
        ) {max-w: 720, pad: "lg"}
      )

tile NotFound
    = page(
        NavHeader,
        box(
          column(
            heading("404") {level: 1, size: "xxl"},
            text("Page not found") {color: "muted"},
            link(to="/", text="Back to projects")
          ) {gap: "md"}
        ) {max-w: 720, pad: "lg"}
      )

# ============================================================
# Application Entry
# ============================================================

app ProjectManager
    caps   = [storage.read, storage.write, nav.push, nav.replace, nav.back]
    routes = {
        "/"                           -> ProjectsPage,
        "/projects/:id"               -> ProjectPage,
        "/projects/:id/new-task"      -> NewTaskPage,
        "/projects/:id/tasks/:taskId" -> TaskDetailPage,
        "/settings"                   -> SettingsPage,
        "/404"                        -> NotFound
    }
    init   = []
    theme  = themeName
    meta   = {
        title: "Project Manager",
        description: "Asana and Linear style project management SPA"
    }
