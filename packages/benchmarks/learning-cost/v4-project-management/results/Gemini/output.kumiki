# ============================================================================
# Slots
# ============================================================================

slot projects : Map(ProjectId, Project) = {}
slot tasks : Map(TaskId, Task) = {}
slot comments : Map(CommentId, Comment) = {}

slot viewMode : ViewMode = ListView
slot filter : FilterState = {status: None, priority: None, assignee: "", search: ""}
slot themeName : Text = "Light"

slot draftProject : {name: Text, description: Text, color: Text} = {
    name: "",
    description: "",
    color: "#2563eb"
}

slot draftTask : {title: Text, description: Text, priority: Priority, assignee: Text, tags: Text, dueDate: Text} = {
    title: "",
    description: "",
    priority: Med,
    assignee: "",
    tags: "",
    dueDate: ""
}

slot commentDraft : Text = ""
slot commentAuthor : Text = "Alice"
slot tagDraft : Text = ""
slot subtaskDraft : Text = ""
slot showArchived : Bool = false

slot ready : Bool = false
slot loadedProjects : Bool transient = false
slot loadedTasks : Bool transient = false
slot loadedComments : Bool transient = false
slot storageError : Option(Text) transient = None
slot lastPanic : Option(Text) transient = None

# ============================================================================
# Effects (Persistence)
# ============================================================================

effect saveProjects
    cap=storage.write
    in=Map(ProjectId, Project)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kumiki_pm_projects", value: $1}

effect saveTasks
    cap=storage.write
    in=Map(TaskId, Task)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kumiki_pm_tasks", value: $1}

effect saveComments
    cap=storage.write
    in=Map(CommentId, Comment)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kumiki_pm_comments", value: $1}

effect loadProjects
    cap=storage.read
    in=Unit
    out=Result(Option(Map(ProjectId, Project)), Text)
    policy=once
    map-request={key: "kumiki_pm_projects", decode: Decoder.Json(Map(ProjectId, Project))}

effect loadTasks
    cap=storage.read
    in=Unit
    out=Result(Option(Map(TaskId, Task)), Text)
    policy=once
    map-request={key: "kumiki_pm_tasks", decode: Decoder.Json(Map(TaskId, Task))}

effect loadComments
    cap=storage.read
    in=Unit
    out=Result(Option(Map(CommentId, Comment)), Text)
    policy=once
    map-request={key: "kumiki_pm_comments", decode: Decoder.Json(Map(CommentId, Comment))}

# ============================================================================
# Pure Functions
# ============================================================================

fn statusLabel(s: Status) -> Text
    = match s with
        | Backlog    -> "Backlog"
        | InProgress -> "In Progress"
        | Review     -> "Review"
        | Done       -> "Done"

fn statusColor(s: Status) -> Text
    = match s with
        | Backlog    -> "muted"
        | InProgress -> "primary"
        | Review     -> "warning"
        | Done       -> "success"

fn nextStatus(s: Status) -> Status
    = match s with
        | Backlog    -> InProgress
        | InProgress -> Review
        | Review     -> Done
        | Done       -> Backlog

fn priorityLabel(p: Priority) -> Text
    = match p with
        | Low      -> "Low"
        | Med      -> "Medium"
        | High     -> "High"
        | Critical -> "Critical"

fn priorityColor(p: Priority) -> Text
    = match p with
        | Low      -> "muted"
        | Med      -> "primary"
        | High     -> "warning"
        | Critical -> "danger"

fn formatDate(t: Time) -> Text
    = t.format("yyyy-MM-dd")

fn formatDateTime(t: Time) -> Text
    = t.format("yyyy-MM-dd HH:mm")

fn formatDueDate(d: Option(Time)) -> Text
    = match d with
        | Some(t) -> formatDate(t)
        | None    -> "No due date"

fn dueDateInputVal(d: Option(Time)) -> Text
    = match d with
        | Some(t) -> t.format("yyyy-MM-dd")
        | None    -> ""

fn dueDateStatus(dueDate: Option(Time)) -> DueStatus
    = let cur = now in
      match dueDate with
        | None    -> NoDue
        | Some(t) ->
            if t.format("yyyy-MM-dd") == cur.format("yyyy-MM-dd") then Today
            else if t < cur then Overdue
            else if t < cur.plus(Duration.d(3)) then Soon
            else Upcoming

fn dueStatusLabel(ds: DueStatus) -> Text
    = match ds with
        | Overdue  -> "Overdue"
        | Today    -> "Due Today"
        | Soon     -> "Due Soon"
        | Upcoming -> "Upcoming"
        | NoDue    -> "No Due Date"

fn dueStatusColor(ds: DueStatus) -> Text
    = match ds with
        | Overdue  -> "danger"
        | Today    -> "warning"
        | Soon     -> "primary"
        | Upcoming -> "muted"
        | NoDue    -> "muted"

fn parseTags(raw: Text) -> List(Text)
    = raw.split(",").map($1.trim).filter(!$1.is-empty).unique

fn routeProjectId(r: Route) -> Option(ProjectId)
    = match r.params.get("id") with
        | Some(raw) -> ProjectId.parse(raw)
        | None      -> None

fn routeTaskId(r: Route) -> Option(TaskId)
    = match r.params.get("taskId") with
        | Some(raw) -> TaskId.parse(raw)
        | None      -> None

fn currentProject(r: Route, ps: Map(ProjectId, Project)) -> Option(Project)
    = match routeProjectId(r) with
        | Some(pid) -> ps.get(pid)
        | None      -> None

fn currentTask(r: Route, ts: Map(TaskId, Task)) -> Option(Task)
    = match routeTaskId(r) with
        | Some(tid) -> ts.get(tid)
        | None      -> None

fn matchesStatus(t: Task, st: Option(Status)) -> Bool
    = match st with
        | Some(s) -> t.status == s
        | None    -> true

fn matchesPriority(t: Task, pr: Option(Priority)) -> Bool
    = match pr with
        | Some(p) -> t.priority == p
        | None    -> true

fn matchesFilter(t: Task, f: FilterState) -> Bool
    = matchesStatus(t, f.status)
      && matchesPriority(t, f.priority)
      && (f.assignee.trim.is-empty || t.assignee.lower.contains(f.assignee.trim.lower))
      && (f.search.trim.is-empty
          || t.title.lower.contains(f.search.trim.lower)
          || t.description.lower.contains(f.search.trim.lower)
          || t.tags.find($1.lower.contains(f.search.trim.lower)).is-some)

fn hasActiveFilter(f: FilterState) -> Bool
    = f.status.is-some
      || f.priority.is-some
      || !f.assignee.trim.is-empty
      || !f.search.trim.is-empty

fn tasksForProject(ts: Map(TaskId, Task), projectId: ProjectId) -> List(TaskId)
    = ts.entries
        .filter($2.projectId == projectId)
        .sort-by($2.updatedAt)
        .reverse
        .map($1)

fn subtasksFor(ts: Map(TaskId, Task), parentId: TaskId) -> List(TaskId)
    = ts.entries
        .filter($2.parentTaskId == Some(parentId))
        .sort-by($2.createdAt)
        .map($1)

fn filteredTasks(ts: Map(TaskId, Task), projectId: ProjectId, f: FilterState) -> List(TaskId)
    = ts.entries
        .filter($2.projectId == projectId && matchesFilter($2, f))
        .sort-by($2.updatedAt)
        .reverse
        .map($1)

fn tasksByStatus(ts: Map(TaskId, Task), projectId: ProjectId, f: FilterState, st: Status) -> List(TaskId)
    = ts.entries
        .filter($2.projectId == projectId && $2.status == st && matchesFilter($2, f))
        .sort-by($2.updatedAt)
        .reverse
        .map($1)

fn commentsForTask(cs: Map(CommentId, Comment), taskId: TaskId) -> List(CommentId)
    = cs.entries
        .filter($2.taskId == taskId)
        .sort-by($2.createdAt)
        .map($1)

fn visibleProjects(ps: Map(ProjectId, Project), includeArchived: Bool) -> List(ProjectId)
    = ps.entries
        .filter(includeArchived || !$2.archived)
        .sort-by($2.createdAt)
        .reverse
        .map($1)

fn activeTaskCount(ts: Map(TaskId, Task), pid: ProjectId) -> Int
    = ts.entries
        .filter($2.projectId == pid && $2.status != Done)
        .length

fn doneTaskCount(ts: Map(TaskId, Task), pid: ProjectId) -> Int
    = ts.entries
        .filter($2.projectId == pid && $2.status == Done)
        .length

fn totalTaskCount(ts: Map(TaskId, Task), pid: ProjectId) -> Int
    = ts.entries
        .filter($2.projectId == pid)
        .length

fn removeProjectTasks(ts: Map(TaskId, Task), pid: ProjectId) -> Map(TaskId, Task)
    = ts.filter($2.projectId != pid)

fn removeCommentsForProject(cs: Map(CommentId, Comment), ts: Map(TaskId, Task), pid: ProjectId) -> Map(CommentId, Comment)
    = cs.filter(match ts.get($2.taskId) with | Some(t) -> t.projectId != pid | None -> false)

fn removeCommentsForTask(cs: Map(CommentId, Comment), tid: TaskId) -> Map(CommentId, Comment)
    = cs.filter($2.taskId != tid)

fn taskTitleVal(ts: Map(TaskId, Task), tid: TaskId) -> Text
    = match ts.get(tid) with
        | Some(t) -> t.title
        | None    -> ""

fn taskDescVal(ts: Map(TaskId, Task), tid: TaskId) -> Text
    = match ts.get(tid) with
        | Some(t) -> t.description
        | None    -> ""

fn taskStatusVal(ts: Map(TaskId, Task), tid: TaskId) -> Status
    = match ts.get(tid) with
        | Some(t) -> t.status
        | None    -> Backlog

fn taskPriorityVal(ts: Map(TaskId, Task), tid: TaskId) -> Priority
    = match ts.get(tid) with
        | Some(t) -> t.priority
        | None    -> Med

fn taskAssigneeVal(ts: Map(TaskId, Task), tid: TaskId) -> Text
    = match ts.get(tid) with
        | Some(t) -> t.assignee
        | None    -> ""

fn taskDueDateVal(ts: Map(TaskId, Task), tid: TaskId) -> Text
    = match ts.get(tid) with
        | Some(t) -> dueDateInputVal(t.dueDate)
        | None    -> ""

fn statusOptions() -> List({label: Text, value: Status})
    = [
        {label: "Backlog", value: Backlog},
        {label: "In Progress", value: InProgress},
        {label: "Review", value: Review},
        {label: "Done", value: Done}
    ]

fn priorityOptions() -> List({label: Text, value: Priority})
    = [
        {label: "Low", value: Low},
        {label: "Medium", value: Med},
        {label: "High", value: High},
        {label: "Critical", value: Critical}
    ]

fn statusFilterOptions() -> List({label: Text, value: Option(Status)})
    = [
        {label: "All Statuses", value: None},
        {label: "Backlog", value: Some(Backlog)},
        {label: "In Progress", value: Some(InProgress)},
        {label: "Review", value: Some(Review)},
        {label: "Done", value: Some(Done)}
    ]

fn priorityFilterOptions() -> List({label: Text, value: Option(Priority)})
    = [
        {label: "All Priorities", value: None},
        {label: "Low", value: Some(Low)},
        {label: "Medium", value: Some(Med)},
        {label: "High", value: Some(High)},
        {label: "Critical", value: Some(Critical)}
    ]

fn projectColorOptions() -> List({label: Text, value: Text})
    = [
        {label: "Blue", value: "#2563eb"},
        {label: "Emerald", value: "#059669"},
        {label: "Amber", value: "#d97706"},
        {label: "Rose", value: "#e11d48"},
        {label: "Violet", value: "#7c3aed"},
        {label: "Cyan", value: "#0891b2"}
    ]

# ============================================================================
# Reducers — Lifecycle & Persistence
# ============================================================================

reducer loadAll
    on=app.start
    do= emit loadProjects()
        emit loadTasks()
        emit loadComments()

reducer projectsLoaded
    on=loadProjects.ok($data, _)
    do= projects := $data.get-or({})
        loadedProjects := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer projectsLoadErr
    on=loadProjects.err($err, _)
    do= storageError := Some($err)
        loadedProjects := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer tasksLoaded
    on=loadTasks.ok($data, _)
    do= tasks := $data.get-or({})
        loadedTasks := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer tasksLoadErr
    on=loadTasks.err($err, _)
    do= storageError := Some($err)
        loadedTasks := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer commentsLoaded
    on=loadComments.ok($data, _)
    do= comments := $data.get-or({})
        loadedComments := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer commentsLoadErr
    on=loadComments.err($err, _)
    do= storageError := Some($err)
        loadedComments := true
        ready := loadedProjects && loadedTasks && loadedComments

reducer saveProjectsOk
    on=saveProjects.ok(_, _)
    do= storageError := None

reducer saveProjectsErr
    on=saveProjects.err($err, _)
    do= storageError := Some($err)

reducer saveTasksOk
    on=saveTasks.ok(_, _)
    do= storageError := None

reducer saveTasksErr
    on=saveTasks.err($err, _)
    do= storageError := Some($err)

reducer saveCommentsOk
    on=saveComments.ok(_, _)
    do= storageError := None

reducer saveCommentsErr
    on=saveComments.err($err, _)
    do= storageError := Some($err)

reducer toggleTheme
    on=ui.click(ThemeToggleBtn)
    do= themeName := if themeName == "Light" then "Dark" else "Light"

reducer onAppError
    on=app.error
    do= lastPanic := Some($event.message)
        emit toast({kind: "error", text: $event.message})

reducer clearTaskDraftsOnLeave
    on=route.leave("/projects/:id/tasks/:taskId")
    do= commentDraft := ""
        tagDraft := ""
        subtaskDraft := ""

reducer clearNewTaskOnLeave
    on=route.leave("/projects/:id/new-task")
    do= draftTask := {
            title: "",
            description: "",
            priority: Med,
            assignee: "",
            tags: "",
            dueDate: ""
        }

# ============================================================================
# Reducers — Projects
# ============================================================================

reducer createProject
    on=ui.submit(NewProjectForm)
    do= if !draftProject.name.trim.is-empty then {
            let pid = ProjectId.fresh()
            let col = if draftProject.color.trim.is-empty then "#2563eb" else draftProject.color.trim
            projects[pid] := {
                id: pid,
                name: draftProject.name.trim,
                description: draftProject.description.trim,
                color: col,
                archived: false,
                createdAt: now
            }
            draftProject := {name: "", description: "", color: "#2563eb"}
            emit saveProjects(projects)
            emit toast({kind: "success", text: "Project created"})
            emit navigate({path: "/projects/{id}", params: {"id": pid.show}, query: {}})
        }

reducer archiveProject
    on=ui.click(ArchiveProjectBtn)
    do= match ProjectId.parse($el.projectId) with
          | Some(pid) -> {
              projects[pid].archived := true
              emit saveProjects(projects)
              emit toast({kind: "info", text: "Project archived"})
          }
          | None -> ()

reducer unarchiveProject
    on=ui.click(UnarchiveProjectBtn)
    do= match ProjectId.parse($el.projectId) with
          | Some(pid) -> {
              projects[pid].archived := false
              emit saveProjects(projects)
              emit toast({kind: "info", text: "Project restored"})
          }
          | None -> ()

reducer deleteProject
    on=ui.click(DeleteProjectBtn)
    do= match ProjectId.parse($el.projectId) with
          | Some(pid) -> {
              comments := removeCommentsForProject(comments, tasks, pid)
              tasks := removeProjectTasks(tasks, pid)
              projects := projects.remove(pid)
              emit saveComments(comments)
              emit saveTasks(tasks)
              emit saveProjects(projects)
              emit toast({kind: "info", text: "Project deleted"})
              if routeProjectId(route) == Some(pid) then
                  emit navigate({path: "/", params: {}, query: {}})
          }
          | None -> ()

# ============================================================================
# Reducers — Tasks
# ============================================================================

reducer createTask
    on=ui.submit(NewTaskForm)
    do= match routeProjectId(route) with
          | Some(pid) -> {
              if !draftTask.title.trim.is-empty then {
                  let tid = TaskId.fresh()
                  tasks[tid] := {
                      id: tid,
                      projectId: pid,
                      title: draftTask.title.trim,
                      description: draftTask.description.trim,
                      status: Backlog,
                      priority: draftTask.priority,
                      assignee: draftTask.assignee.trim,
                      dueDate: Time.parse(draftTask.dueDate.trim),
                      tags: parseTags(draftTask.tags),
                      parentTaskId: None,
                      createdAt: now,
                      updatedAt: now
                  }
                  draftTask := {
                      title: "",
                      description: "",
                      priority: Med,
                      assignee: "",
                      tags: "",
                      dueDate: ""
                  }
                  emit saveTasks(tasks)
                  emit toast({kind: "success", text: "Task created"})
                  emit navigate({
                      path: "/projects/{id}/tasks/{taskId}",
                      params: {"id": pid.show, "taskId": tid.show},
                      query: {}
                  })
              }
          }
          | None -> ()

reducer createSubtask
    on=ui.submit(NewSubtaskForm)
    do= match (routeProjectId(route), routeTaskId(route)) with
          | (Some(pid), Some(parentId)) -> {
              if !subtaskDraft.trim.is-empty then {
                  let tid = TaskId.fresh()
                  tasks[tid] := {
                      id: tid,
                      projectId: pid,
                      title: subtaskDraft.trim,
                      description: "",
                      status: Backlog,
                      priority: Med,
                      assignee: "",
                      dueDate: None,
                      tags: [],
                      parentTaskId: Some(parentId),
                      createdAt: now,
                      updatedAt: now
                  }
                  subtaskDraft := ""
                  emit saveTasks(tasks)
                  emit toast({kind: "success", text: "Subtask added"})
              }
          }
          | _ -> ()

reducer updateTaskStatus
    on=ui.change(TaskStatusSelect)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].status := $event.value
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer updateTaskPriority
    on=ui.change(TaskPrioritySelect)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].priority := $event.value
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer updateTaskAssignee
    on=ui.input(TaskAssigneeInput)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].assignee := $event.value
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer updateTaskDueDate
    on=ui.change(TaskDueDateInput)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].dueDate := Time.parse($event.value)
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer updateTaskTitle
    on=ui.input(TaskTitleInput)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].title := $event.value
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer updateTaskDescription
    on=ui.input(TaskDescInput)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              tasks[tid].description := $event.value
              tasks[tid].updatedAt := now
              emit saveTasks(tasks)
          }
          | None -> ()

reducer addTaskTag
    on=ui.submit(AddTagForm)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              let tag = tagDraft.trim
              if !tag.is-empty then {
                  match tasks.get(tid) with
                    | Some(t) -> {
                        if !t.tags.contains(tag) then {
                            tasks[tid].tags := t.tags.push(tag)
                            tasks[tid].updatedAt := now
                            emit saveTasks(tasks)
                        }
                    }
                    | None -> ()
                  tagDraft := ""
              }
          }
          | None -> ()

reducer removeTaskTag
    on=ui.click(RemoveTagBtn)
    do= match TaskId.parse($el.taskId) with
          | Some(tid) -> {
              match tasks.get(tid) with
                | Some(t) -> {
                    tasks[tid].tags := t.tags.filter($1 != $el.tag)
                    tasks[tid].updatedAt := now
                    emit saveTasks(tasks)
                }
                | None -> ()
          }
          | None -> ()

reducer moveTaskStatus
    on=ui.click(MoveTaskBtn)
    do= match TaskId.parse($el.taskId) with
          | Some(tid) -> {
              match tasks.get(tid) with
                | Some(t) -> {
                    tasks[tid].status := nextStatus(t.status)
                    tasks[tid].updatedAt := now
                    emit saveTasks(tasks)
                }
                | None -> ()
          }
          | None -> ()

reducer deleteTask
    on=ui.click(DeleteTaskBtn)
    do= match TaskId.parse($el.taskId) with
          | Some(tid) -> {
              let targetPid = match tasks.get(tid) with
                | Some(t) -> Some(t.projectId)
                | None    -> routeProjectId(route)
              comments := removeCommentsForTask(comments, tid)
              tasks := tasks.remove(tid)
              emit saveComments(comments)
              emit saveTasks(tasks)
              emit toast({kind: "info", text: "Task deleted"})
              if routeTaskId(route) == Some(tid) then {
                  match targetPid with
                    | Some(pid) -> emit navigate({path: "/projects/{id}", params: {"id": pid.show}, query: {}})
                    | None      -> emit navigate({path: "/", params: {}, query: {}})
              }
          }
          | None -> ()

# ============================================================================
# Reducers — Comments
# ============================================================================

reducer addComment
    on=ui.submit(CommentForm)
    do= match routeTaskId(route) with
          | Some(tid) -> {
              if !commentDraft.trim.is-empty then {
                  let cid = CommentId.fresh()
                  let authorName = if commentAuthor.trim.is-empty then "Anonymous" else commentAuthor.trim
                  comments[cid] := {
                      id: cid,
                      taskId: tid,
                      author: authorName,
                      body: commentDraft.trim,
                      createdAt: now
                  }
                  commentDraft := ""
                  emit saveComments(comments)
              }
          }
          | None -> ()

reducer deleteComment
    on=ui.click(DeleteCommentBtn)
    do= match CommentId.parse($el.commentId) with
          | Some(cid) -> {
              comments := comments.remove(cid)
              emit saveComments(comments)
          }
          | None -> ()

# ============================================================================
# Reducers — UI Filter & View Mode
# ============================================================================

reducer setFilterStatus
    on=ui.change(FilterStatusSelect)
    do= filter.status := $event.value

reducer setFilterPriority
    on=ui.change(FilterPrioritySelect)
    do= filter.priority := $event.value

reducer setFilterAssignee
    on=ui.input(FilterAssigneeInput)
    do= filter.assignee := $event.value

reducer setSearch
    on=ui.input(FilterSearchInput)
    do= filter.search := $event.value

reducer clearFilter
    on=ui.click(ClearFilterBtn)
    do= filter := {status: None, priority: None, assignee: "", search: ""}

reducer setViewMode
    on=ui.click(ViewModeBtn)
    do= viewMode := if $el.mode == "board" then BoardView else ListView

