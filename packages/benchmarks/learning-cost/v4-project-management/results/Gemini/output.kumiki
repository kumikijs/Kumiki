tile ErrorFallback in=PanicInfo
    = page(
        box(
            column(
                row(
                    icon(name="alert-circle") {size: "lg", color: "danger"},
                    heading("Something went wrong", level=1) {size: "xl", weight: "bold"}
                ) {gap: "sm", align: "center"},
                text($1.message) {color: "danger"},
                text("Location: " + $1.location) {size: "sm", color: "muted"},
                link(to="/", text="Return to Projects") {color: "primary", weight: "medium"}
            ) {gap: "md"}
        ) {bg: "surface", pad: "xl", radius: "md", max-w: 640}
    ) {bg: "bg", color: "fg", pad: "xl"}

tile ThemeToggleBtn
    = button(text=if themeName == "Light" then "Dark Mode" else "Light Mode") {
        bg: "surface-alt",
        color: "fg",
        pad-x: "sm",
        pad-y: "xs",
        radius: "sm",
        size: "sm"
    }

tile TopNav
    = region(
        row(
            row(
                icon(name="folder") {size: "md", color: "primary"},
                link(to="/", text="Kumiki PM") {weight: "bold", size: "lg", color: "fg"}
            ) {gap: "sm", align: "center"},
            row(
                link(to="/", text="Projects") {color: "fg", size: "sm", weight: "medium"},
                link(to="/settings", text="Settings") {color: "fg", size: "sm", weight: "medium"},
                ThemeToggleBtn
            ) {gap: "md", align: "center"}
        ) {justify: "between", align: "center", wrap: true, gap: "sm"}
    ) {
        aria-label: "Main Navigation",
        bg: "surface",
        pad-x: "lg",
        pad-y: "md",
        style: {border-bottom-width: "1px", border-bottom-style: "solid", border-bottom-color: @colors.border}
    }

tile StorageBanner
    = column(
        when(!ready,
            row(
                spinner() {size: "sm"},
                text("Loading workspace from localStorage...") {size: "sm", color: "muted"}
            ) {gap: "sm", align: "center", pad-x: "lg", pad-y: "sm", bg: "surface-alt"}),
        when(storageError.is-some,
            row(
                icon(name="alert-triangle") {size: "sm", color: "danger"},
                text("Storage error: " + storageError.get-or("")) {size: "sm", color: "danger"}
            ) {gap: "sm", align: "center", pad-x: "lg", pad-y: "sm", bg: "surface-alt"})
    )

tile StatusBadge in=Status
