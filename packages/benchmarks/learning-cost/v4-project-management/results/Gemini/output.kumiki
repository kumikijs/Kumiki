            column(
                label("Add a Comment") {for: "comment-body", size: "xs", color: "muted"},
                textarea(bind=commentDraft, id="comment-body", rows=3, placeholder="Write a comment...")
            ) {gap: "xs"},
            row(
                button(
                    text="Post Comment",
                    type="submit",
                    disabled=commentDraft.trim.is-empty
                ) {bg: "primary", color: "on-primary", pad-x: "md", pad-y: "sm", radius: "sm", size: "sm"}
