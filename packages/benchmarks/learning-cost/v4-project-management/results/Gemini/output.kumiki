# ============================================================================
# Tiles — Forms
# ============================================================================

tile NewProjectForm
    = form(
        column(
            heading("New Project", level=2) {size: "lg", weight: "bold"},
            grid(
                column(
                    label("Project Name") {for: "proj-name", size: "sm", weight: "medium"},
                    input(bind=draftProject.name, id="proj-name", placeholder="e.g. Q4 Launch", required=true)
                ) {gap: "xs"},
                column(
                    label("Color") {for: "proj-color", size: "sm", weight: "medium"},
                    select(bind=draftProject.color, id="proj-color", options=projectColorOptions())
                ) {gap: "xs"}
            ) {cols: {base: 1, md: 2}, gap: "md"},
            column(
                label("Description") {for: "proj-desc", size: "sm", weight: "medium"},
                textarea(bind=draftProject.description, id="proj-desc", rows=2, placeholder="What is this project about?")
            ) {gap: "xs"},
            row(
                button(
                    text="Create Project",
                    type="submit",
                    disabled=draftProject.name.trim.is-empty
                ) {bg: "primary", color: "on-primary", pad-x: "md", pad-y: "sm", radius: "sm"}
            ) {justify: "end"}
        ) {gap: "md"}
    )

tile NewTaskForm
    = form(
        column(
            column(
                label("Title") {for: "task-title", size: "sm", weight: "medium"},
                input(bind=draftTask.title, id="task-title", placeholder="Short, actionable task title", required=true)
            ) {gap: "xs"},
            column(
                label("Description") {for: "task-desc", size: "sm", weight: "medium"},
                textarea(bind=draftTask.description, id="task-desc", rows=4, placeholder="Acceptance criteria, notes, links...")
            ) {gap: "xs"},
            grid(
                column(
                    label("Priority") {for: "task-priority", size: "sm", weight: "medium"},
                    select(bind=draftTask.priority, id="task-priority", options=priorityOptions())
                ) {gap: "xs"},
                column(
                    label("Assignee") {for: "task-assignee", size: "sm", weight: "medium"},
                    input(bind=draftTask.assignee, id="task-assignee", placeholder="e.g. Alice")
                ) {gap: "xs"},
                column(
                    label("Due Date") {for: "task-due", size: "sm", weight: "medium"},
                    input(bind=draftTask.dueDate, id="task-due", type="date")
                ) {gap: "xs"}
            ) {cols: {base: 1, md: 3}, gap: "md"},
            column(
                label("Tags (comma-separated)") {for: "task-tags", size: "sm", weight: "medium"},
