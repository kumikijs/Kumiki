# ============================================================================
# Tiles — ProjectsPage
# ============================================================================

tile ProjectCard in=ProjectId
    = match projects.get($1) with
        | Some(p) ->
            card(
                column(
                    row(
                        row(
                            box() {w: 12, h: 12, radius: "pill", style: {background: p.color}},
                            link(to="/projects/" + p.id.show, text=p.name) {weight: "bold", size: "lg", color: "fg"}
                        ) {gap: "sm", align: "center"},
                        when(p.archived,
                            box(text("Archived") {size: "xs", color: "muted"}) {bg: "surface-alt", pad-x: "sm", pad-y: "xs", radius: "pill"})
                    ) {justify: "between", align: "center", gap: "sm"},
                    text(if p.description.is-empty then "No description" else p.description) {size: "sm", color: "muted"},
                    column(
                        row(
                            text(fmt("{0} active", activeTaskCount(tasks, p.id))) {size: "xs", weight: "medium", color: "primary"},
                            text(fmt("{0} / {1} done", doneTaskCount(tasks, p.id), totalTaskCount(tasks, p.id))) {size: "xs", color: "muted"}
                        ) {justify: "between", align: "center"},
                        progress(
                            value=doneTaskCount(tasks, p.id),
                            max=if totalTaskCount(tasks, p.id) > 0 then totalTaskCount(tasks, p.id) else 1
                        )
                    ) {gap: "xs"},
                    divider(),
                    row(
                        text("Created " + formatDate(p.createdAt)) {size: "xs", color: "muted"},
                        row(
                            if p.archived then UnarchiveProjectBtn(p.id) else ArchiveProjectBtn(p.id),
                            DeleteProjectBtn(p.id)
                        ) {gap: "xs", align: "center"}
                    ) {justify: "between", align: "center", wrap: true, gap: "sm"}
                ) {gap: "sm"}
            ) {
                bg: "surface",
                pad: "md",
                radius: "md",
                shadow: "sm",
                style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
            }
        | None -> box()

tile ProjectsPage
    error-boundary = ErrorFallback
    = page(
        TopNav,
        StorageBanner,
        box(
            column(
                row(
                    column(
                        heading("Projects", level=1) {size: "xxl", weight: "bold"},
                        text("Organize work across projects, lists, and kanban boards.") {size: "sm", color: "muted"}
                    ) {gap: "xs"},
                    check(bind=showArchived, label="Show archived projects")
                ) {justify: "between", align: "center", wrap: true, gap: "md"},
                panel(NewProjectForm) {
                    bg: "surface",
                    pad: "lg",
                    radius: "md",
                    shadow: "sm",
                    style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                },
                if visibleProjects(projects, showArchived).is-empty
                then box(
                    column(
                        icon(name="folder-open") {size: "xl", color: "muted"},
                        heading("No projects yet", level=2) {size: "lg", weight: "medium"},
                        text("Create your first project above to start tracking tasks.") {size: "sm", color: "muted"}
                    ) {gap: "sm", align: "center"}
                ) {bg: "surface", pad: "xl", radius: "md"}
                else grid(
                    for pid in visibleProjects(projects, showArchived)
                        ProjectCard(pid) {key: pid.show}
                ) {cols: {base: 1, md: 2, lg: 3}, gap: "md"}
            ) {gap: "lg"}
        ) {pad: "lg", max-w: 1200}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

# ============================================================================
# Tiles — ProjectPage (FilterBar, ListView, BoardView)
# ============================================================================

tile FilterBar
    = panel(
        column(
            grid(
                column(
                    label("Search") {for: "filter-search", size: "xs", color: "muted"},
                    FilterSearchInput
                ) {gap: "xs"},
                column(
                    label("Status") {for: "filter-status", size: "xs", color: "muted"},
                    FilterStatusSelect
                ) {gap: "xs"},
                column(
                    label("Priority") {for: "filter-priority", size: "xs", color: "muted"},
                    FilterPrioritySelect
                ) {gap: "xs"},
                column(
                    label("Assignee") {for: "filter-assignee", size: "xs", color: "muted"},
                    FilterAssigneeInput
                ) {gap: "xs"}
            ) {cols: {base: 1, sm: 2, lg: 4}, gap: "sm"},
            when(hasActiveFilter(filter),
                row(ClearFilterBtn) {justify: "end"})
        ) {gap: "sm"}
    ) {
        bg: "surface",
        pad: "md",
        radius: "md",
        style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
    }

tile TaskListRow in=TaskId
    = match tasks.get($1) with
        | Some(t) ->
            card(
                column(
                    row(
                        row(
                            StatusBadge(t.status),
                            PriorityBadge(t.priority),
                            link(
                                to="/projects/" + t.projectId.show + "/tasks/" + t.id.show,
                                text=t.title
                            ) {weight: "bold", color: "fg"}
                        ) {gap: "sm", align: "center", wrap: true},
                        row(
                            MoveTaskBtn(t.id),
                            DeleteTaskBtn(t.id)
                        ) {gap: "xs", align: "center"}
                    ) {justify: "between", align: "center", wrap: true, gap: "sm"},
                    row(
                        when(!t.assignee.is-empty,
                            row(
                                icon(name="user") {size: "sm", color: "muted"},
                                text(t.assignee) {size: "xs", color: "muted"}
                            ) {gap: "xs", align: "center"}),
                        when(t.dueDate.is-some,
                            row(
                                icon(name="calendar") {size: "sm", color: "muted"},
                                text(formatDueDate(t.dueDate)) {size: "xs", color: "muted"},
                                DueBadge(dueDateStatus(t.dueDate))
                            ) {gap: "xs", align: "center"}),
                        when(subtasksFor(tasks, t.id).length > 0,
                            text(fmt("{0} subtasks", subtasksFor(tasks, t.id).length)) {size: "xs", color: "muted"}),
                        when(commentsForTask(comments, t.id).length > 0,
                            text(fmt("{0} comments", commentsForTask(comments, t.id).length)) {size: "xs", color: "muted"}),
                        for tag in t.tags
                            TagChip(tag) {key: tag}
                    ) {gap: "sm", align: "center", wrap: true}
                ) {gap: "sm"}
            ) {
                bg: "surface",
                pad: "md",
                radius: "md",
                shadow: "sm",
                style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
            }
        | None -> box()

tile TaskListView in=ProjectId
    = if filteredTasks(tasks, $1, filter).is-empty
      then box(
          column(
              heading("No matching tasks", level=2) {size: "md", weight: "medium"},
              text("Create a new task or adjust your filters.") {size: "sm", color: "muted"}
          ) {gap: "xs", align: "center"}
      ) {bg: "surface", pad: "xl", radius: "md"}
      else stack(
          for tid in filteredTasks(tasks, $1, filter)
              TaskListRow(tid) {key: tid.show}
      ) {gap: "sm"}

tile BoardTaskCard in=TaskId
    = match tasks.get($1) with
        | Some(t) ->
            card(
                column(
                    row(
                        PriorityBadge(t.priority),
                        when(t.dueDate.is-some, DueBadge(dueDateStatus(t.dueDate)))
                    ) {justify: "between", align: "center", gap: "xs"},
                    link(
                        to="/projects/" + t.projectId.show + "/tasks/" + t.id.show,
                        text=t.title
                    ) {weight: "bold", size: "sm", color: "fg"},
                    when(!t.assignee.is-empty,
                        row(
                            icon(name="user") {size: "sm", color: "muted"},
                            text(t.assignee) {size: "xs", color: "muted"}
                        ) {gap: "xs", align: "center"}),
                    when(t.dueDate.is-some,
                        text("Due " + formatDueDate(t.dueDate)) {size: "xs", color: "muted"}),
                    when(!t.tags.is-empty,
                        row(
                            for tag in t.tags
                                TagChip(tag) {key: tag}
                        ) {gap: "xs", wrap: true}),
                    row(
                        MoveTaskBtn(t.id),
                        DeleteTaskBtn(t.id)
                    ) {justify: "between", align: "center", gap: "xs"}
                ) {gap: "sm"}
            ) {
                bg: "bg",
                pad: "sm",
                radius: "md",
                shadow: "sm",
                style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
            }
        | None -> box()

tile BoardColumn in=BoardColumnArg
    = panel(
        column(
            row(
                StatusBadge($1.status),
                text(tasksByStatus(tasks, $1.projectId, filter, $1.status).length.show) {size: "xs", weight: "bold", color: "muted"}
            ) {justify: "between", align: "center"},
            divider(),
            if tasksByStatus(tasks, $1.projectId, filter, $1.status).is-empty
            then text("No tasks") {size: "xs", color: "muted"}
            else stack(
                for tid in tasksByStatus(tasks, $1.projectId, filter, $1.status)
                    BoardTaskCard(tid) {key: tid.show}
            ) {gap: "sm"}
        ) {gap: "sm"}
    ) {
        bg: "surface",
        pad: "md",
        radius: "md",
        style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
    }

tile TaskBoardView in=ProjectId
    = grid(
        BoardColumn({projectId: $1, status: Backlog}),
        BoardColumn({projectId: $1, status: InProgress}),
        BoardColumn({projectId: $1, status: Review}),
        BoardColumn({projectId: $1, status: Done})
    ) {cols: {base: 1, md: 2, lg: 4}, gap: "md"}

tile ProjectTasksView in=ProjectId
    = match viewMode with
        | ListView  -> TaskListView($1)
        | BoardView -> TaskBoardView($1)

tile ProjectPage
    error-boundary = ErrorFallback
    = page(
        TopNav,
        StorageBanner,
        box(
            match currentProject(route, projects) with
              | Some(p) ->
                  column(
                      row(
                          icon(name="arrow-left") {size: "sm", color: "primary"},
                          link(to="/", text="All Projects") {size: "sm", color: "primary"}
                      ) {gap: "xs", align: "center"},
                      row(
                          column(
                              row(
                                  box() {w: 14, h: 14, radius: "pill", style: {background: p.color}},
                                  heading(p.name, level=1) {size: "xl", weight: "bold"},
                                  when(p.archived,
                                      box(text("Archived") {size: "xs", color: "muted"}) {bg: "surface-alt", pad-x: "sm", pad-y: "xs", radius: "pill"})
                              ) {gap: "sm", align: "center"},
                              when(!p.description.is-empty,
                                  text(p.description) {size: "sm", color: "muted"})
                          ) {gap: "xs"},
                          row(
                              row(
                                  ViewModeBtn(ListView),
                                  ViewModeBtn(BoardView)
                              ) {gap: "xs"},
                              link(
                                  to="/projects/" + p.id.show + "/new-task",
                                  text="+ New Task"
                              ) {bg: "primary", color: "on-primary", pad-x: "md", pad-y: "xs", radius: "sm", size: "sm", weight: "medium"}
                          ) {gap: "md", align: "center", wrap: true}
                      ) {justify: "between", align: "center", wrap: true, gap: "md"},
                      FilterBar,
                      row(
                          text(fmt("Showing {0} of {1} tasks", filteredTasks(tasks, p.id, filter).length, tasksForProject(tasks, p.id).length)) {size: "xs", color: "muted"}
                      ),
                      ProjectTasksView(p.id)
                  ) {gap: "md"}
              | None ->
                  box(
                      column(
                          heading("Project not found", level=1) {size: "xl", weight: "bold"},
                          text("This project does not exist or has been deleted.") {size: "sm", color: "muted"},
                          link(to="/", text="Back to Projects") {color: "primary", weight: "medium"}
                      ) {gap: "sm"}
                  ) {bg: "surface", pad: "xl", radius: "md"}
        ) {pad: "lg", max-w: 1280}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

# ============================================================================
# Tiles — TaskDetailPage
# ============================================================================

tile SubtaskRow in=TaskId
    = match tasks.get($1) with
        | Some(st) ->
            row(
                row(
                    StatusBadge(st.status),
                    link(
                        to="/projects/" + st.projectId.show + "/tasks/" + st.id.show,
                        text=st.title
                    ) {size: "sm", weight: "medium", color: "fg"},
                    PriorityBadge(st.priority)
                ) {gap: "sm", align: "center", wrap: true},
                row(
                    MoveTaskBtn(st.id),
                    DeleteTaskBtn(st.id)
                ) {gap: "xs", align: "center"}
            ) {
                justify: "between",
                align: "center",
                bg: "bg",
                pad: "sm",
                radius: "sm",
                style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
            }
        | None -> box()

tile CommentCard in=CommentId
    = match comments.get($1) with
        | Some(c) ->
            card(
                column(
                    row(
                        row(
                            icon(name="user") {size: "sm", color: "muted"},
                            text(c.author) {size: "sm", weight: "bold"},
                            text(formatDateTime(c.createdAt)) {size: "xs", color: "muted"}
                        ) {gap: "sm", align: "center"},
                        DeleteCommentBtn(c.id)
                    ) {justify: "between", align: "center"},
                    text(c.body) {size: "sm", color: "fg"}
                ) {gap: "xs"}
            ) {
                bg: "bg",
                pad: "md",
                radius: "sm",
                style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
            }
        | None -> box()

tile ParentTaskLink in=TaskId
    = match tasks.get($1) with
        | Some(pt) ->
            row(
                text("Subtask of:") {size: "xs", color: "muted"},
                link(
                    to="/projects/" + pt.projectId.show + "/tasks/" + pt.id.show,
                    text=pt.title
                ) {size: "xs", color: "primary", weight: "medium"}
            ) {gap: "xs", align: "center"}
        | None -> box()

tile TaskDetailContent in=TaskId
    = match tasks.get($1) with
        | Some(t) ->
            column(
                row(
                    row(
                        icon(name="arrow-left") {size: "sm", color: "primary"},
                        link(to="/projects/" + t.projectId.show, text="Back to Project") {size: "sm", color: "primary", weight: "medium"}
                    ) {gap: "xs", align: "center"},
                    DeleteTaskBtn(t.id)
                ) {justify: "between", align: "center"},
                match t.parentTaskId with
                  | Some(parentId) -> ParentTaskLink(parentId)
                  | None           -> box(),
                row(
                    StatusBadge(t.status),
                    PriorityBadge(t.priority),
                    DueBadge(dueDateStatus(t.dueDate))
                ) {gap: "sm", align: "center", wrap: true},
                grid(
                    column(
                        panel(
                            column(
                                column(
                                    label("Title") {for: "detail-title", size: "xs", color: "muted"},
                                    TaskTitleInput(t.id)
                                ) {gap: "xs"},
                                column(
                                    label("Description") {for: "detail-desc", size: "xs", color: "muted"},
                                    TaskDescInput(t.id)
                                ) {gap: "xs"}
                            ) {gap: "md"}
                        ) {
                            bg: "surface",
                            pad: "lg",
                            radius: "md",
                            style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                        },
                        panel(
                            column(
                                heading("Tags", level=2) {size: "md", weight: "bold"},
                                if t.tags.is-empty
                                then text("No tags yet.") {size: "xs", color: "muted"}
                                else row(
                                    for tag in t.tags
                                        RemovableTag({taskId: t.id, tag: tag}) {key: tag}
                                ) {gap: "xs", wrap: true},
                                AddTagForm
                            ) {gap: "sm"}
                        ) {
                            bg: "surface",
                            pad: "lg",
                            radius: "md",
                            style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                        },
                        panel(
                            column(
                                heading(fmt("Subtasks ({0})", subtasksFor(tasks, t.id).length), level=2) {size: "md", weight: "bold"},
                                if subtasksFor(tasks, t.id).is-empty
                                then text("No subtasks yet.") {size: "xs", color: "muted"}
                                else stack(
                                    for sid in subtasksFor(tasks, t.id)
                                        SubtaskRow(sid) {key: sid.show}
                                ) {gap: "xs"},
                                NewSubtaskForm
                            ) {gap: "sm"}
                        ) {
                            bg: "surface",
                            pad: "lg",
                            radius: "md",
                            style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                        },
                        panel(
                            column(
                                heading(fmt("Comments ({0})", commentsForTask(comments, t.id).length), level=2) {size: "md", weight: "bold"},
                                if commentsForTask(comments, t.id).is-empty
                                then text("No comments yet.") {size: "xs", color: "muted"}
                                else stack(
                                    for cid in commentsForTask(comments, t.id)
                                        CommentCard(cid) {key: cid.show}
                                ) {gap: "sm"},
                                divider(),
                                CommentForm
                            ) {gap: "md"}
                        ) {
                            bg: "surface",
                            pad: "lg",
                            radius: "md",
                            style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                        }
                    ) {gap: "md"},
                    panel(
                        column(
                            heading("Details", level=2) {size: "md", weight: "bold"},
                            column(
                                label("Status") {for: "detail-status", size: "xs", color: "muted"},
                                TaskStatusSelect(t.id)
                            ) {gap: "xs"},
                            column(
                                label("Priority") {for: "detail-priority", size: "xs", color: "muted"},
                                TaskPrioritySelect(t.id)
                            ) {gap: "xs"},
                            column(
                                label("Assignee") {for: "detail-assignee", size: "xs", color: "muted"},
                                TaskAssigneeInput(t.id)
                            ) {gap: "xs"},
                            column(
                                label("Due Date") {for: "detail-due", size: "xs", color: "muted"},
                                TaskDueDateInput(t.id)
                            ) {gap: "xs"},
                            divider(),
                            text("Created: " + formatDateTime(t.createdAt)) {size: "xs", color: "muted"},
                            text("Updated: " + formatDateTime(t.updatedAt)) {size: "xs", color: "muted"}
                        ) {gap: "md"}
                    ) {
                        bg: "surface",
                        pad: "lg",
                        radius: "md",
                        style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                    }
                ) {cols: {base: 1, lg: 2}, gap: "lg"}
            ) {gap: "md"}
        | None -> box()

tile TaskDetailPage
    error-boundary = ErrorFallback
    = page(
        TopNav,
        StorageBanner,
        box(
            match currentTask(route, tasks) with
              | Some(t) -> TaskDetailContent(t.id)
              | None ->
                  box(
                      column(
                          heading("Task not found", level=1) {size: "xl", weight: "bold"},
                          text("This task does not exist or was deleted.") {size: "sm", color: "muted"},
                          link(to="/", text="Back to Projects") {color: "primary", weight: "medium"}
                      ) {gap: "sm"}
                  ) {bg: "surface", pad: "xl", radius: "md"}
        ) {pad: "lg", max-w: 1120}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

# ============================================================================
# Tiles — NewTaskPage
# ============================================================================

tile NewTaskPage
    error-boundary = ErrorFallback
    = page(
        TopNav,
        StorageBanner,
        box(
            match currentProject(route, projects) with
              | Some(p) ->
                  column(
                      row(
                          icon(name="arrow-left") {size: "sm", color: "primary"},
                          link(to="/projects/" + p.id.show, text="Back to " + p.name) {size: "sm", color: "primary", weight: "medium"}
                      ) {gap: "xs", align: "center"},
                      heading("New Task in " + p.name, level=1) {size: "xl", weight: "bold"},
                      panel(NewTaskForm) {
                          bg: "surface",
                          pad: "lg",
                          radius: "md",
                          shadow: "sm",
                          style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                      }
                  ) {gap: "md"}
              | None ->
                  box(
                      column(
                          heading("Project not found", level=1) {size: "xl", weight: "bold"},
                          text("Cannot create a task without a valid project.") {size: "sm", color: "muted"},
                          link(to="/", text="Back to Projects") {color: "primary", weight: "medium"}
                      ) {gap: "sm"}
                  ) {bg: "surface", pad: "xl", radius: "md"}
        ) {pad: "lg", max-w: 840}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

# ============================================================================
# Tiles — SettingsPage & NotFound
# ============================================================================

tile SettingsPage
    error-boundary = ErrorFallback
    = page(
        TopNav,
        StorageBanner,
        box(
            column(
                heading("Settings", level=1) {size: "xxl", weight: "bold"},
                panel(
                    column(
                        heading("Appearance", level=2) {size: "lg", weight: "bold"},
                        row(
                            column(
                                text("Theme") {weight: "medium"},
                                text("Active theme: " + themeName) {size: "sm", color: "muted"}
                            ) {gap: "xs"},
                            ThemeToggleBtn
                        ) {justify: "between", align: "center", wrap: true, gap: "md"}
                    ) {gap: "md"}
                ) {
                    bg: "surface",
                    pad: "lg",
                    radius: "md",
                    style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                },
                panel(
                    column(
                        heading("Workspace Summary", level=2) {size: "lg", weight: "bold"},
                        grid(
                            box(
                                column(
                                    text(projects.size.show) {size: "xl", weight: "bold", color: "primary"},
                                    text("Projects") {size: "xs", color: "muted"}
                                ) {gap: "xs"}
                            ) {bg: "bg", pad: "md", radius: "sm"},
                            box(
                                column(
                                    text(tasks.size.show) {size: "xl", weight: "bold", color: "primary"},
                                    text("Tasks") {size: "xs", color: "muted"}
                                ) {gap: "xs"}
                            ) {bg: "bg", pad: "md", radius: "sm"},
                            box(
                                column(
                                    text(comments.size.show) {size: "xl", weight: "bold", color: "primary"},
                                    text("Comments") {size: "xs", color: "muted"}
                                ) {gap: "xs"}
                            ) {bg: "bg", pad: "md", radius: "sm"}
                        ) {cols: {base: 1, sm: 3}, gap: "md"},
                        text(if ready then "Persistence: localStorage ready" else "Persistence: loading...") {size: "xs", color: "muted"}
                    ) {gap: "md"}
                ) {
                    bg: "surface",
                    pad: "lg",
                    radius: "md",
                    style: {border-width: "1px", border-style: "solid", border-color: @colors.border}
                }
            ) {gap: "lg"}
        ) {pad: "lg", max-w: 840}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

tile NotFound
    = page(
        TopNav,
        box(
            column(
                heading("404", level=1) {size: "xxl", weight: "bold", color: "primary"},
                heading("Page not found", level=2) {size: "lg", weight: "medium"},
                text("The page you requested does not exist.") {size: "sm", color: "muted"},
                link(to="/", text="Go to Projects") {bg: "primary", color: "on-primary", pad-x: "md", pad-y: "sm", radius: "sm"}
            ) {gap: "md", align: "start"}
        ) {pad: "xl", max-w: 640}
    ) {bg: "bg", color: "fg", min-h: "100vh"}

# ============================================================================
# Application Entry
# ============================================================================

app ProjectManager
    caps   = [storage.read, storage.write, nav.push, nav.replace, nav.back, notification.show]
    routes = {
        "/"                           -> ProjectsPage,
        "/projects/:id"               -> ProjectPage,
        "/projects/:id/tasks/:taskId" -> TaskDetailPage,
        "/projects/:id/new-task"      -> NewTaskPage,
        "/settings"                   -> SettingsPage,
        "/404"                        -> NotFound
    }
    init   = []
    theme  = themeName
    meta   = {
        title: "Kumiki PM",
        description: "Project Management Tool SPA in Kumiki"
    }
