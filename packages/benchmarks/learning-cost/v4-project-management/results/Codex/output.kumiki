type ProjectId = nominal Text where uuid
type TaskId = nominal Text where uuid
type CommentId = nominal Text where uuid
type Status = Backlog | InProgress | Review | Done
type Priority = Low | Med | High | Critical
type ViewMode = ListView | BoardView
type DueState = Overdue | Today | Soon | Upcoming | NoDue

type Project = {id: ProjectId, name: Text, description: Text, color: Text, archived: Bool, createdAt: Time}
type Task = {id: TaskId, projectId: ProjectId, title: Text, description: Text, status: Status, priority: Priority, assignee: Text, dueDate: Option(Time), tags: List(Text), parentTaskId: Option(TaskId), createdAt: Time, updatedAt: Time}
type Comment = {id: CommentId, taskId: TaskId, author: Text, body: Text, createdAt: Time}
type FilterState = {status: Option(Status), priority: Option(Priority), assignee: Text, search: Text}
type ProjectDraft = {name: Text, description: Text, color: Text}
type TaskDraft = {title: Text, description: Text, priority: Priority, assignee: Text, tags: Text, dueDate: Text}
type StatusOption = {label: Text, value: Status}
type PriorityOption = {label: Text, value: Priority}
type TextOption = {label: Text, value: Text}

slot projects : Map(ProjectId, Project) = {}
slot tasks : Map(TaskId, Task) = {}
slot comments : Map(CommentId, Comment) = {}
slot viewMode : ViewMode = ListView
slot filter : FilterState = {status: None, priority: None, assignee: "", search: ""}
slot themeName : Text = "Light"
slot draftProject : ProjectDraft = {name: "", description: "", color: "#6366f1"}
slot draftTask : TaskDraft = {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
slot commentDraft : Text = ""
slot tagDraft : Text = ""
slot ready : Bool = false
slot loadsDone : Int = 0

theme Light = {
  colors: {bg: "#f6f7fb", fg: "#172033", surface: "#ffffff", muted: "#64748b", primary: "#4f46e5", border: "#e2e8f0", danger: "#b91c1c"},
  spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"},
  radius: {sm: "4px", md: "10px", lg: "16px"},
  typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"}, weight: {normal: "400", bold: "700"}, line-height: "1.5"}
}
theme Dark = {
  colors: {bg: "#111827", fg: "#f1f5f9", surface: "#1f2937", muted: "#aab7ca", primary: "#a5b4fc", border: "#475569", danger: "#fca5a5"},
  spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"},
  radius: {sm: "4px", md: "10px", lg: "16px"},
  typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"}, weight: {normal: "400", bold: "700"}, line-height: "1.5"}
}

effect saveProjects cap=storage.write in=Map(ProjectId, Project) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "projects", value: $1}
effect saveTasks cap=storage.write in=Map(TaskId, Task) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "tasks", value: $1}
effect saveComments cap=storage.write in=Map(CommentId, Comment) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "comments", value: $1}
effect loadProjects cap=storage.read in=Unit out=Result(Option(Map(ProjectId, Project)), Text) policy=once map-request={key: "projects", decode: Decoder.Json(Map(ProjectId, Project))}
effect loadTasks cap=storage.read in=Unit out=Result(Option(Map(TaskId, Task)), Text) policy=once map-request={key: "tasks", decode: Decoder.Json(Map(TaskId, Task))}
effect loadComments cap=storage.read in=Unit out=Result(Option(Map(CommentId, Comment)), Text) policy=once map-request={key: "comments", decode: Decoder.Json(Map(CommentId, Comment))}

fn statusLabel(s: Status) -> Text = match s with
  | Backlog -> "Backlog"
  | InProgress -> "In Progress"
  | Review -> "Review"
  | Done -> "Done"
fn statusColor(s: Status) -> Text = match s with
  | Backlog -> "muted"
  | InProgress -> "primary"
  | Review -> "primary"
  | Done -> "muted"
fn priorityLabel(p: Priority) -> Text = match p with
  | Low -> "Low"
  | Med -> "Med"
  | High -> "High"
  | Critical -> "Critical"
fn priorityColor(p: Priority) -> Text = match p with
  | Low -> "muted"
  | Med -> "primary"
  | High -> "danger"
  | Critical -> "danger"
fn nextStatus(s: Status) -> Status = match s with
  | Backlog -> InProgress
  | InProgress -> Review
  | Review -> Done
  | Done -> Done
fn statusOptions() -> List(StatusOption) = [
  {label: "Backlog", value: Backlog},
  {label: "In Progress", value: InProgress},
  {label: "Review", value: Review},
  {label: "Done", value: Done}
]
fn priorityOptions() -> List(PriorityOption) = [
  {label: "Low", value: Low},
  {label: "Med", value: Med},
  {label: "High", value: High},
  {label: "Critical", value: Critical}
]
fn statusFilterOptions() -> List(TextOption) = [
  {label: "All", value: "All"}, {label: "Backlog", value: "Backlog"},
  {label: "In Progress", value: "In Progress"}, {label: "Review", value: "Review"},
  {label: "Done", value: "Done"}
]
fn priorityFilterOptions() -> List(TextOption) = [
  {label: "All", value: "All"}, {label: "Low", value: "Low"},
  {label: "Med", value: "Med"}, {label: "High", value: "High"},
  {label: "Critical", value: "Critical"}
]
fn statusFilterValue(s: Option(Status)) -> Text = match s with
  | None -> "All"
  | Some(v) -> statusLabel(v)
fn priorityFilterValue(p: Option(Priority)) -> Text = match p with
  | None -> "All"
  | Some(v) -> priorityLabel(v)
fn parseStatusFilter(s: Text) -> Option(Status) =
  if s == "Backlog" then Some(Backlog) else
  if s == "In Progress" then Some(InProgress) else
  if s == "Review" then Some(Review) else
  if s == "Done" then Some(Done) else None
fn parsePriorityFilter(s: Text) -> Option(Priority) =
  if s == "Low" then Some(Low) else
  if s == "Med" then Some(Med) else
  if s == "High" then Some(High) else
  if s == "Critical" then Some(Critical) else None
fn formatDate(t: Time) -> Text = t.format("yyyy-MM-dd")
fn dueDateStatus(d: Option(Time)) -> DueState = match d with
  | None -> NoDue
  | Some(t) -> if formatDate(t) < formatDate(now) then Overdue else
               if formatDate(t) == formatDate(now) then Today else
               if t < now.plus(Duration.d(7)) then Soon else Upcoming
fn parseTags(s: Text) -> List(Text) = s.split(",").map($1.trim).filter(!$1.is-empty).unique
fn routeProjectId(r: Route) -> Option(ProjectId) = ProjectId.parse(r.params.get-or("id", ""))
fn routeTaskId(r: Route) -> Option(TaskId) = TaskId.parse(r.params.get-or("taskId", ""))
fn currentProject(r: Route, ps: Map(ProjectId, Project)) -> Option(Project) = routeProjectId(r).flat-map(ps.get($1))
fn currentTask(r: Route, ts: Map(TaskId, Task)) -> Option(Task) = routeTaskId(r).flat-map(ts.get($1)).filter(Some($1.projectId) == routeProjectId(r))
fn tasksForProject(ts: Map(TaskId, Task), pid: ProjectId) -> List(TaskId) =
  ts.entries.filter($2.projectId == pid).sort-by($2.updatedAt).reverse.map($1)
fn subtasksFor(ts: Map(TaskId, Task), parent: TaskId) -> List(TaskId) =
  ts.entries.filter($2.parentTaskId == Some(parent)).sort-by($2.createdAt).map($1)
fn matchesFilter(t: Task, pid: ProjectId, f: FilterState) -> Bool =
  t.projectId == pid && (f.status.is-none || f.status == Some(t.status)) &&
  (f.priority.is-none || f.priority == Some(t.priority)) &&
  t.assignee.lower.contains(f.assignee.trim.lower) && t.title.lower.contains(f.search.trim.lower)
fn filteredTasks(ts: Map(TaskId, Task), pid: ProjectId, f: FilterState) -> List(TaskId) =
  ts.entries.filter(matchesFilter($2, pid, f)).sort-by($2.updatedAt).reverse.map($1)
fn tasksByStatus(ts: Map(TaskId, Task), pid: ProjectId, f: FilterState, s: Status) -> List(TaskId) =
  ts.entries.filter(matchesFilter($2, pid, f) && $2.status == s).sort-by($2.updatedAt).reverse.map($1)
fn commentsForTask(cs: Map(CommentId, Comment), tid: TaskId) -> List(CommentId) =
  cs.entries.filter($2.taskId == tid).sort-by($2.createdAt).map($1)
fn projectPath(id: ProjectId) -> Text = "/projects/" + id.show
fn taskPath(pid: ProjectId, tid: TaskId) -> Text = projectPath(pid) + "/tasks/" + tid.show

reducer loadAll on=app.start do=
  emit loadProjects()
  emit loadTasks()
  emit loadComments()
reducer projectsLoaded on=loadProjects.ok($value, _) do=
  projects := $value.get-or({})
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer tasksLoaded on=loadTasks.ok($value, _) do=
  tasks := $value.get-or({})
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer commentsLoaded on=loadComments.ok($value, _) do=
  comments := $value.get-or({})
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer projectsLoadFailed on=loadProjects.err(_, _) do=
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer tasksLoadFailed on=loadTasks.err(_, _) do=
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer commentsLoadFailed on=loadComments.err(_, _) do=
  loadsDone := loadsDone + 1
  ready := loadsDone >= 3
reducer projectsSaveFailed on=saveProjects.err(_, _) do= ()
reducer tasksSaveFailed on=saveTasks.err(_, _) do= ()
reducer commentsSaveFailed on=saveComments.err(_, _) do= ()

reducer createProject on=ui.submit(ProjectForm) do=
  if !draftProject.name.trim.is-empty then {
    let id = ProjectId.fresh()
    projects[id] := {id: id, name: draftProject.name.trim, description: draftProject.description, color: draftProject.color, archived: false, createdAt: now}
    draftProject := {name: "", description: "", color: "#6366f1"}
    emit saveProjects(projects)
    emit navigate({path: projectPath(id)})
  }
reducer archiveProject on=ui.click(ArchiveButton) do=
  projects[$el.projectId].archived := true
  emit saveProjects(projects)
reducer unarchiveProject on=ui.click(UnarchiveButton) do=
  projects[$el.projectId].archived := false
  emit saveProjects(projects)
reducer deleteProject on=ui.click(DeleteProjectButton) do=
  let id = $el.projectId
  let removed = tasks.filter($2.projectId == id).keys
  projects := projects.remove(id)
  tasks := tasks.filter($2.projectId != id)
  comments := comments.filter(!removed.contains($2.taskId))
  emit saveProjects(projects)
  emit saveTasks(tasks)
  emit saveComments(comments)

reducer openNewTask on=ui.click(NewTaskButton) do=
  draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
  match routeProjectId(route) with
    | Some(id) -> emit navigate({path: projectPath(id) + "/new-task"})
    | None -> ()
reducer openSubtask on=ui.click(AddSubtaskButton) do=
  draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
  match currentTask(route, tasks) with
    | Some(t) -> emit navigate({path: projectPath(t.projectId) + "/new-task", query: {"parent": t.id.show}})
    | None -> ()
reducer createTask on=ui.submit(TaskForm) do=
  if !draftTask.title.trim.is-empty then {
    match routeProjectId(route) with
      | Some(pid) -> {
          if projects.has(pid) then {
            let id = TaskId.fresh()
            let parent = route.query.get("parent").flat-map(TaskId.parse($1)).filter(tasks.has($1) && tasks[$1].projectId == pid)
            tasks[id] := {id: id, projectId: pid, title: draftTask.title.trim, description: draftTask.description, status: Backlog, priority: draftTask.priority, assignee: draftTask.assignee, dueDate: Time.parse(draftTask.dueDate), tags: parseTags(draftTask.tags), parentTaskId: parent, createdAt: now, updatedAt: now}
            draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
            emit saveTasks(tasks)
            emit navigate({path: taskPath(pid, id)})
          }
        }
      | None -> ()
  }
reducer cancelTask on=ui.click(CancelTaskButton) do=
  match routeProjectId(route) with
    | Some(id) -> emit navigate({path: projectPath(id)})
    | None -> emit navigate({path: "/"})
reducer backToProject on=ui.click(BackButton) do=
  match routeProjectId(route) with
    | Some(id) -> emit navigate({path: projectPath(id)})
    | None -> emit navigate({path: "/"})
reducer updateTaskStatus on=ui.change(DetailStatus) do=
  tasks[$el.taskId].status := $event.value
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer updateTaskPriority on=ui.change(DetailPriority) do=
  tasks[$el.taskId].priority := $event.value
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer updateTaskTitle on=ui.input(DetailTitle) do=
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer updateTaskDescription on=ui.input(DetailDescription) do=
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer updateTaskAssignee on=ui.input(DetailAssignee) do=
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer updateTaskDueDate on=ui.change(DetailDue) do=
  tasks[$el.taskId].dueDate := Time.parse($event.value)
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer addTaskTag on=ui.click(AddTagButton) do=
  if !tagDraft.trim.is-empty then {
    tasks[$el.taskId].tags := tasks[$el.taskId].tags.concat(parseTags(tagDraft)).unique
    tasks[$el.taskId].updatedAt := now
    tagDraft := ""
    emit saveTasks(tasks)
  }
reducer removeTaskTag on=ui.click(RemoveTagButton) do=
  tasks[$el.taskId].tags := tasks[$el.taskId].tags.filter($1 != $el.tag)
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)
reducer deleteTask on=ui.click(DeleteTaskButton) do=
  match currentTask(route, tasks) with
    | Some(t) -> {
        tasks := tasks.remove(t.id).map(if $2.parentTaskId == Some(t.id) then $2.copy(parentTaskId=None) else $2)
        comments := comments.filter($2.taskId != t.id)
        emit saveTasks(tasks)
        emit saveComments(comments)
        emit navigate({path: projectPath(t.projectId)})
      }
    | None -> ()
reducer moveTaskStatus on=ui.click(AdvanceButton) do=
  tasks[$el.taskId].status := nextStatus(tasks[$el.taskId].status)
  tasks[$el.taskId].updatedAt := now
  emit saveTasks(tasks)

reducer addComment on=ui.click(AddCommentButton) do=
  if !commentDraft.trim.is-empty then {
    match currentTask(route, tasks) with
      | Some(t) -> {
          let id = CommentId.fresh()
          comments[id] := {id: id, taskId: t.id, author: "You", body: commentDraft.trim, createdAt: now}
          commentDraft := ""
          emit saveComments(comments)
        }
      | None -> ()
  }
reducer deleteComment on=ui.click(DeleteCommentButton) do=
  comments := comments.remove($el.commentId)
  emit saveComments(comments)

reducer setFilterStatus on=ui.change(FilterStatus) do= filter.status := parseStatusFilter($event.value)
reducer setFilterPriority on=ui.change(FilterPriority) do= filter.priority := parsePriorityFilter($event.value)
reducer setFilterAssignee on=ui.input(FilterAssignee) do= filter.assignee := $event.value
reducer setSearch on=ui.input(FilterSearch) do= filter.search := $event.value
reducer clearFilter on=ui.click(ClearFiltersButton) do= filter := {status: None, priority: None, assignee: "", search: ""}
reducer setViewMode on=ui.click(ViewModeButton) do= viewMode := if viewMode == ListView then BoardView else ListView
reducer toggleTheme on=ui.click(ThemeButton) do= themeName := if themeName == "Light" then "Dark" else "Light"

tile LoadingPage = page(text("Loading...")) {pad: "xl", bg: "bg", color: "fg"}
tile NotFound = page(column(heading("Page not found"), link("Projects", to="/")) {gap: "md"}) {pad: "xl", bg: "bg", color: "fg"}
tile Header = row(link("Projects", to="/"), link("Settings", to="/settings")) {gap: "lg"}
tile ProjectForm = form(column(
  heading("Create a project", level=2),
  label("Project name", for="project-name"),
  input(bind=draftProject.name, id="project-name", placeholder="Project name"),
  label("Description", for="project-description"),
  textarea(bind=draftProject.description, id="project-description", rows=3),
  button(text="Create project", type="submit")
) {gap: "sm"})
tile ArchiveButton in=ProjectId = button(text="Archive") {projectId: $1}
tile UnarchiveButton in=ProjectId = button(text="Unarchive") {projectId: $1}
tile DeleteProjectButton in=ProjectId = button(text="Delete project") {projectId: $1}
tile ProjectCard in=ProjectId = card(column(
  link(projects[$1].name, to=projectPath($1)),
  text(projects[$1].description),
  text(tasksForProject(tasks, $1).length.show + " tasks"),
  if projects[$1].archived then row(text("Archived"), UnarchiveButton($1)) {gap: "sm"} else ArchiveButton($1),
  DeleteProjectButton($1)
) {gap: "sm"}) {pad: "md", bg: "surface", radius: "md"}
tile ProjectsContent = page(column(
  Header,
  heading("Projects"),
  ProjectForm,
  when(projects.is-empty, text("No projects")),
  for id in projects.keys ProjectCard(id) {key: id.show}
) {gap: "lg"}) {pad: "xl", bg: "bg", color: "fg"}
tile ProjectsPage = if ready then ProjectsContent else LoadingPage

tile NewTaskButton = button(text="New task")
tile ViewModeButton = button(text=if viewMode == ListView then "Board view" else "List view")
tile FilterStatus = select(id="filter-status", value=statusFilterValue(filter.status), options=statusFilterOptions())
tile FilterPriority = select(id="filter-priority", value=priorityFilterValue(filter.priority), options=priorityFilterOptions())
tile FilterAssignee = input(id="filter-assignee", value=filter.assignee, placeholder="Assignee")
tile FilterSearch = input(id="filter-search", value=filter.search, placeholder="Search tasks")
tile ClearFiltersButton = button(text="Clear filters")
tile FilterBar = row(FilterStatus, FilterPriority, FilterAssignee, FilterSearch, ClearFiltersButton) {gap: "sm"}
tile AdvanceButton in=TaskId = button(text="Advance") {taskId: $1}
tile TaskCard in=TaskId = card(column(
  link(tasks[$1].title, to=taskPath(tasks[$1].projectId, $1)),
  row(text(statusLabel(tasks[$1].status)) {color: statusColor(tasks[$1].status)}, text(priorityLabel(tasks[$1].priority)) {color: priorityColor(tasks[$1].priority)}) {gap: "md"},
  when(!tasks[$1].assignee.is-empty, text(tasks[$1].assignee)),
  match tasks[$1].dueDate with | Some(d) -> text(formatDate(d)) | None -> text(""),
  row(for tag in tasks[$1].tags text(tag) {key: tag}) {gap: "sm"},
  when(viewMode == BoardView, AdvanceButton($1))
) {gap: "sm"}) {pad: "md", bg: "surface", radius: "md"}
tile BoardColumn in={projectId: ProjectId, status: Status} = column(
  heading(statusLabel($1.status), level=2),
  for id in tasksByStatus(tasks, $1.projectId, filter, $1.status) TaskCard(id) {key: id.show}
) {gap: "sm", pad: "md"}
tile ProjectContent in=Project = page(column(
  Header,
  heading($1.name),
  text($1.description),
  row(NewTaskButton, ViewModeButton) {gap: "sm"},
  FilterBar,
  when(filteredTasks(tasks, $1.id, filter).is-empty, text("No tasks")),
  if viewMode == ListView then
    column(for id in filteredTasks(tasks, $1.id, filter) TaskCard(id) {key: id.show}) {gap: "md"}
  else
    row(
      BoardColumn({projectId: $1.id, status: Backlog}),
      BoardColumn({projectId: $1.id, status: InProgress}),
      BoardColumn({projectId: $1.id, status: Review}),
      BoardColumn({projectId: $1.id, status: Done})
    ) {gap: "md"}
) {gap: "lg"}) {pad: "xl", bg: "bg", color: "fg"}
tile ProjectLoaded = match currentProject(route, projects) with
  | Some(p) -> ProjectContent(p)
  | None -> NotFound
tile ProjectPage = if ready then ProjectLoaded else LoadingPage

tile CancelTaskButton = button(text="Cancel", type="button")
tile TaskForm = form(column(
  label("Title", for="task-title"),
  input(bind=draftTask.title, id="task-title"),
  label("Description", for="task-description"),
  textarea(bind=draftTask.description, id="task-description", rows=4),
  label("Priority", for="task-priority"),
  select(bind=draftTask.priority, id="task-priority", options=priorityOptions()),
  label("Assignee", for="task-assignee"),
  input(bind=draftTask.assignee, id="task-assignee"),
  label("Tags", for="task-tags"),
  input(bind=draftTask.tags, id="task-tags", placeholder="Comma-separated tags"),
  label("Due date", for="task-due"),
  input(bind=draftTask.dueDate, id="task-due", type="date"),
  row(button(text="Create task", type="submit"), CancelTaskButton) {gap: "sm"}
) {gap: "sm"})
tile NewTaskContent in=Project = page(column(
  Header, heading("New task"), text($1.name), TaskForm
) {gap: "lg"}) {pad: "xl", bg: "bg", color: "fg"}
tile NewTaskLoaded = match currentProject(route, projects) with
  | Some(p) -> NewTaskContent(p)
  | None -> NotFound
tile NewTaskPage = if ready then NewTaskLoaded else LoadingPage

tile BackButton = button(text="Back")
tile DetailTitle in=TaskId = input(bind=tasks[$1].title, id="detail-title") {taskId: $1}
tile DetailDescription in=TaskId = textarea(bind=tasks[$1].description, id="detail-description", rows=4) {taskId: $1}
tile DetailStatus in=TaskId = select(id="detail-status", value=tasks[$1].status, options=statusOptions()) {taskId: $1}
tile DetailPriority in=TaskId = select(id="detail-priority", value=tasks[$1].priority, options=priorityOptions()) {taskId: $1}
tile DetailAssignee in=TaskId = input(bind=tasks[$1].assignee, id="detail-assignee") {taskId: $1}
tile DetailDue in=TaskId = input(id="detail-due", type="date", value=match tasks[$1].dueDate with | Some(d) -> formatDate(d) | None -> "") {taskId: $1}
tile AddTagButton in=TaskId = button(text="Add tag") {taskId: $1}
tile RemoveTagButton in={taskId: TaskId, tag: Text} = button(text="Remove tag") {taskId: $1.taskId, tag: $1.tag}
tile AddSubtaskButton = button(text="Add subtask")
tile AddCommentButton = button(text="Add comment")
tile DeleteCommentButton in=CommentId = button(text="Delete comment") {commentId: $1}
tile DeleteTaskButton = button(text="Delete task")
tile CommentCard in=CommentId = card(column(
  text(comments[$1].author), text(comments[$1].body), text(formatDate(comments[$1].createdAt)), DeleteCommentButton($1)
) {gap: "sm"}) {pad: "md", bg: "surface", radius: "md"}
tile TaskDetailContent in=Task = page(column(
  Header,
  BackButton,
  heading($1.title),
  text($1.description),
  label("Title", for="detail-title"), DetailTitle($1.id),
  label("Description", for="detail-description"), DetailDescription($1.id),
  label("Status", for="detail-status"), DetailStatus($1.id),
  label("Priority", for="detail-priority"), DetailPriority($1.id),
  label("Assignee", for="detail-assignee"), DetailAssignee($1.id),
  label("Due date", for="detail-due"), DetailDue($1.id),
  match $1.dueDate with | Some(d) -> text(formatDate(d)) | None -> text("No due date"),
  heading("Tags", level=2),
  for tag in $1.tags row(text(tag), RemoveTagButton({taskId: $1.id, tag: tag})) {key: tag, gap: "sm"},
  row(input(bind=tagDraft, id="tag-input"), AddTagButton($1.id)) {gap: "sm"},
  heading("Subtasks", level=2),
  AddSubtaskButton,
  for id in subtasksFor(tasks, $1.id) link(tasks[id].title, to=taskPath($1.projectId, id)) {key: id.show},
  heading("Comments", level=2),
  row(input(bind=commentDraft, id="comment-input"), AddCommentButton) {gap: "sm"},
  for id in commentsForTask(comments, $1.id) CommentCard(id) {key: id.show},
  DeleteTaskButton
) {gap: "md"}) {pad: "xl", bg: "bg", color: "fg"}
tile TaskDetailLoaded = match currentTask(route, tasks) with
  | Some(t) -> TaskDetailContent(t)
  | None -> NotFound
tile TaskDetailPage = if ready then TaskDetailLoaded else LoadingPage

tile ThemeButton = button(text=if themeName == "Light" then "Switch to Dark" else "Switch to Light")
tile SettingsPage = page(column(Header, heading("Settings"), text("Theme: " + themeName), ThemeButton) {gap: "lg"}) {pad: "xl", bg: "bg", color: "fg"}

app ProjectManagement
  caps = [storage.read, storage.write, nav.push]
  routes = {
    "/" -> ProjectsPage,
    "/projects/:id" -> ProjectPage,
    "/projects/:id/tasks/:taskId" -> TaskDetailPage,
    "/projects/:id/new-task" -> NewTaskPage,
    "/settings" -> SettingsPage,
    "/404" -> NotFound
  }
  init = []
  theme = themeName
