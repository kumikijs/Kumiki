type ProjectId = nominal Text where uuid
type TaskId = nominal Text where uuid
type CommentId = nominal Text where uuid
type Status = Backlog | InProgress | Review | Done
type Priority = Low | Med | High | Critical
type ViewMode = ListView | BoardView
type DueState = Overdue | Today | Soon | Upcoming | NoDue
type Project = {id: ProjectId, name: Text, description: Text, color: Text, archived: Bool, createdAt: Time}
type Task = {id: TaskId, projectId: ProjectId, title: Text, description: Text, status: Status, priority: Priority, assignee: Text, dueDate: Option(Time), tags: List(Text), parentTaskId: Option(TaskId), createdAt: Time, updatedAt: Time}
type Comment = {id: CommentId, taskId: TaskId, author: Text, body: Text, createdAt: Time}
type FilterState = {status: Option(Status), priority: Option(Priority), assignee: Text, search: Text}
type ProjectDraft = {name: Text, description: Text, color: Text}
type TaskDraft = {title: Text, description: Text, priority: Priority, assignee: Text, tags: Text, dueDate: Text}

slot projects : Map(ProjectId, Project) = {}
slot tasks : Map(TaskId, Task) = {}
slot comments : Map(CommentId, Comment) = {}
slot viewMode : ViewMode = ListView
slot filter : FilterState = {status: None, priority: None, assignee: "", search: ""}
slot themeName : Text = "Light"
slot draftProject : ProjectDraft = {name: "", description: "", color: "#6558d3"}
slot draftTask : TaskDraft = {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
slot commentDraft : Text = ""
slot commentAuthor : Text = ""
slot tagDraft : Text = ""
slot parentDraft : Option(TaskId) = None
slot ready : Bool = false
slot loadCount : Int = 0

theme Light = {colors: {bg: "#f7f8fc", fg: "#202436", muted: "#687085", primary: "#6558d3", surface: "#ffffff", border: "#e1e4ed", danger: "#c83250"}, spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"}, radius: {sm: "6px", md: "10px", lg: "16px"}, typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"}, weight: {normal: "400", bold: "700"}}}
theme Dark = {colors: {bg: "#171922", fg: "#f2f3f8", muted: "#a5abc0", primary: "#a99bff", surface: "#242735", border: "#3a3e50", danger: "#ff8296"}, spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"}, radius: {sm: "6px", md: "10px", lg: "16px"}, typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"}, weight: {normal: "400", bold: "700"}}}

effect saveProjects cap=storage.write in=Map(ProjectId, Project) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "projects", value: $1}
effect saveTasks cap=storage.write in=Map(TaskId, Task) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "tasks", value: $1}
effect saveComments cap=storage.write in=Map(CommentId, Comment) out=Result(Unit, Text) policy=debounce(300ms) map-request={key: "comments", value: $1}
effect loadProjects cap=storage.read in=Unit out=Result(Option(Map(ProjectId, Project)), Text) policy=once map-request={key: "projects", decode: Decoder.Json(Map(ProjectId, Project))}
effect loadTasks cap=storage.read in=Unit out=Result(Option(Map(TaskId, Task)), Text) policy=once map-request={key: "tasks", decode: Decoder.Json(Map(TaskId, Task))}
effect loadComments cap=storage.read in=Unit out=Result(Option(Map(CommentId, Comment)), Text) policy=once map-request={key: "comments", decode: Decoder.Json(Map(CommentId, Comment))}

fn tasksForProject(ts: Map(TaskId, Task), pid: ProjectId) -> List(TaskId) = ts.entries.filter($2.projectId == pid).sort-by($2.updatedAt).reverse.map($1)
fn subtasksFor(ts: Map(TaskId, Task), parent: TaskId) -> List(TaskId) = ts.entries.filter($2.parentTaskId == Some(parent)).sort-by($2.createdAt).map($1)
fn matchesFilter(t: Task, f: FilterState) -> Bool = (f.status == None || f.status == Some(t.status)) && (f.priority == None || f.priority == Some(t.priority)) && (f.assignee.is-empty || t.assignee.lower.contains(f.assignee.lower)) && (f.search.is-empty || t.title.lower.contains(f.search.lower) || t.description.lower.contains(f.search.lower) || t.tags.join(" ").lower.contains(f.search.lower))
fn filteredTasks(ts: Map(TaskId, Task), pid: ProjectId, f: FilterState) -> List(TaskId) = ts.entries.filter($2.projectId == pid && matchesFilter($2, f)).sort-by($2.updatedAt).reverse.map($1)
fn tasksByStatus(ts: Map(TaskId, Task), pid: ProjectId, f: FilterState, s: Status) -> List(TaskId) = ts.entries.filter($2.projectId == pid && $2.status == s && matchesFilter($2, f)).sort-by($2.updatedAt).reverse.map($1)
fn commentsForTask(cs: Map(CommentId, Comment), tid: TaskId) -> List(CommentId) = cs.entries.filter($2.taskId == tid).sort-by($2.createdAt).map($1)
fn statusLabel(s: Status) -> Text = match s with | Backlog -> "Backlog" | InProgress -> "In progress" | Review -> "Review" | Done -> "Done"
fn statusColor(s: Status) -> Text = match s with | Backlog -> "#687085" | InProgress -> "#476cde" | Review -> "#a56a13" | Done -> "#21805d"
fn priorityLabel(p: Priority) -> Text = match p with | Low -> "Low" | Med -> "Medium" | High -> "High" | Critical -> "Critical"
fn priorityColor(p: Priority) -> Text = match p with | Low -> "#687085" | Med -> "#476cde" | High -> "#b87516" | Critical -> "#c83250"
fn formatDate(t: Time) -> Text = t.format("yyyy-MM-dd")
fn dueDateStatus(due: Option(Time)) -> DueState = match due with | None -> NoDue | Some(d) -> if formatDate(d) == formatDate(now) then Today else if d < now then Overdue else if d.to-ms - now.to-ms < 604800000 then Soon else Upcoming
fn dueLabel(due: Option(Time)) -> Text = match due with | None -> "No due date" | Some(d) -> formatDate(d)
fn parseTags(value: Text) -> List(Text) = value.split(",").map($1.trim).filter(not $1.is-empty).unique
fn routeProjectId(r: Route) -> Option(ProjectId) = ProjectId.parse(r.params.get-or("id", ""))
fn routeTaskId(r: Route) -> Option(TaskId) = TaskId.parse(r.params.get-or("taskId", ""))
fn currentProject(r: Route, ps: Map(ProjectId, Project)) -> Option(Project) = match routeProjectId(r) with | None -> None | Some(id) -> ps.get(id)
fn projectPath(id: ProjectId) -> Text = "/projects/" + id.show
fn taskPath(pid: ProjectId, tid: TaskId) -> Text = projectPath(pid) + "/tasks/" + tid.show
fn nextStatus(s: Status) -> Status = match s with | Backlog -> InProgress | InProgress -> Review | Review -> Done | Done -> Backlog
fn statusOptions() = [{label: "Backlog", value: Backlog}, {label: "In progress", value: InProgress}, {label: "Review", value: Review}, {label: "Done", value: Done}]
fn priorityOptions() = [{label: "Low", value: Low}, {label: "Medium", value: Med}, {label: "High", value: High}, {label: "Critical", value: Critical}]

reducer loadAll on=app.start do=
    emit loadProjects()
    emit loadTasks()
    emit loadComments()
reducer projectsLoaded on=loadProjects.ok($value, _) do=
    projects := $value.get-or({})
    loadCount := loadCount + 1
    ready := loadCount == 3
reducer projectsLoadFailed on=loadProjects.err($error, _) do=
    loadCount := loadCount + 1
    ready := loadCount == 3
reducer tasksLoaded on=loadTasks.ok($value, _) do=
    tasks := $value.get-or({})
    loadCount := loadCount + 1
    ready := loadCount == 3
reducer tasksLoadFailed on=loadTasks.err($error, _) do=
    loadCount := loadCount + 1
    ready := loadCount == 3
reducer commentsLoaded on=loadComments.ok($value, _) do=
    comments := $value.get-or({})
    loadCount := loadCount + 1
    ready := loadCount == 3
reducer commentsLoadFailed on=loadComments.err($error, _) do=
    loadCount := loadCount + 1
    ready := loadCount == 3

reducer createProject on=ui.submit(ProjectForm) do=
    if ready && not draftProject.name.trim.is-empty then {
        let id = ProjectId.fresh()
        projects[id] := {id: id, name: draftProject.name.trim, description: draftProject.description, color: draftProject.color, archived: false, createdAt: now}
        draftProject := {name: "", description: "", color: "#6558d3"}
        emit saveProjects(projects)
        emit navigate({path: "/projects/{id}", params: {"id": id.show}})
    }
reducer archiveProject on=ui.click(ArchiveProjectButton) do=
    projects[$el.projectId].archived := true
    emit saveProjects(projects)
reducer unarchiveProject on=ui.click(UnarchiveProjectButton) do=
    projects[$el.projectId].archived := false
    emit saveProjects(projects)
reducer deleteProject on=ui.click(DeleteProjectButton) do=
    let id = $el.projectId
    let removed = tasks.filter($2.projectId == id).keys
    comments := comments.filter(not removed.contains($2.taskId))
    tasks := tasks.filter($2.projectId != id)
    projects := projects.remove(id)
    emit saveProjects(projects)
    emit saveTasks(tasks)
    emit saveComments(comments)

reducer createTask on=ui.submit(NewTaskForm) do=
    match routeProjectId(route) with
    | Some(pid) -> {
        if ready && projects.has(pid) && not draftTask.title.trim.is-empty then {
            let id = TaskId.fresh()
            tasks[id] := {id: id, projectId: pid, title: draftTask.title.trim, description: draftTask.description, status: Backlog, priority: draftTask.priority, assignee: draftTask.assignee, dueDate: Time.parse(draftTask.dueDate), tags: parseTags(draftTask.tags), parentTaskId: parentDraft, createdAt: now, updatedAt: now}
            draftTask := {title: "", description: "", priority: Med, assignee: "", tags: "", dueDate: ""}
            parentDraft := None
            emit saveTasks(tasks)
            emit navigate({path: "/projects/{id}/tasks/{taskId}", params: {"id": pid.show, "taskId": id.show}})
        }
    }
    | None -> ()
reducer updateTaskStatus on=ui.change(TaskStatusInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].status := $event.value; tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer updateTaskPriority on=ui.change(TaskPriorityInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].priority := $event.value; tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer updateTaskAssignee on=ui.input(TaskAssigneeInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].assignee := $event.value; tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer updateTaskDueDate on=ui.change(TaskDueInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].dueDate := Time.parse($event.value); tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer updateTaskTitle on=ui.input(TaskTitleInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].title := $event.value; tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer updateTaskDescription on=ui.input(TaskDescriptionInput) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].description := $event.value; tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer addTaskTag on=ui.submit(TagForm) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].tags := tasks[id].tags.concat(parseTags(tagDraft)).unique; tasks[id].updatedAt := now; tagDraft := ""; emit saveTasks(tasks) } | None -> ()
reducer removeTaskTag on=ui.click(RemoveTagButton) do=
    match routeTaskId(route) with | Some(id) -> { tasks[id].tags := tasks[id].tags.filter($1 != $el.tag); tasks[id].updatedAt := now; emit saveTasks(tasks) } | None -> ()
reducer deleteTask on=ui.click(DeleteTaskButton) do=
    match (routeProjectId(route), routeTaskId(route)) with
    | (Some(pid), Some(id)) -> {
        comments := comments.filter($2.taskId != id)
        tasks := tasks.map(if $2.parentTaskId == Some(id) then {id: $2.id, projectId: $2.projectId, title: $2.title, description: $2.description, status: $2.status, priority: $2.priority, assignee: $2.assignee, dueDate: $2.dueDate, tags: $2.tags, parentTaskId: None, createdAt: $2.createdAt, updatedAt: $2.updatedAt} else $2)
        tasks := tasks.remove(id)
        emit saveTasks(tasks)
        emit saveComments(comments)
        emit navigate({path: "/projects/{id}", params: {"id": pid.show}})
    }
    | _ -> ()
reducer moveTaskStatus on=ui.click(MoveTaskButton) do=
    tasks[$el.taskId].status := nextStatus(tasks[$el.taskId].status)
    tasks[$el.taskId].updatedAt := now
    emit saveTasks(tasks)
reducer prepareSubtask on=ui.click(AddSubtaskButton) do=
    match (routeProjectId(route), routeTaskId(route)) with
    | (Some(pid), Some(id)) -> { parentDraft := Some(id); emit navigate({path: "/projects/{id}/new-task", params: {"id": pid.show}}) }
    | _ -> ()
reducer prepareTask on=ui.click(AddTaskButton) do=
    parentDraft := None
    match routeProjectId(route) with | Some(pid) -> emit navigate({path: "/projects/{id}/new-task", params: {"id": pid.show}}) | None -> ()

reducer addComment on=ui.submit(CommentForm) do=
    match routeTaskId(route) with
    | Some(id) -> {
        if not commentDraft.trim.is-empty then {
            let cid = CommentId.fresh()
            comments[cid] := {id: cid, taskId: id, author: if commentAuthor.trim.is-empty then "You" else commentAuthor.trim, body: commentDraft.trim, createdAt: now}
            commentDraft := ""
            emit saveComments(comments)
        }
    }
    | None -> ()
reducer deleteComment on=ui.click(DeleteCommentButton) do=
    comments := comments.remove($el.commentId)
    emit saveComments(comments)
reducer setFilterStatus on=ui.change(FilterStatusInput) do= filter.status := $event.value
reducer setFilterPriority on=ui.change(FilterPriorityInput) do= filter.priority := $event.value
reducer setFilterAssignee on=ui.input(FilterAssigneeInput) do= filter.assignee := $event.value
reducer setSearch on=ui.input(SearchInput) do= filter.search := $event.value
reducer clearFilter on=ui.click(ClearFilterButton) do= filter := {status: None, priority: None, assignee: "", search: ""}
reducer setListView on=ui.click(ListViewButton) do= viewMode := ListView
reducer setViewMode on=ui.click(BoardViewButton) do= viewMode := BoardView
reducer toggleTheme on=ui.click(ThemeButton) do= themeName := if themeName == "Light" then "Dark" else "Light"

tile Navigation = row(link("Projects", to="/"), link("Settings", to="/settings")) {gap: "lg", pad: "md"}
tile ProjectForm = form(column(heading("Create a project") {level: 2}, input(bind=draftProject.name, placeholder="Project name", required=true), textarea(bind=draftProject.description, placeholder="Description"), input(bind=draftProject.color, type="color"), button(text="Create project", type="submit", disabled=not ready)) {gap: "sm"})
tile ArchiveProjectButton in=ProjectId = button(text="Archive") {projectId: $1}
tile UnarchiveProjectButton in=ProjectId = button(text="Unarchive") {projectId: $1}
tile DeleteProjectButton in=ProjectId = button(text="Delete") {projectId: $1}
tile ProjectCard in=ProjectId = card(column(
    link(projects[$1].name, to=projectPath($1)),
    text(projects[$1].description),
    text(tasks.filter($2.projectId == $1 && $2.status != Done).size.show + " active tasks"),
    row(when(not projects[$1].archived, ArchiveProjectButton($1)), when(projects[$1].archived, UnarchiveProjectButton($1)), DeleteProjectButton($1)) {gap: "sm"}
) {gap: "sm", pad: "md"}) {bg: "surface", radius: "md"}
tile ProjectsPage = page(Navigation, column(
    heading("Projects"), text("Organize your team's work in one place.") {color: "muted"},
    when(not ready, text("Loading projects…")),
    when(ready, ProjectForm),
    when(ready && projects.is-empty, text("No projects yet. Create your first project.")),
    grid(for id in projects.keys ProjectCard(id) {key: id}) {cols: 3, gap: "md"}
) {gap: "lg", pad: "lg"})

tile ListViewButton = button(text="List")
tile BoardViewButton = button(text="Board")
tile AddTaskButton = button(text="New task")
tile FilterStatusInput = select(value=filter.status, options=[{label: "All statuses", value: None}, {label: "Backlog", value: Some(Backlog)}, {label: "In progress", value: Some(InProgress)}, {label: "Review", value: Some(Review)}, {label: "Done", value: Some(Done)}])
tile FilterPriorityInput = select(value=filter.priority, options=[{label: "All priorities", value: None}, {label: "Low", value: Some(Low)}, {label: "Medium", value: Some(Med)}, {label: "High", value: Some(High)}, {label: "Critical", value: Some(Critical)}])
tile FilterAssigneeInput = input(value=filter.assignee, placeholder="Assignee")
tile SearchInput = input(value=filter.search, placeholder="Search tasks")
tile ClearFilterButton = button(text="Clear filters")
tile FilterBar = row(SearchInput, FilterStatusInput, FilterPriorityInput, FilterAssigneeInput, ClearFilterButton) {gap: "sm"}
tile MoveTaskButton in=TaskId = button(text="Next status") {taskId: $1}
tile TaskCard in=TaskId = card(column(
    link(tasks[$1].title, to=taskPath(tasks[$1].projectId, $1)),
    row(text(statusLabel(tasks[$1].status)) {color: statusColor(tasks[$1].status)}, text(priorityLabel(tasks[$1].priority)) {color: priorityColor(tasks[$1].priority)}) {gap: "md"},
    text("Assignee: " + tasks[$1].assignee), text("Due: " + dueLabel(tasks[$1].dueDate)),
    row(for tag in tasks[$1].tags text(tag) {key: tag}) {gap: "sm"},
    when(viewMode == BoardView, MoveTaskButton($1))
) {gap: "sm", pad: "md"}) {bg: "surface", radius: "md"}
tile TaskList in=ProjectId = column(for id in filteredTasks(tasks, $1, filter) TaskCard(id) {key: id}) {gap: "md"}
type BoardColumnInput = {projectId: ProjectId, status: Status}
tile BoardColumn in=BoardColumnInput = column(
    heading(statusLabel($1.status)) {level: 2},
    text(tasksByStatus(tasks, $1.projectId, filter, $1.status).length.show + " tasks") {color: "muted"},
    for id in tasksByStatus(tasks, $1.projectId, filter, $1.status) TaskCard(id) {key: id}
) {gap: "sm", pad: "sm"}
tile TaskBoard in=ProjectId = grid(
    BoardColumn({projectId: $1, status: Backlog}), BoardColumn({projectId: $1, status: InProgress}),
    BoardColumn({projectId: $1, status: Review}), BoardColumn({projectId: $1, status: Done})
) {cols: 4, gap: "md"}
tile ProjectContent in=Project = column(
    row(column(heading($1.name), text($1.description) {color: "muted"}), AddTaskButton) {gap: "lg"},
    row(ListViewButton, BoardViewButton) {gap: "sm"}, FilterBar,
    if viewMode == ListView then TaskList($1.id) else TaskBoard($1.id)
) {gap: "lg", pad: "lg"}
tile ProjectPage = page(Navigation, when(not ready, text("Loading…")), when(ready, match currentProject(route, projects) with | Some(project) -> ProjectContent(project) | None -> NotFound))

tile NewTaskForm = form(column(
    label("Title"), input(bind=draftTask.title, required=true, placeholder="What needs to be done?"),
    label("Description"), textarea(bind=draftTask.description, rows=4),
    label("Priority"), select(bind=draftTask.priority, options=priorityOptions()),
    label("Assignee"), input(bind=draftTask.assignee),
    label("Tags, separated by commas"), input(bind=draftTask.tags),
    label("Due date"), input(bind=draftTask.dueDate, type="date"),
    button(text="Create task", type="submit", disabled=not ready)
) {gap: "sm"})
tile NewTaskContent in=Project = column(link("Back to project", to=projectPath($1.id)), heading(if parentDraft.is-some then "New subtask" else "New task"), text($1.name) {color: "muted"}, NewTaskForm) {gap: "md", pad: "lg"}
tile NewTaskPage = page(Navigation, when(not ready, text("Loading…")), when(ready, match currentProject(route, projects) with | Some(project) -> NewTaskContent(project) | None -> NotFound))

tile TaskTitleInput in=TaskId = input(value=tasks[$1].title)
tile TaskDescriptionInput in=TaskId = textarea(value=tasks[$1].description, rows=5)
tile TaskStatusInput in=TaskId = select(value=tasks[$1].status, options=statusOptions())
tile TaskPriorityInput in=TaskId = select(value=tasks[$1].priority, options=priorityOptions())
tile TaskAssigneeInput in=TaskId = input(value=tasks[$1].assignee, placeholder="Unassigned")
tile TaskDueInput in=TaskId = input(value=dueLabel(tasks[$1].dueDate), type="date")
tile RemoveTagButton in=Text = button(text="Remove " + $1) {tag: $1}
tile TagForm = form(row(input(bind=tagDraft, placeholder="Add tags"), button(text="Add", type="submit")) {gap: "sm"})
tile DeleteTaskButton = button(text="Delete task")
tile AddSubtaskButton = button(text="Add subtask")
tile DeleteCommentButton in=CommentId = button(text="Delete") {commentId: $1}
tile CommentCard in=CommentId = card(column(row(text(comments[$1].author) {bold: true}, text(formatDate(comments[$1].createdAt)) {color: "muted"}), text(comments[$1].body), DeleteCommentButton($1)) {gap: "sm", pad: "md"}) {bg: "surface"}
tile CommentForm = form(column(input(bind=commentAuthor, placeholder="Your name"), textarea(bind=commentDraft, placeholder="Write a comment", rows=3), button(text="Post comment", type="submit")) {gap: "sm"})
tile TaskDetailContent in=TaskId = column(
    link("Back to project", to=projectPath(tasks[$1].projectId)),
    label("Title"), TaskTitleInput($1), label("Description"), TaskDescriptionInput($1),
    row(column(label("Status"), TaskStatusInput($1)), column(label("Priority"), TaskPriorityInput($1)), column(label("Assignee"), TaskAssigneeInput($1)), column(label("Due date"), TaskDueInput($1))) {gap: "md"},
    heading("Tags") {level: 2}, row(for tag in tasks[$1].tags RemoveTagButton(tag) {key: tag}) {gap: "sm"}, TagForm,
    row(heading("Subtasks") {level: 2}, AddSubtaskButton) {gap: "md"},
    column(for id in subtasksFor(tasks, $1) TaskCard(id) {key: id}) {gap: "sm"},
    heading("Comments") {level: 2}, column(for id in commentsForTask(comments, $1) CommentCard(id) {key: id}) {gap: "sm"}, CommentForm,
    DeleteTaskButton
) {gap: "md", pad: "lg"}
tile TaskDetailPage = page(Navigation, when(not ready, text("Loading…")), when(ready, match routeTaskId(route) with | Some(id) -> when(tasks.has(id) && tasks[id].projectId.show == route.params.get-or("id", ""), TaskDetailContent(id)) | None -> NotFound))
tile ThemeButton = button(text="Switch theme")
tile SettingsPage = page(Navigation, column(heading("Settings"), text("Appearance"), text("Current theme: " + themeName), ThemeButton) {gap: "md", pad: "lg"})
tile NotFound = column(heading("Page not found"), link("Back to projects", to="/")) {gap: "md", pad: "lg"}

app ProjectManager
    caps = [storage.read, storage.write, nav.push]
    routes = {"/" -> ProjectsPage, "/projects/:id" -> ProjectPage, "/projects/:id/tasks/:taskId" -> TaskDetailPage, "/projects/:id/new-task" -> NewTaskPage, "/settings" -> SettingsPage, "/404" -> NotFound}
    init = []
    theme = themeName
