type NoteId = nominal Text
type Note = {id: NoteId, title: Text, body: Text}
type SyncState = Saved | Saving | Failed(Text)
type LoadState = Loading | Loaded | LoadFailed(Text)
type CreateInput = {tempId: NoteId, title: Text, body: Text}
type DeletedNote = {note: Note, state: SyncState}

slot notes : Map(NoteId, Note) = {}
slot sync : Map(NoteId, SyncState) = {}
slot load : LoadState = Loading
slot session : Text = "demo-token"
slot signedOut : Bool = false
slot draftTitle : Text = ""
slot banner : Option(Text) = None

# A create may still be in flight while its temporary note is edited or deleted.
slot pendingCreates : Map(NoteId, Bool) = {}
slot deletedDrafts : Map(NoteId, Note) = {}
slot pendingDeletes : Map(NoteId, DeletedNote) = {}

effect loadNotes cap=http.get
    in=Unit
    out=Result(List(Note), HttpError)
    policy=latest
    retry=exponential(3, 200ms, 2.0)
    map-request={url: "/notes", headers: {}, query: {}, decode: Decoder.Json(List(Note))}

effect createNote cap=http.post
    in=CreateInput
    out=Result(Note, HttpError)
    policy=latest-per-key($1.tempId)
    map-request={url: "/notes", headers: {}, query: {},
                 body: Json({title: $1.title, body: $1.body}), decode: Decoder.Json(Note)}

effect updateNote cap=http.put
    in=Note
    out=Result(Note, HttpError)
    policy=latest-per-key($1.id)
    map-request={url: "/notes/" + $1.id.show, headers: {}, query: {},
                 body: Json($1), decode: Decoder.Json(Note)}

effect deleteNote cap=http.delete
    in=NoteId
    out=Result(Unit, HttpError)
    policy=latest-per-key($1)
    map-request={url: "/notes/" + $1.show, headers: {}, query: {},
                 body: Empty, decode: Decoder.None}

reducer unauthorized
    on=app.http-401
    do= signedOut := true

reducer loadSucceeded
    on=loadNotes.ok($items, _)
    do= if !signedOut then {
            notes := {}
            sync := {}
            for item in $items {
                notes[item.id] := item
                sync[item.id] := Saved
            }
            load := Loaded
        }

reducer loadFailed
    on=loadNotes.err($error, _)
    do= if $error.status == 401 then {
            signedOut := true
        } else if $error.message != "aborted" && !signedOut then {
            load := LoadFailed($error.message)
            banner := Some($error.message)
        }

reducer retryLoad
    on=ui.click(LoadRetry)
    do= load := Loading
        banner := None
        emit loadNotes()

reducer signInAgain
    on=ui.click(SignInAgain)
    do= signedOut := false
        load := Loading
        notes := {}
        sync := {}
        pendingCreates := {}
        deletedDrafts := {}
        pendingDeletes := {}
        banner := None
        emit loadNotes()

reducer addNote
    on=ui.click(AddButton)
    do= if !draftTitle.trim.is-empty then {
            let id = NoteId.fresh()
            let title = draftTitle.trim
            notes[id] := {id: id, title: title, body: ""}
            sync[id] := Saving
            pendingCreates[id] := true
            draftTitle := ""
            banner := None
            emit createNote({tempId: id, title: title, body: ""})
        }

reducer createSucceeded
    on=createNote.ok($created, $temp)
    do= if pendingCreates.has($temp) && !signedOut then {
            pendingCreates := pendingCreates.remove($temp)
            if notes.has($temp) then {
                let current = notes[$temp]
                let replacement = {id: $created.id, title: current.title, body: current.body}
                notes := notes.remove($temp).insert($created.id, replacement)
                if current.body == $created.body && current.title == $created.title then {
                    sync := sync.remove($temp).insert($created.id, Saved)
                } else {
                    sync := sync.remove($temp).insert($created.id, Saving)
                    emit updateNote(replacement)
                }
            } else if deletedDrafts.has($temp) then {
                let draft = deletedDrafts[$temp]
                let replacement = {id: $created.id, title: draft.title, body: draft.body}
                deletedDrafts := deletedDrafts.remove($temp)
                pendingDeletes[$created.id] := {note: replacement, state: Failed("Save needed")}
                emit deleteNote($created.id)
            }
        }

reducer createFailed
    on=createNote.err($error, $temp)
    do= if $error.status == 401 then {
            signedOut := true
        } else if pendingCreates.has($temp) && !signedOut then {
            pendingCreates := pendingCreates.remove($temp)
            deletedDrafts := deletedDrafts.remove($temp)
            notes := notes.remove($temp)
            sync := sync.remove($temp)
            banner := Some("Could not add note")
        }

reducer editBody
    on=ui.input(NoteBody)
    do= if notes.has($el.noteId) then {
            notes[$el.noteId].body := $event.value
            sync[$el.noteId] := Saving
            if !pendingCreates.has($el.noteId) then {
                emit updateNote(notes[$el.noteId])
            }
        }

reducer updateSucceeded
    on=updateNote.ok($saved, $id)
    do= if !signedOut && notes.has($id) then {
            sync[$id] := Saved
        }

reducer updateFailed
    on=updateNote.err($error, $id)
    do= if $error.status == 401 then {
            signedOut := true
        } else if $error.message != "aborted" && !signedOut && notes.has($id) then {
            sync[$id] := Failed($error.message)
            banner := Some($error.message)
        }

reducer retrySave
    on=ui.click(SaveRetry)
    do= if notes.has($el.noteId) && !pendingCreates.has($el.noteId) then {
            sync[$el.noteId] := Saving
            emit updateNote(notes[$el.noteId])
        }

reducer removeNote
    on=ui.click(DeleteButton)
    do= if notes.has($el.noteId) then {
            let id = $el.noteId
            let removed = notes[id]
            let oldState = sync.get-or(id, Saved)
            if pendingCreates.has(id) then {
                deletedDrafts[id] := removed
            } else {
                pendingDeletes[id] := {note: removed, state: oldState}
                emit deleteNote(id)
            }
            notes := notes.remove(id)
            sync := sync.remove(id)
            banner := None
        }

reducer deleteSucceeded
    on=deleteNote.ok(_, $id)
    do= pendingDeletes := pendingDeletes.remove($id)

reducer deleteFailed
    on=deleteNote.err($error, $id)
    do= if $error.status == 401 then {
            signedOut := true
        } else if pendingDeletes.has($id) && !signedOut then {
            let removed = pendingDeletes[$id]
            notes[$id] := removed.note
            sync[$id] := match removed.state with
                | Saving -> Failed("Save needed")
                | Saved -> Saved
                | Failed(message) -> Failed(message)
            pendingDeletes := pendingDeletes.remove($id)
            banner := Some("Could not delete note")
        }

tile LoadRetry = button(text="Retry")
tile SignInAgain = button(text="Sign in again")
tile AddButton = button(text="Add note")
tile DeleteButton in=NoteId = button(text="Delete note") {noteId: $1}
tile SaveRetry in=NoteId = button(text="Retry save") {noteId: $1}
tile NoteBody in=NoteId = textarea(value=notes[$1].body, id="body-" + $1.show) {noteId: $1}

tile NoteStatus in=NoteId = match sync.get-or($1, Saved) with
    | Saved -> text("Saved")
    | Saving -> text("Saving")
    | Failed(message) -> row(text("Save failed"), SaveRetry($1))

tile NoteRow in=NoteId = card(
    heading(notes[$1].title, level=2),
    NoteBody($1),
    NoteStatus($1),
    DeleteButton($1))

tile LoadedNotes = column(
    row(input(bind=draftTitle, id="new-title", placeholder="Note title"), AddButton),
    for id in notes.keys NoteRow(id) {key: id.show})

tile LoadingView = column(text("Loading notes"))
tile LoadFailureView = column(text("Could not load notes"), LoadRetry)
tile NotesContent = match load with
    | Loading -> LoadingView
    | Loaded -> LoadedNotes
    | LoadFailed(message) -> LoadFailureView

tile SignedOutView = page(text("Session expired"), SignInAgain)
tile NotesPage = page(
    heading("Notes (" + notes.size.show + ")"),
    when(banner.is-some, text(banner.get)),
    NotesContent)
tile Home = if signedOut then SignedOutView else NotesPage

app SyncedNotes
    caps=[http.get, http.post, http.put, http.delete]
    routes={"/" -> Home}
    init=[loadNotes()]
    http={base-url: "https://api.example.com",
          headers: {"Authorization": "Bearer " + session},
          on-401: unauthorized}
