{
  "effects": {
    "loadNotes": [
      {
        "outcome": "ok",
        "value": [
          {
            "id": "n1",
            "title": "Groceries",
            "body": "milk"
          }
        ]
      }
    ],
    "updateNote": [
      {
        "outcome": "err",
        "value": {
          "status": 500,
          "message": "Internal Server Error",
          "body": {
            "_tag": "Some",
            "_0": ""
          }
        }
      },
      {
        "outcome": "ok",
        "value": {
          "id": "n1",
          "title": "Groceries",
          "body": "milk, eggs"
        }
      }
    ]
  },
  "defaultEffect": {
    "outcome": "ok",
    "value": null
  },
  "steps": [
    {
      "label": "a refused save marks the note failed and offers a retry",
      "do": {
        "fill": "#body-n1",
        "value": "milk, eggs"
      },
      "expect": {
        "domIncludes": ["Save failed", "Retry save"]
      }
    },
    {
      "label": "Retry save saves it",
      "do": {
        "clickText": "Retry save"
      },
      "expect": {
        "domIncludes": ["Saved"],
        "domExcludes": ["Save failed"]
      }
    }
  ]
}
