type Mode    = Work | Break
type Seconds = Int where between(0, 1500)

slot remaining : Seconds = 1500
slot mode      : Mode    = Work
slot running   : Bool    = false

fn duration(m: Mode) -> Int
   = match m with
       | Work  -> 1500
       | Break -> 300

fn nextMode(m: Mode) -> Mode
   = match m with
       | Work  -> Break
       | Break -> Work

fn modeLabel(m: Mode) -> Text
   = match m with
       | Work  -> "Work"
       | Break -> "Break"

fn pad2(n: Int) -> Text = if n < 10 then "0" + n.show else n.show

fn formatTime(s: Int) -> Text = pad2((s / 60).floor) + ":" + pad2(s % 60)

reducer tick
    on=timer(1s)
    do= if running && (remaining <= 1) then {
          let next = nextMode(mode)
          mode := next
          remaining := duration(next)
        } else if running then remaining := remaining - 1

reducer start
    on=ui.click(StartBtn)
    do= running := true

reducer pause
    on=ui.click(PauseBtn)
    do= running := false

reducer reset
    on=ui.click(ResetBtn)
    do= remaining := duration(mode)
        running := false

tile StartBtn = button(text="Start", disabled=running)
tile PauseBtn = button(text="Pause", disabled=!running)
tile ResetBtn = button(text="Reset")

tile App = page(
             column(
               heading(modeLabel(mode)),
               text(formatTime(remaining)),
               text(remaining.show + " sec"),
               row(StartBtn, PauseBtn, ResetBtn) {gap: "sm"}) {gap: "md"})

app Pomodoro
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
