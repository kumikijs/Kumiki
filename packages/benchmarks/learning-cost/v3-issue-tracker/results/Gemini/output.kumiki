        muted:   "#a1a1aa",
        primary: "#3b82f6",
        success: "#22c55e",
        warning: "#f59e0b",
        danger:  "#ef4444",
        surface: "#18181b",
        border:  "#27272a"
    },
    spacing: {
        xs: "4px",
        sm: "8px",
        md: "16px",
        lg: "24px",
        xl: "40px"
    },
    radius: {
        none: "0",
        sm:   "4px",
        md:   "8px",
        lg:   "12px",
        pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {
            xs: "12px",
            sm: "14px",
            md: "16px",
            lg: "20px",
            xl: "28px"
        },
        weight: {
            normal: "400",
            medium: "500",
            bold:   "700"
        },
