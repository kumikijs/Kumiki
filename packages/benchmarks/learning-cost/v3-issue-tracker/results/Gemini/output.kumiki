# Issue Tracker SPA in Kumiki

# ==============================================================================
# Types
# ==============================================================================

type IssueId = nominal Text where uuid

type Status = Open | InProgress | Done

type Priority = Low | Med | High

type Issue = {
    id: IssueId,
    title: Text,
    body: Text,
    status: Status,
    priority: Priority,
    assignee: Text,
    tags: List(Text),
    createdAt: Time,
    updatedAt: Time
}

type Comment = {
    id: Text,
    issueId: IssueId,
    author: Text,
    body: Text,
    createdAt: Time
}

type FilterState = {
    status: Option(Status),
    priority: Option(Priority),
    search: Text
}

type DraftIssue = {
    title: Text,
    body: Text,
    priority: Priority,
    assignee: Text,
    tags: Text
}

type StatusOpt         = {label: Text, value: Status}
type PriorityOpt       = {label: Text, value: Priority}
type StatusFilterOpt   = {label: Text, value: Option(Status)}
type PriorityFilterOpt = {label: Text, value: Option(Priority)}

# ==============================================================================
# Slots
# ==============================================================================

slot issues       : Map(IssueId, Issue) = {}
slot comments     : Map(Text, Comment)  = {}
slot filter       : FilterState         = {status: None, priority: None, search: ""}
slot currentUser  : Text                = "me"
slot draft        : DraftIssue          = {title: "", body: "", priority: Med, assignee: "", tags: ""}
slot commentDraft : Text                = ""
slot tagDraft     : Text                = ""
slot themeName    : Text                = "Light"
slot storageError : Option(Text) transient = None

