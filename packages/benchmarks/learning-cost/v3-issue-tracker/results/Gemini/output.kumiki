# ==============================================================================
# Pure Functions
# ==============================================================================

fn statusLabel(s: Status) -> Text
   = match s with
       | Open       -> "Open"
       | InProgress -> "In Progress"
       | Done       -> "Done"

fn statusColor(s: Status) -> Text
   = match s with
       | Open       -> "success"
       | InProgress -> "warning"
       | Done       -> "muted"

fn priorityLabel(p: Priority) -> Text
   = match p with
       | Low  -> "Low"
       | Med  -> "Med"
       | High -> "High"

fn priorityColor(p: Priority) -> Text
   = match p with
       | Low  -> "muted"
       | Med  -> "warning"
       | High -> "danger"

fn statusOptions() -> List(StatusOpt)
   = [
       {label: "Open",        value: Open},
       {label: "In Progress", value: InProgress},
       {label: "Done",        value: Done}
     ]

fn priorityOptions() -> List(PriorityOpt)
   = [
       {label: "Low",  value: Low},
       {label: "Med",  value: Med},
       {label: "High", value: High}
     ]

fn statusFilterOptions() -> List(StatusFilterOpt)
   = [
       {label: "All",         value: None},
       {label: "Open",        value: Some(Open)},
       {label: "In Progress", value: Some(InProgress)},
       {label: "Done",        value: Some(Done)}
     ]

fn priorityFilterOptions() -> List(PriorityFilterOpt)
   = [
       {label: "All",  value: None},
       {label: "Low",  value: Some(Low)},
       {label: "Med",  value: Some(Med)},
       {label: "High", value: Some(High)}
     ]

fn matchesFilter(issue: Issue, f: FilterState) -> Bool
   = let statusOk = (match f.status with
                       | Some(st) -> issue.status == st
                       | None     -> true)
     in let priorityOk = (match f.priority with
                            | Some(pr) -> issue.priority == pr
                            | None     -> true)
     in let q = f.search.trim.lower
     in let searchOk = if q.is-empty then true else issue.title.lower.contains(q)
     in statusOk && priorityOk && searchOk

fn filteredIssues(allIssues: Map(IssueId, Issue), f: FilterState) -> List(IssueId)
   = allIssues.entries
              .filter(matchesFilter($2, f))
              .sort-by($2.updatedAt)
              .reverse
              .map($1)

fn commentsForIssue(allComments: Map(Text, Comment), targetId: IssueId) -> List(Text)
   = allComments.entries
                .filter($2.issueId == targetId)
                .sort-by($2.createdAt)
                .map($1)

fn countByStatus(allIssues: Map(IssueId, Issue), st: Status) -> Int
   = allIssues.filter($2.status == st).size

fn trimTextList(xs: List(Text)) -> List(Text)
   = xs.map($1.trim)

fn parseTags(raw: Text) -> List(Text)
   = if raw.trim.is-empty
     then []
     else trimTextList(raw.split(",")).filter(!$1.is-empty).unique

fn addTagToList(tags: List(Text), raw: Text) -> List(Text)
   = let cleaned = raw.trim
     in if cleaned.is-empty || tags.contains(cleaned)
        then tags
        else tags.push(cleaned)

fn removeTagFromList(tags: List(Text), target: Text) -> List(Text)
   = tags.filter($1 != target)

fn routeIssueId(r: Route) -> Option(IssueId)
   = match r.params.get("id") with
       | Some(raw) -> IssueId.parse(raw)
       | None      -> None

fn formatTime(t: Time) -> Text
   = t.format("yyyy-MM-dd HH:mm")

# ==============================================================================
# Effects (Persistence)
# ==============================================================================

effect saveIssues
    cap=storage.write
    in=Map(IssueId, Issue)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kumiki-issues", value: $1}

effect saveComments
    cap=storage.write
    in=Map(Text, Comment)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "kumiki-comments", value: $1}

effect loadIssues
    cap=storage.read
    in=Unit
    out=Result(Option(Map(IssueId, Issue)), Text)
    policy=once
    map-request={key: "kumiki-issues", decode: Decoder.Json(Map(IssueId, Issue))}

effect loadComments
    cap=storage.read
    in=Unit
    out=Result(Option(Map(Text, Comment)), Text)
    policy=once
    map-request={key: "kumiki-comments", decode: Decoder.Json(Map(Text, Comment))}

# ==============================================================================
# Reducers
# ==============================================================================

reducer loadFromStorage
    on=app.start
    do= emit loadIssues()
        emit loadComments()

reducer issuesLoaded
    on=loadIssues.ok($maybeIssues, _)
    do= issues := $maybeIssues.get-or(issues)
        storageError := None

reducer commentsLoaded
    on=loadComments.ok($maybeComments, _)
    do= comments := $maybeComments.get-or(comments)
        storageError := None

reducer onLoadIssuesErr
    on=loadIssues.err($e, _)
    do= storageError := Some($e)

reducer onLoadCommentsErr
    on=loadComments.err($e, _)
    do= storageError := Some($e)

reducer onSaveIssuesOk
    on=saveIssues.ok(_, _)
    do= storageError := None

reducer onSaveCommentsOk
    on=saveComments.ok(_, _)
    do= storageError := None

reducer onSaveIssuesErr
    on=saveIssues.err($e, _)
    do= storageError := Some($e)

reducer onSaveCommentsErr
    on=saveComments.err($e, _)
    do= storageError := Some($e)

reducer goNewIssue
    on=ui.click(NewIssueBtn)
    do= emit navigate({path: "/new", params: {}, query: {}})

reducer goBackToList
    on=ui.click(BackToListBtn)
    do= emit navigate({path: "/", params: {}, query: {}})

reducer setFilterStatus
    on=ui.change(FilterStatusSelect)
    do= filter.status := $event.value

reducer setFilterPriority
    on=ui.change(FilterPrioritySelect)
    do= filter.priority := $event.value

reducer setSearch
    on=ui.input(FilterSearchInput)
    do= filter.search := $event.value

reducer clearFilter
    on=ui.click(ClearFilterBtn)
    do= filter := {status: None, priority: None, search: ""}

reducer createIssue
    on=ui.submit(NewIssueForm)
    do= let title = draft.title.trim
        if !title.is-empty then {
          let newId = IssueId.fresh()
          let ts = now
          issues[newId] := {
            id: newId,
            title: title,
            body: draft.body,
            status: Open,
            priority: draft.priority,
            assignee: draft.assignee.trim,
            tags: parseTags(draft.tags),
            createdAt: ts,
            updatedAt: ts
          }
          draft := {title: "", body: "", priority: Med, assignee: "", tags: ""}
          emit saveIssues(issues)
          emit navigate({path: "/issues/" + newId.show, params: {}, query: {}})
        }

reducer cancelNewIssue
    on=ui.click(CancelNewBtn)
    do= draft := {title: "", body: "", priority: Med, assignee: "", tags: ""}
        emit navigate({path: "/", params: {}, query: {}})

reducer updateStatus
    on=ui.change(DetailStatusSelect)
    do= let maybeId = routeIssueId(route)
        if maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            issues[iid].status := $event.value
            issues[iid].updatedAt := now
            emit saveIssues(issues)
          }
        }

reducer updatePriority
    on=ui.change(DetailPrioritySelect)
    do= let maybeId = routeIssueId(route)
        if maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            issues[iid].priority := $event.value
            issues[iid].updatedAt := now
            emit saveIssues(issues)
          }
        }

reducer updateAssignee
    on=ui.input(DetailAssigneeInput)
    do= let maybeId = routeIssueId(route)
        if maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            issues[iid].assignee := $event.value
            issues[iid].updatedAt := now
            emit saveIssues(issues)
          }
        }

reducer addTag
    on=ui.click(AddTagBtn)
    do= let cleaned = tagDraft.trim
        let maybeId = routeIssueId(route)
        if !cleaned.is-empty && maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            issues[iid].tags := addTagToList(issues[iid].tags, cleaned)
            issues[iid].updatedAt := now
            tagDraft := ""
            emit saveIssues(issues)
          }
        }

reducer removeTag
    on=ui.click(RemoveTagBtn)
    do= let maybeId = routeIssueId(route)
        if maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            issues[iid].tags := removeTagFromList(issues[iid].tags, $el.tag)
            issues[iid].updatedAt := now
            emit saveIssues(issues)
          }
        }

reducer addComment
    on=ui.click(AddCommentBtn)
    do= let body = commentDraft.trim
        let maybeId = routeIssueId(route)
        if !body.is-empty && maybeId.is-some then {
          let iid = maybeId.get
          if issues.has(iid) then {
            let cid = Text.fresh()
            let ts = now
            comments[cid] := {
              id: cid,
              issueId: iid,
              author: currentUser,
              body: body,
              createdAt: ts
            }
            commentDraft := ""
            emit saveComments(comments)
          }
        }

reducer deleteComment
    on=ui.click(DeleteCommentBtn)
    do= comments := comments.remove($el.commentId)
        emit saveComments(comments)

reducer deleteIssue
    on=ui.click(DeleteIssueBtn)
    do= let maybeId = routeIssueId(route)
        if maybeId.is-some then {
          let iid = maybeId.get
          issues := issues.remove(iid)
          comments := comments.filter($2.issueId != iid)
          emit saveIssues(issues)
          emit saveComments(comments)
          emit navigate({path: "/", params: {}, query: {}})
        }

reducer clearDetailDrafts
    on=route.leave("/issues/:id")
    do= tagDraft := ""
        commentDraft := ""

reducer setLightTheme
    on=ui.click(LightThemeBtn)
    do= themeName := "Light"

reducer setDarkTheme
    on=ui.click(DarkThemeBtn)
    do= themeName := "Dark"

reducer toggleTheme
    on=ui.click(ToggleThemeBtn)
    do= themeName := if themeName == "Light" then "Dark" else "Light"

# ==============================================================================
# Shared UI Tiles
# ==============================================================================

tile AppHeader
    = region(
        row(
          link("Issue Tracker", to="/") {size: "lg", weight: "bold", color: "fg"},
          row(
            link("Issues", to="/") {size: "sm", color: "muted"},
            link("Settings", to="/settings") {size: "sm", color: "muted"}
          ) {gap: "md", align: "center"}
        ) {justify: "between", align: "center", pad-x: "lg", pad-y: "md", bg: "surface"}
      ) {role: "navigation", aria-label: "Primary"}

tile StatusBadge in=Status
    = box(
        text(statusLabel($1)) {size: "xs", weight: "medium", color: statusColor($1)}
      ) {pad-x: "sm", pad-y: "xs", bg: "bg", radius: "pill"}

tile PriorityBadge in=Priority
    = box(
        text(priorityLabel($1)) {size: "xs", weight: "medium", color: priorityColor($1)}
      ) {pad-x: "sm", pad-y: "xs", bg: "bg", radius: "pill"}

tile StorageAlert
    = when(storageError.is-some,
        box(
          text("Storage warning: " + storageError.get-or("")) {size: "sm", color: "danger"}
        ) {pad: "sm", bg: "surface", radius: "sm"})

# ==============================================================================
# Issue List Page ("/")
# ==============================================================================

tile NewIssueBtn
    = button(text="New Issue", type="button") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile FilterStatusSelect
    = select(
        value=filter.status,
        options=statusFilterOptions(),
        id="filter-status"
      )

tile FilterPrioritySelect
    = select(
        value=filter.priority,
        options=priorityFilterOptions(),
        id="filter-priority"
      )

tile FilterSearchInput
    = input(
        value=filter.search,
        placeholder="Search titles...",
        type="text",
        id="filter-search"
      )

tile ClearFilterBtn
    = button(text="Clear filters", type="button") {variant: "ghost", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile FilterBar
    = panel(
        row(
          column(
            label("Status") {for: "filter-status"},
            FilterStatusSelect
          ) {gap: "xs"},
          column(
            label("Priority") {for: "filter-priority"},
            FilterPrioritySelect
          ) {gap: "xs"},
          column(
            label("Search") {for: "filter-search"},
            FilterSearchInput
          ) {gap: "xs"},
          ClearFilterBtn
        ) {gap: "md", align: "end", wrap: true}
      ) {bg: "surface", pad: "md", radius: "md"}

tile IssueSummaryBar
    = row(
        text("Open: " + countByStatus(issues, Open).show) {size: "sm", color: "success"},
        text("In Progress: " + countByStatus(issues, InProgress).show) {size: "sm", color: "warning"},
        text("Done: " + countByStatus(issues, Done).show) {size: "sm", color: "muted"}
      ) {gap: "md", align: "center"}

tile IssueCardTag in=Text
    = box(
        text($1) {size: "xs", color: "muted"}
      ) {pad-x: "sm", pad-y: "xs", bg: "bg", radius: "pill"}

tile IssueCardBody in=Issue
    = card(
        column(
          row(
            link($1.title, to="/issues/" + $1.id.show) {size: "md", weight: "bold", color: "primary"},
            row(
              StatusBadge($1.status),
              PriorityBadge($1.priority)
            ) {gap: "xs", align: "center"}
          ) {justify: "between", align: "center", wrap: true, gap: "sm"},
          row(
            when(!$1.assignee.is-empty,
              text("Assignee: " + $1.assignee) {size: "xs", color: "muted"}),
            text("Created " + formatTime($1.createdAt)) {size: "xs", color: "muted"}
          ) {gap: "md", align: "center", wrap: true},
          when(!$1.tags.is-empty,
            row(
              for tg in $1.tags
                IssueCardTag(tg)
            ) {gap: "xs", wrap: true})
        ) {gap: "xs"}
      ) {bg: "surface", pad: "md", radius: "md", shadow: "sm"}

tile IssueCard in=IssueId
    = match issues.get($1) with
        | Some(issue) -> IssueCardBody(issue)
        | None        -> box()

tile IssueListItems
    = column(
        for id in filteredIssues(issues, filter)
          IssueCard(id) {key: id.show}
      ) {gap: "sm"}

tile IssueListPage
    = page(
        AppHeader,
        column(
          StorageAlert,
          row(
            column(
              heading("Issues") {level: 1, size: "xl"},
              IssueSummaryBar
            ) {gap: "xs"},
            NewIssueBtn
          ) {justify: "between", align: "center", wrap: true, gap: "md"},
          FilterBar,
          if filteredIssues(issues, filter).is-empty
          then box(
                 text("No issues") {color: "muted", size: "md"}
               ) {pad: "lg", bg: "surface", radius: "md"}
          else IssueListItems
        ) {gap: "md", pad: "lg", max-w: 960}
      ) {bg: "bg", color: "fg", min-h: "100vh"}

# ==============================================================================
# New Issue Page ("/new")
# ==============================================================================

tile CancelNewBtn
    = button(text="Cancel", type="button") {variant: "ghost", pad-x: "md", pad-y: "sm", radius: "sm"}

tile NewIssueForm
    = form(
        column(
          column(
            label("Title") {for: "new-title"},
            input(bind=draft.title, id="new-title", placeholder="Short summary of the issue")
          ) {gap: "xs"},
          column(
            label("Description") {for: "new-body"},
            textarea(bind=draft.body, id="new-body", placeholder="Details, steps to reproduce, context...") {rows: 6}
          ) {gap: "xs"},
          row(
            column(
              label("Priority") {for: "new-priority"},
              select(bind=draft.priority, options=priorityOptions(), id="new-priority")
            ) {gap: "xs"},
            column(
              label("Assignee") {for: "new-assignee"},
              input(bind=draft.assignee, id="new-assignee", placeholder="Assignee")
            ) {gap: "xs"}
          ) {gap: "md", wrap: true},
          column(
            label("Tags (comma-separated)") {for: "new-tags"},
            input(bind=draft.tags, id="new-tags", placeholder="bug, ui, backend")
          ) {gap: "xs"},
          row(
            button(text="Create issue", type="submit") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"},
            CancelNewBtn
          ) {gap: "sm", align: "center"}
        ) {gap: "md"}
      )

tile NewIssuePage
    = page(
        AppHeader,
        column(
          heading("New Issue") {level: 1, size: "xl"},
          panel(NewIssueForm) {bg: "surface", pad: "lg", radius: "md"}
        ) {gap: "md", pad: "lg", max-w: 720}
      ) {bg: "bg", color: "fg", min-h: "100vh"}

# ==============================================================================
# Issue Detail Page ("/issues/:id")
# ==============================================================================

tile BackToListBtn
    = button(text="Back", type="button") {variant: "ghost", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile DeleteIssueBtn
    = button(text="Delete issue", type="button") {bg: "danger", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile DetailStatusSelect in=Status
    = select(
        value=$1,
        options=statusOptions(),
        id="detail-status"
      )

tile DetailPrioritySelect in=Priority
    = select(
        value=$1,
        options=priorityOptions(),
        id="detail-priority"
      )

tile DetailAssigneeInput in=Text
    = input(
        value=$1,
        placeholder="Unassigned",
        type="text",
        id="detail-assignee"
      )

tile RemoveTagBtn in=Text
    = button(text="Remove tag", type="button") {tag: $1, variant: "ghost", color: "danger", pad-x: "xs", pad-y: "xs", radius: "sm"}

tile TagChip in=Text
    = row(
        text($1) {size: "sm", weight: "medium"},
        RemoveTagBtn($1)
      ) {gap: "xs", align: "center", pad-x: "sm", pad-y: "xs", bg: "bg", radius: "pill"}

tile TagInput
    = input(
        bind=tagDraft,
        placeholder="Tag name",
        type="text",
        id="tag-input"
      )

tile AddTagBtn
    = button(text="Add tag", type="button") {bg: "primary", color: "bg", pad-x: "sm", pad-y: "xs", radius: "sm"}

tile CommentInput
    = input(
        bind=commentDraft,
        placeholder="Write a comment...",
        type="text",
        id="comment-input"
      )

tile AddCommentBtn
    = button(text="Add comment", type="button") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile DeleteCommentBtn in=Text
    = button(text="Delete comment", type="button") {commentId: $1, variant: "ghost", color: "danger", pad-x: "xs", pad-y: "xs", radius: "sm"}

tile CommentCardBody in=Comment
    = card(
        column(
          row(
            row(
              text($1.author) {size: "sm", weight: "bold"},
              text(formatTime($1.createdAt)) {size: "xs", color: "muted"}
            ) {gap: "sm", align: "center"},
            DeleteCommentBtn($1.id)
          ) {justify: "between", align: "center", gap: "sm"},
          text($1.body) {size: "md"}
        ) {gap: "xs"}
      ) {bg: "surface", pad: "md", radius: "md"}

tile CommentCard in=Text
    = match comments.get($1) with
        | Some(c) -> CommentCardBody(c)
        | None    -> box()

tile IssueCommentsList in=IssueId
    = column(
        for cid in commentsForIssue(comments, $1)
          CommentCard(cid) {key: cid}
      ) {gap: "sm"}

tile IssueTagsList in=List(Text)
    = row(
        for tg in $1
          TagChip(tg)
      ) {gap: "xs", wrap: true}

tile IssueDetailBody in=Issue
    = column(
        row(
          BackToListBtn,
          DeleteIssueBtn
        ) {justify: "between", align: "center"},
        column(
          heading($1.title) {level: 1, size: "xl"},
          row(
            StatusBadge($1.status),
            PriorityBadge($1.priority),
            text("Created " + formatTime($1.createdAt)) {size: "xs", color: "muted"},
            text("Updated " + formatTime($1.updatedAt)) {size: "xs", color: "muted"}
          ) {gap: "sm", align: "center", wrap: true}
        ) {gap: "xs"},
        panel(
          row(
            column(
              label("Status") {for: "detail-status"},
              DetailStatusSelect($1.status)
            ) {gap: "xs"},
            column(
              label("Priority") {for: "detail-priority"},
              DetailPrioritySelect($1.priority)
            ) {gap: "xs"},
            column(
              label("Assignee") {for: "detail-assignee"},
              DetailAssigneeInput($1.assignee)
            ) {gap: "xs"}
          ) {gap: "md", wrap: true}
        ) {bg: "surface", pad: "md", radius: "md"},
        panel(
          column(
            heading("Description") {level: 2, size: "md"},
            text(if $1.body.is-empty then "No description provided." else $1.body) {size: "md"}
          ) {gap: "sm"}
        ) {bg: "surface", pad: "md", radius: "md"},
        panel(
          column(
            heading("Tags") {level: 2, size: "md"},
            if $1.tags.is-empty
            then text("No tags") {size: "sm", color: "muted"}
            else IssueTagsList($1.tags),
            row(
              label("Add tag") {for: "tag-input"},
              TagInput,
              AddTagBtn
            ) {gap: "sm", align: "center", wrap: true}
          ) {gap: "sm"}
        ) {bg: "surface", pad: "md", radius: "md"},
        divider(),
        column(
          heading("Comments (" + commentsForIssue(comments, $1.id).length.show + ")") {level: 2, size: "lg"},
          if commentsForIssue(comments, $1.id).is-empty
          then text("No comments yet.") {size: "sm", color: "muted"}
          else IssueCommentsList($1.id),
          panel(
            row(
              label("Comment") {for: "comment-input"},
              CommentInput,
              AddCommentBtn
            ) {gap: "sm", align: "center", wrap: true}
          ) {bg: "surface", pad: "md", radius: "md"}
        ) {gap: "md"}
      ) {gap: "md"}

tile IssueNotFoundView
    = column(
        BackToListBtn,
        heading("Issue not found") {level: 1, size: "xl"},
        text("The requested issue does not exist or was deleted.") {color: "muted"}
      ) {gap: "md"}

tile IssueDetailContent in=IssueId
    = match issues.get($1) with
        | Some(issue) -> IssueDetailBody(issue)
        | None        -> IssueNotFoundView

tile IssueDetailPage
    = page(
        AppHeader,
        column(
          StorageAlert,
          match routeIssueId(route) with
            | Some(iid) -> IssueDetailContent(iid)
            | None      -> IssueNotFoundView
        ) {gap: "md", pad: "lg", max-w: 960}
      ) {bg: "bg", color: "fg", min-h: "100vh"}

# ==============================================================================
# Settings Page ("/settings")
# ==============================================================================

tile LightThemeBtn
    = button(text="Light", type="button") {bg: "surface", color: "fg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile DarkThemeBtn
    = button(text="Dark", type="button") {bg: "surface", color: "fg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile ToggleThemeBtn
    = button(text="Toggle theme", type="button") {bg: "primary", color: "bg", pad-x: "md", pad-y: "sm", radius: "sm"}

tile SettingsPage
    = page(
        AppHeader,
        column(
          heading("Settings") {level: 1, size: "xl"},
          panel(
            column(
              heading("Appearance") {level: 2, size: "lg"},
              text("Current theme: " + themeName) {size: "sm", color: "muted"},
              row(
                LightThemeBtn,
                DarkThemeBtn,
                ToggleThemeBtn
              ) {gap: "sm", align: "center"}
            ) {gap: "sm"}
          ) {bg: "surface", pad: "md", radius: "md"},
          panel(
            column(
              heading("Profile") {level: 2, size: "lg"},
              label("Display name") {for: "settings-user"},
              input(bind=currentUser, id="settings-user", placeholder="Your name")
            ) {gap: "sm"}
          ) {bg: "surface", pad: "md", radius: "md"},
          link("Back to issues", to="/") {color: "primary"}
        ) {gap: "md", pad: "lg", max-w: 720}
      ) {bg: "bg", color: "fg", min-h: "100vh"}

# ==============================================================================
# 404 Page ("/404")
# ==============================================================================

tile NotFound
    = page(
        AppHeader,
        column(
          heading("404") {level: 1, size: "xl"},
          text("Page not found.") {color: "muted"},
          link("Back to issues", to="/") {color: "primary"}
        ) {gap: "md", pad: "lg", max-w: 720}
      ) {bg: "bg", color: "fg", min-h: "100vh"}

# ==============================================================================
# Application Entry
# ==============================================================================

app IssueTracker
    caps   = [storage.read, storage.write, nav.push]
    routes = {
        "/"           -> IssueListPage,
        "/issues/:id" -> IssueDetailPage,
        "/new"        -> NewIssuePage,
        "/settings"   -> SettingsPage,
        "/404"        -> NotFound
    }
    init   = []
    theme  = themeName
