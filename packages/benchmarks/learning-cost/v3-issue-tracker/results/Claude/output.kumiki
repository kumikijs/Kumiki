# Issue Tracker — a GitHub Issues style SPA with filtering and localStorage persistence

# ---------------------------------------------------------------- types

type IssueId = nominal Text where uuid
type Status = Open | InProgress | Done
type Priority = Low | Med | High

type Issue = {
    id: IssueId,
    title: Text,
    body: Text,
    status: Status,
    priority: Priority,
    assignee: Text,
    tags: List(Text),
    createdAt: Time,
    updatedAt: Time
}

type Comment = {id: Text, issueId: IssueId, author: Text, body: Text, createdAt: Time}

type FilterState = {status: Option(Status), priority: Option(Priority), search: Text}

type IssueDraft = {title: Text, body: Text, priority: Priority, assignee: Text, tags: Text}

# ---------------------------------------------------------------- theme

theme LightTheme = {
    colors: {
        bg:      "#ffffff",
        fg:      "#1f2328",
        muted:   "#656d76",
        primary: "#0969da",
        success: "#1a7f37",
        warning: "#9a6700",
        danger:  "#cf222e",
        surface: "#f6f8fa",
        border:  "#d0d7de"
    },
    spacing: {
        xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"
    },
    radius: {
        sm: "4px", md: "8px", pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {
            sm: "13px", md: "15px", lg: "20px", xl: "28px"
        },
        weight: {
            normal: "400", bold: "700"
        },
        line-height: "1.5"
    }
}

theme DarkTheme = {
    colors: {
        bg:      "#0d1117",
        fg:      "#e6edf3",
        muted:   "#8d96a0",
        primary: "#2f81f7",
        success: "#3fb950",
        warning: "#d29922",
        danger:  "#f85149",
        surface: "#161b22",
        border:  "#30363d"
    },
    spacing: {
        xs: "4px", sm: "8px", md: "16px", lg: "24px", xl: "40px"
    },
    radius: {
        sm: "4px", md: "8px", pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {
            sm: "13px", md: "15px", lg: "20px", xl: "28px"
        },
        weight: {
            normal: "400", bold: "700"
        },
        line-height: "1.5"
    }
}

# ---------------------------------------------------------------- slots

slot issues       : Map(IssueId, Issue) = {}
slot comments     : Map(Text, Comment)  = {}
slot filter       : FilterState         = {status: None, priority: None, search: ""}
slot currentUser  : Text                = "me"
slot draft        : IssueDraft          = {title: "", body: "", priority: Med, assignee: "", tags: ""}
slot commentDraft : Text                = ""
slot tagDraft     : Text                = ""
slot themeName    : Text                = "LightTheme"
slot storageError : Option(Text)        = None

# ---------------------------------------------------------------- effects

effect saveIssues   cap=storage.write
                    in=Map(IssueId, Issue)
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "issue-tracker.issues", value: $1}

effect saveComments cap=storage.write
                    in=Map(Text, Comment)
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "issue-tracker.comments", value: $1}

effect loadIssues   cap=storage.read
                    in=Unit
                    out=Result(Option(Map(IssueId, Issue)), Text)
                    policy=once
                    map-request={key: "issue-tracker.issues", decode: Decoder.Json(Map(IssueId, Issue))}

effect loadComments cap=storage.read
                    in=Unit
                    out=Result(Option(Map(Text, Comment)), Text)
                    policy=once
                    map-request={key: "issue-tracker.comments", decode: Decoder.Json(Map(Text, Comment))}

effect saveTheme    cap=storage.write
                    in=Text
                    out=Result(Unit, Text)
                    policy=debounce(300ms)
                    map-request={key: "issue-tracker.theme", value: $1}

effect loadTheme    cap=storage.read
                    in=Unit
                    out=Result(Option(Text), Text)
                    policy=once
                    map-request={key: "issue-tracker.theme", decode: Decoder.Json(Text)}

# ---------------------------------------------------------------- pure fns

fn statusLabel(s: Status) -> Text
   = match s with
       | Open       -> "Open"
       | InProgress -> "In Progress"
       | Done       -> "Done"

fn statusColor(s: Status) -> Text
   = match s with
       | Open       -> "success"
       | InProgress -> "warning"
       | Done       -> "muted"

fn statusSlug(s: Status) -> Text
   = match s with
       | Open       -> "open"
       | InProgress -> "in-progress"
       | Done       -> "done"

fn priorityLabel(p: Priority) -> Text
   = match p with
       | Low  -> "Low"
       | Med  -> "Med"
       | High -> "High"

fn priorityColor(p: Priority) -> Text
   = match p with
       | Low  -> "muted"
       | Med  -> "warning"
       | High -> "danger"

fn prioritySlug(p: Priority) -> Text
   = match p with
       | Low  -> "low"
       | Med  -> "med"
       | High -> "high"

fn statusOptions() -> List({label: Text, value: Status})
   = [
       {label: "Open",        value: Open},
       {label: "In Progress", value: InProgress},
       {label: "Done",        value: Done}
     ]

fn priorityOptions() -> List({label: Text, value: Priority})
   = [
       {label: "Low",  value: Low},
       {label: "Med",  value: Med},
       {label: "High", value: High}
     ]

fn statusFilterOptions() -> List({label: Text, value: Text})
   = [
       {label: "All",         value: "all"},
       {label: "Open",        value: "open"},
       {label: "In Progress", value: "in-progress"},
       {label: "Done",        value: "done"}
     ]

fn priorityFilterOptions() -> List({label: Text, value: Text})
   = [
       {label: "All",  value: "all"},
       {label: "Low",  value: "low"},
       {label: "Med",  value: "med"},
       {label: "High", value: "high"}
     ]

fn statusFilterKey(s: Option(Status)) -> Text
   = match s with
       | Some(x) -> statusSlug(x)
       | None    -> "all"

fn priorityFilterKey(p: Option(Priority)) -> Text
   = match p with
       | Some(x) -> prioritySlug(x)
       | None    -> "all"

fn parseStatusFilter(t: Text) -> Option(Status)
   = if t == "open" then Some(Open)
     else if t == "in-progress" then Some(InProgress)
     else if t == "done" then Some(Done)
     else None

fn parsePriorityFilter(t: Text) -> Option(Priority)
   = if t == "low" then Some(Low)
     else if t == "med" then Some(Med)
     else if t == "high" then Some(High)
     else None

fn matchesStatus(s: Status, want: Option(Status)) -> Bool
   = match want with
       | Some(x) -> x == s
       | None    -> true

fn matchesPriority(p: Priority, want: Option(Priority)) -> Bool
   = match want with
       | Some(x) -> x == p
       | None    -> true

fn matchesSearch(title: Text, query: Text) -> Bool
   = (query.trim == "") || title.lower.contains(query.trim.lower)

fn matchesFilter(issue: Issue, f: FilterState) -> Bool
   = matchesStatus(issue.status, f.status) && matchesPriority(issue.priority, f.priority) && matchesSearch(issue.title, f.search)

fn filteredIssues(all: Map(IssueId, Issue), f: FilterState) -> List(IssueId)
   = all.entries
        .filter(matchesFilter($2, f))
        .sort-by($2.updatedAt)
        .reverse
        .map($1)

fn commentsForIssue(cs: Map(Text, Comment), iid: IssueId) -> List(Text)
   = cs.entries
        .filter($2.issueId == iid)
        .sort-by($2.createdAt)
        .map($1)

fn parseTags(raw: Text) -> List(Text)
   = raw.split(",")
        .map($1.trim)
        .filter($1 != "")
        .unique

fn currentIssueId(all: Map(IssueId, Issue), r: Route) -> Option(IssueId)
   = IssueId.parse(r.params.get-or("id", "")).filter(all.has($1))

fn assigneeLabel(a: Text) -> Text
   = if a.trim == "" then "Unassigned" else "@" + a

fn bodyLabel(b: Text) -> Text
   = if b.trim == "" then "No description provided." else b

fn formatTime(t: Time) -> Text
   = t.format("yyyy-MM-dd HH:mm")

fn emptyDraft() -> IssueDraft
   = {title: "", body: "", priority: Med, assignee: "", tags: ""}

fn emptyFilter() -> FilterState
   = {status: None, priority: None, search: ""}

# ---------------------------------------------------------------- shared tiles

tile AppHeader = row(
                   heading("Issue Tracker", level=2),
                   row(
                     link("Issues", to="/"),
                     link("Settings", to="/settings")) {gap: "md"}
                 ) {justify: "between", align: "center", pad-y: "sm"}

tile StatusBadge in=Status
    = box(text(statusLabel($1)) {color: statusColor($1), weight: "bold", size: "sm"}) {pad-x: "sm", radius: "pill", bg: "surface"}

tile PriorityBadge in=Priority
    = box(text(priorityLabel($1)) {color: priorityColor($1), weight: "bold", size: "sm"}) {pad-x: "sm", radius: "pill", bg: "surface"}

tile TagLabel in=Text = text($1) {color: "primary", size: "sm"}

# ---------------------------------------------------------------- list page

tile NewIssueBtn = button(text="New Issue") {bg: "primary", color: "bg"}

tile FilterStatusSelect = select(id="filter-status",
                                 value=statusFilterKey(filter.status),
                                 options=statusFilterOptions())

tile FilterPrioritySelect = select(id="filter-priority",
                                   value=priorityFilterKey(filter.priority),
                                   options=priorityFilterOptions())

tile FilterSearchInput = input(id="filter-search",
                               value=filter.search,
                               type="search",
                               placeholder="Search titles")

tile ClearFilterBtn = button(text="Clear filters")

tile FilterBar = row(
                   FilterStatusSelect,
                   FilterPrioritySelect,
                   FilterSearchInput,
                   ClearFilterBtn
                 ) {gap: "sm", align: "center", wrap: true}

tile IssueCard in=IssueId
    = card(
        column(
          link(issues[$1].title, to="/issues/" + $1.show) {weight: "bold", size: "lg"},
          row(
            StatusBadge(issues[$1].status),
            PriorityBadge(issues[$1].priority),
            text(assigneeLabel(issues[$1].assignee)) {color: "muted", size: "sm"}
          ) {gap: "sm", align: "center"},
          row(for t in issues[$1].tags TagLabel(t) {key: t}) {gap: "sm", wrap: true},
          text("Opened " + formatTime(issues[$1].createdAt)) {color: "muted", size: "sm"}
        ) {gap: "xs"}
      ) {pad: "md", radius: "md", bg: "surface"}

tile IssueList = column(
                   for iid in filteredIssues(issues, filter)
                     IssueCard(iid) {key: iid.show}
                 ) {gap: "sm"}

tile IssueListBody = column(
                       if filteredIssues(issues, filter).is-empty
                       then text("No issues") {color: "muted"}
                       else IssueList)

tile IssueListPage = page(
                       AppHeader,
                       row(
                         heading("Issues", level=1),
                         NewIssueBtn
                       ) {justify: "between", align: "center"},
                       FilterBar,
                       IssueListBody
                     ) {pad: "lg", gap: "md", bg: "bg", color: "fg"}

# ---------------------------------------------------------------- detail page

tile BackBtn = button(text="Back")

tile DeleteIssueBtn = button(text="Delete issue") {bg: "danger", color: "bg"}

tile DetailStatusSelect in=IssueId
    = select(id="detail-status", value=issues[$1].status, options=statusOptions())

tile DetailPrioritySelect in=IssueId
    = select(id="detail-priority", value=issues[$1].priority, options=priorityOptions())

tile AssigneeInput in=IssueId
    = input(id="detail-assignee", value=issues[$1].assignee, placeholder="Unassigned")

tile RemoveTagBtn in=Text = button(text="Remove tag") {tag: $1}

tile TagChip in=Text = row(TagLabel($1), RemoveTagBtn($1)) {gap: "xs", align: "center"}

tile TagInput = input(id="tag-input", bind=tagDraft, placeholder="New tag")

tile AddTagBtn = button(text="Add tag")

tile TagsSection in=IssueId
    = column(
        heading("Tags", level=3),
        row(for t in issues[$1].tags TagChip(t) {key: t}) {gap: "sm", wrap: true},
        row(TagInput, AddTagBtn) {gap: "sm", align: "center"}
      ) {gap: "sm"}

tile DeleteCommentBtn in=Text = button(text="Delete comment") {commentId: $1}

tile CommentItem in=Text
    = card(
        column(
          row(
            text(comments[$1].author) {weight: "bold"},
            text(formatTime(comments[$1].createdAt)) {color: "muted", size: "sm"}
          ) {gap: "sm", align: "center"},
          text(comments[$1].body),
          DeleteCommentBtn($1)
        ) {gap: "xs"}
      ) {pad: "sm", radius: "sm", bg: "surface"}

tile CommentList in=IssueId
    = column(
        for cid in commentsForIssue(comments, $1)
          CommentItem(cid) {key: cid}
      ) {gap: "sm"}

tile CommentInput = input(id="comment-input", bind=commentDraft, placeholder="Write a comment")

tile AddCommentBtn = button(text="Add comment") {bg: "primary", color: "bg"}

tile CommentsSection in=IssueId
    = column(
        heading("Comments", level=3),
        if commentsForIssue(comments, $1).is-empty
        then text("No comments yet") {color: "muted"}
        else CommentList($1),
        row(CommentInput, AddCommentBtn) {gap: "sm", align: "center"}
      ) {gap: "sm"}

tile IssueDetail in=IssueId
    = column(
        heading(issues[$1].title, level=1),
        row(
          StatusBadge(issues[$1].status),
          PriorityBadge(issues[$1].priority),
          text(assigneeLabel(issues[$1].assignee)) {color: "muted"}
        ) {gap: "sm", align: "center"},
        row(
          column(label("Status") {for: "detail-status"}, DetailStatusSelect($1)) {gap: "xs"},
          column(label("Priority") {for: "detail-priority"}, DetailPrioritySelect($1)) {gap: "xs"},
          column(label("Assignee") {for: "detail-assignee"}, AssigneeInput($1)) {gap: "xs"}
        ) {gap: "md", wrap: true},
        box(text(bodyLabel(issues[$1].body))) {pad: "md", radius: "md", bg: "surface"},
        TagsSection($1),
        column(
          text("Created " + formatTime(issues[$1].createdAt)) {color: "muted", size: "sm"},
          text("Updated " + formatTime(issues[$1].updatedAt)) {color: "muted", size: "sm"}
        ),
        DeleteIssueBtn,
        divider(),
        CommentsSection($1)
      ) {gap: "md"}

tile IssueMissing = column(
                      heading("Issue not found", level=1),
                      text("This issue does not exist or has been deleted.") {color: "muted"})

tile IssueDetailPage = page(
                         AppHeader,
                         row(BackBtn),
                         match currentIssueId(issues, route) with
                           | Some(iid) -> IssueDetail(iid)
                           | None      -> IssueMissing
                       ) {pad: "lg", gap: "md", bg: "bg", color: "fg"}

# ---------------------------------------------------------------- new issue page

tile CancelBtn = button(text="Cancel", type="button")

tile NewIssueForm
    = form(
        column(
          label("Title") {for: "new-title"},
          input(id="new-title", bind=draft.title, placeholder="Issue title"),
          label("Body") {for: "new-body"},
          textarea(id="new-body", bind=draft.body, placeholder="Describe the issue", rows=6),
          label("Priority") {for: "new-priority"},
          select(id="new-priority", bind=draft.priority, options=priorityOptions()),
          label("Assignee") {for: "new-assignee"},
          input(id="new-assignee", bind=draft.assignee, placeholder="Who works on it"),
          label("Tags (comma-separated)") {for: "new-tags"},
          input(id="new-tags", bind=draft.tags, placeholder="bug, ui"),
          row(
            button(text="Create issue", type="submit") {bg: "primary", color: "bg"},
            CancelBtn
          ) {gap: "sm"}
        ) {gap: "sm"}
      )

tile NewIssuePage = page(
                      AppHeader,
                      heading("New issue", level=1),
                      NewIssueForm
                    ) {pad: "lg", gap: "md", bg: "bg", color: "fg"}

# ---------------------------------------------------------------- settings page

tile LightThemeBtn = button(text="Light theme")
tile DarkThemeBtn  = button(text="Dark theme")

tile SettingsPage = page(
                      AppHeader,
                      heading("Settings", level=1),
                      column(
                        heading("Theme", level=3),
                        text("Current theme: " + (if themeName == "DarkTheme" then "Dark" else "Light")),
                        row(LightThemeBtn, DarkThemeBtn) {gap: "sm"}
                      ) {gap: "sm"},
                      column(
                        heading("User", level=3),
                        label("Your name") {for: "settings-user"},
                        input(id="settings-user", bind=currentUser)
                      ) {gap: "sm"},
                      when(storageError.is-some,
                        text("Storage error: " + storageError.get-or("")) {color: "danger"})
                    ) {pad: "lg", gap: "md", bg: "bg", color: "fg"}

# ---------------------------------------------------------------- not found

tile NotFound = page(
                  AppHeader,
                  heading("Page not found", level=1),
                  link("Back to issues", to="/")
                ) {pad: "lg", gap: "md", bg: "bg", color: "fg"}

# ---------------------------------------------------------------- reducers: persistence

reducer loadFromStorage
    on=app.start
    do= emit loadIssues()
        emit loadComments()
        emit loadTheme()

reducer issuesLoaded
    on=loadIssues.ok($stored, _)
    do= issues := $stored.get-or({})

reducer issuesLoadFailed
    on=loadIssues.err($e, _)
    do= storageError := Some($e)

reducer commentsLoaded
    on=loadComments.ok($stored, _)
    do= comments := $stored.get-or({})

reducer commentsLoadFailed
    on=loadComments.err($e, _)
    do= storageError := Some($e)

reducer themeLoaded
    on=loadTheme.ok($stored, _)
    do= themeName := $stored.get-or("LightTheme")

reducer themeLoadFailed
    on=loadTheme.err($e, _)
    do= storageError := Some($e)

reducer issuesSaveFailed
    on=saveIssues.err($e, _)
    do= storageError := Some($e)

reducer commentsSaveFailed
    on=saveComments.err($e, _)
    do= storageError := Some($e)

reducer themeSaveFailed
    on=saveTheme.err($e, _)
    do= storageError := Some($e)

# ---------------------------------------------------------------- reducers: navigation

reducer openNewIssue
    on=ui.click(NewIssueBtn)
    do= emit navigate({path: "/new", params: {}})

reducer goBack
    on=ui.click(BackBtn)
    do= emit navigate({path: "/", params: {}})

reducer cancelNewIssue
    on=ui.click(CancelBtn)
    do= draft := emptyDraft()
        emit navigate({path: "/", params: {}})

# ---------------------------------------------------------------- reducers: issues

reducer createIssue
    on=ui.submit(NewIssueForm)
    do= if draft.title.trim != "" then {
            let id = IssueId.fresh()
            issues[id] := {id: id, title: draft.title.trim, body: draft.body, status: Open, priority: draft.priority, assignee: draft.assignee.trim, tags: parseTags(draft.tags), createdAt: now, updatedAt: now}
            draft := emptyDraft()
            emit saveIssues(issues)
            emit navigate({path: "/issues/" + id.show, params: {}})
        }

reducer updateStatus
    on=ui.change(DetailStatusSelect)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              issues[iid].status := $event.value
              issues[iid].updatedAt := now
              emit saveIssues(issues)
            }
          | None -> ()

reducer updatePriority
    on=ui.change(DetailPrioritySelect)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              issues[iid].priority := $event.value
              issues[iid].updatedAt := now
              emit saveIssues(issues)
            }
          | None -> ()

reducer updateAssignee
    on=ui.change(AssigneeInput)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              issues[iid].assignee := $event.value
              issues[iid].updatedAt := now
              emit saveIssues(issues)
            }
          | None -> ()

reducer addTag
    on=ui.click(AddTagBtn)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              let tag = tagDraft.trim
              if tag != "" && (issues[iid].tags.contains(tag) == false) then {
                  issues[iid].tags := issues[iid].tags.push(tag)
                  issues[iid].updatedAt := now
                  emit saveIssues(issues)
              }
              tagDraft := ""
            }
          | None -> ()

reducer removeTag
    on=ui.click(RemoveTagBtn)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              issues[iid].tags := issues[iid].tags.filter($1 != $el.tag)
              issues[iid].updatedAt := now
              emit saveIssues(issues)
            }
          | None -> ()

reducer deleteIssue
    on=ui.click(DeleteIssueBtn)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              issues := issues.remove(iid)
              comments := comments.filter($2.issueId != iid)
              emit saveIssues(issues)
              emit saveComments(comments)
              emit navigate({path: "/", params: {}})
            }
          | None -> ()

# ---------------------------------------------------------------- reducers: comments

reducer addComment
    on=ui.click(AddCommentBtn)
    do= match currentIssueId(issues, route) with
          | Some(iid) -> {
              let body = commentDraft.trim
              if body != "" then {
                  let cid = Text.fresh()
                  comments[cid] := {id: cid, issueId: iid, author: currentUser, body: body, createdAt: now}
                  emit saveComments(comments)
              }
              commentDraft := ""
            }
          | None -> ()

reducer deleteComment
    on=ui.click(DeleteCommentBtn)
    do= comments := comments.remove($el.commentId)
        emit saveComments(comments)

# ---------------------------------------------------------------- reducers: filter

reducer setFilterStatus
    on=ui.change(FilterStatusSelect)
    do= filter.status := parseStatusFilter($event.value)

reducer setFilterPriority
    on=ui.change(FilterPrioritySelect)
    do= filter.priority := parsePriorityFilter($event.value)

reducer setSearch
    on=ui.input(FilterSearchInput)
    do= filter.search := $event.value

reducer clearFilter
    on=ui.click(ClearFilterBtn)
    do= filter := emptyFilter()

# ---------------------------------------------------------------- reducers: settings

reducer useLightTheme
    on=ui.click(LightThemeBtn)
    do= themeName := "LightTheme"
        emit saveTheme(themeName)

reducer useDarkTheme
    on=ui.click(DarkThemeBtn)
    do= themeName := "DarkTheme"
        emit saveTheme(themeName)

# ---------------------------------------------------------------- app

app IssueTracker
    caps   = [storage.read, storage.write, nav.push]
    routes = {
        "/"           -> IssueListPage,
        "/issues/:id" -> IssueDetailPage,
        "/new"        -> NewIssuePage,
        "/settings"   -> SettingsPage,
        "/404"        -> NotFound
    }
    init   = []
    theme  = themeName
