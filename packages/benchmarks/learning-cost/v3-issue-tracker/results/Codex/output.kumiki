type IssueId = nominal Text where uuid

type Status = Open | InProgress | Done

type Priority = Low | Med | High

type Issue = {
    id: IssueId,
    title: Text,
    body: Text,
    status: Status,
    priority: Priority,
    assignee: Text,
    tags: List(Text),
    createdAt: Time,
    updatedAt: Time
}

type Comment = {
    id: Text,
    issueId: IssueId,
    author: Text,
    body: Text,
    createdAt: Time
}

type FilterState = {
    status: Option(Status),
    priority: Option(Priority),
    search: Text
}

type IssueDraft = {
    title: Text,
    body: Text,
    priority: Priority,
    assignee: Text,
    tags: Text
}

theme Light = {
    colors: {
        bg: "#ffffff",
        fg: "#1f2328",
        muted: "#656d76",
        primary: "#0969da",
        surface: "#f6f8fa",
        border: "#d0d7de",
        danger: "#cf222e",
        success: "#1a7f37"
    },
    spacing: {
        xs: "4px",
        sm: "8px",
        md: "16px",
        lg: "24px",
        xl: "40px"
    },
    radius: {
        sm: "4px",
        md: "8px",
        pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"},
        weight: {normal: "400", bold: "700"},
        line-height: "1.5"
    }
}

theme Dark = {
    colors: {
        bg: "#0d1117",
        fg: "#e6edf3",
        muted: "#8b949e",
        primary: "#58a6ff",
        surface: "#161b22",
        border: "#30363d",
        danger: "#f85149",
        success: "#3fb950"
    },
    spacing: {
        xs: "4px",
        sm: "8px",
        md: "16px",
        lg: "24px",
        xl: "40px"
    },
    radius: {
        sm: "4px",
        md: "8px",
        pill: "999px"
    },
    typography: {
        family: "system-ui, sans-serif",
        size: {sm: "14px", md: "16px", lg: "20px", xl: "28px"},
        weight: {normal: "400", bold: "700"},
        line-height: "1.5"
    }
}

slot issues : Map(IssueId, Issue) = {}
slot comments : Map(Text, Comment) = {}
slot filter : FilterState = {status: None, priority: None, search: ""}
slot currentUser : Text = "me"
slot draft : IssueDraft = {title: "", body: "", priority: Med, assignee: "", tags: ""}
slot commentDraft : Text = ""
slot tagDraft : Text = ""
slot themeName : Text = "Light"

effect saveIssues
    cap=storage.write
    in=Map(IssueId, Issue)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "issue-tracker.issues", value: $1}

effect saveComments
    cap=storage.write
    in=Map(Text, Comment)
    out=Result(Unit, Text)
    policy=debounce(300ms)
    map-request={key: "issue-tracker.comments", value: $1}

effect loadIssues
    cap=storage.read
    in=Unit
    out=Result(Option(Map(IssueId, Issue)), Text)
    policy=once
    map-request={key: "issue-tracker.issues", decode: Decoder.Json(Map(IssueId, Issue))}

effect loadComments
    cap=storage.read
    in=Unit
    out=Result(Option(Map(Text, Comment)), Text)
    policy=once
    map-request={key: "issue-tracker.comments", decode: Decoder.Json(Map(Text, Comment))}

fn statusLabel(status: Status) -> Text =
    match status with
    | Open -> "Open"
    | InProgress -> "In progress"
    | Done -> "Done"

fn priorityLabel(priority: Priority) -> Text =
    match priority with
    | Low -> "Low"
    | Med -> "Medium"
    | High -> "High"

fn priorityColor(priority: Priority) -> Text =
    match priority with
    | Low -> "#1a7f37"
    | Med -> "#9a6700"
    | High -> "#cf222e"

fn matchesFilter(issue: Issue, selected: FilterState) -> Bool =
    (match selected.status with
        | None -> true
        | Some(status) -> issue.status == status)
    && (match selected.priority with
        | None -> true
        | Some(priority) -> issue.priority == priority)
    && (selected.search.trim.is-empty
        || issue.title.lower.contains(selected.search.trim.lower)
        || issue.body.lower.contains(selected.search.trim.lower)
        || issue.assignee.lower.contains(selected.search.trim.lower))

fn filteredIssues(all: Map(IssueId, Issue), selected: FilterState) -> List(IssueId) =
    all.entries
        .filter(matchesFilter($2, selected))
        .sort-by($2.updatedAt)
        .reverse
        .map($1)

fn commentsForIssue(all: Map(Text, Comment), issueId: IssueId) -> List(Text) =
    all.entries
        .filter($2.issueId == issueId)
        .sort-by($2.createdAt)
        .map($1)

fn routeIssueId(current: Route) -> Option(IssueId) =
    IssueId.parse(current.params.get-or("id", ""))

fn parseTags(source: Text) -> List(Text) =
    source.split(",").map($1.trim).filter(not $1.is-empty).unique

reducer loadFromStorage
    on=app.start
    do= emit loadIssues()
        emit loadComments()

reducer restoreIssues
    on=loadIssues.ok($stored, _)
    do= match $stored with
        | Some(value) -> issues := value
        | None -> ()

reducer restoreComments
    on=loadComments.ok($stored, _)
    do= match $stored with
        | Some(value) -> comments := value
        | None -> ()

reducer createIssue
    on=ui.submit(NewIssueForm)
    do= if not draft.title.trim.is-empty then {
            let id = IssueId.fresh()
            let created = now
            issues[id] := {
                id: id,
                title: draft.title.trim,
                body: draft.body,
                status: Open,
                priority: draft.priority,
                assignee: draft.assignee.trim,
                tags: parseTags(draft.tags),
                createdAt: created,
                updatedAt: created
            }
            draft := {title: "", body: "", priority: Med, assignee: "", tags: ""}
            emit saveIssues(issues)
            emit navigate({path: "/issues/{id}", params: {"id": id.show}})
        }

reducer updateStatus
    on=ui.change(DetailStatusSelect)
    do= match routeIssueId(route) with
        | Some(id) -> {
            issues[id].status := $event.value
            issues[id].updatedAt := now
            emit saveIssues(issues)
        }
        | None -> ()

reducer updatePriority
    on=ui.change(DetailPrioritySelect)
    do= match routeIssueId(route) with
        | Some(id) -> {
            issues[id].priority := $event.value
            issues[id].updatedAt := now
            emit saveIssues(issues)
        }
        | None -> ()

reducer updateAssignee
    on=ui.change(DetailAssigneeInput)
    do= match routeIssueId(route) with
        | Some(id) -> {
            issues[id].assignee := $event.value
            issues[id].updatedAt := now
            emit saveIssues(issues)
        }
        | None -> ()

reducer addTag
    on=ui.submit(AddTagForm)
    do= match routeIssueId(route) with
        | Some(id) -> {
            if issues.has(id) && not tagDraft.trim.is-empty then {
                issues[id].tags := issues[id].tags.push(tagDraft.trim).unique
                issues[id].updatedAt := now
                tagDraft := ""
                emit saveIssues(issues)
            }
        }
        | None -> ()

reducer removeTag
    on=ui.click(RemoveTagButton)
    do= match routeIssueId(route) with
        | Some(id) -> {
            if issues.has(id) then {
                issues[id].tags := issues[id].tags.filter($1 != $el.tag)
                issues[id].updatedAt := now
                emit saveIssues(issues)
            }
        }
        | None -> ()

reducer addComment
    on=ui.submit(CommentForm)
    do= match routeIssueId(route) with
        | Some(issueId) -> {
            if issues.has(issueId) && not commentDraft.trim.is-empty then {
                let id = Text.fresh()
                comments[id] := {
                    id: id,
                    issueId: issueId,
                    author: currentUser,
                    body: commentDraft.trim,
                    createdAt: now
                }
                commentDraft := ""
                emit saveComments(comments)
            }
        }
        | None -> ()

reducer deleteComment
    on=ui.click(DeleteCommentButton)
    do= comments := comments.remove($el.commentId)
        emit saveComments(comments)

reducer deleteIssue
    on=ui.click(DeleteIssueButton)
    do= match routeIssueId(route) with
        | Some(id) -> {
            issues := issues.remove(id)
            comments := comments.filter($2.issueId != id)
            emit saveIssues(issues)
            emit saveComments(comments)
            emit navigate({path: "/", params: {}})
        }
        | None -> ()

reducer setFilterStatus
    on=ui.change(FilterStatusSelect)
    do= filter.status := $event.value

reducer setFilterPriority
    on=ui.change(FilterPrioritySelect)
    do= filter.priority := $event.value

reducer setSearch
    on=ui.input(FilterSearchInput)
    do= filter.search := $event.value

reducer clearFilter
    on=ui.click(ClearFilterButton)
    do= filter := {status: None, priority: None, search: ""}

reducer toggleTheme
    on=ui.click(ThemeButton)
    do= themeName := if themeName == "Light" then "Dark" else "Light"

tile FilterStatusSelect =
    select(
        value=filter.status,
        options=[
            {label: "All statuses", value: None},
            {label: "Open", value: Some(Open)},
            {label: "In progress", value: Some(InProgress)},
            {label: "Done", value: Some(Done)}
        ],
        placeholder="Status"
    )

tile FilterPrioritySelect =
    select(
        value=filter.priority,
        options=[
            {label: "All priorities", value: None},
            {label: "Low", value: Some(Low)},
            {label: "Medium", value: Some(Med)},
            {label: "High", value: Some(High)}
        ],
        placeholder="Priority"
    )

tile FilterSearchInput =
    input(value=filter.search, type="search", placeholder="Search issues")

tile ClearFilterButton = button(text="Clear filters")

tile FilterBar =
    column(
        heading("Filter issues", level=2),
        row(
            FilterStatusSelect,
            FilterPrioritySelect,
            FilterSearchInput,
            ClearFilterButton
        ) {gap: "sm", wrap: true}
    ) {gap: "sm", pad: "md"}

tile IssueCard in=IssueId =
    card(
        column(
            link(issues[$1].title, to="/issues/" + $1.show),
            row(
                text(statusLabel(issues[$1].status)),
                text(priorityLabel(issues[$1].priority)) {color: priorityColor(issues[$1].priority)},
                text("Assignee: " + issues[$1].assignee)
            ) {gap: "md", wrap: true},
            row(
                for tag in issues[$1].tags
                    text(tag) {key: tag, color: "muted"}
            ) {gap: "sm", wrap: true},
            text("Created " + issues[$1].createdAt.format("yyyy-MM-dd HH:mm")) {color: "muted"}
        ) {gap: "sm", pad: "md"}
    )

tile IssueListPage =
    page(
        column(
            row(
                heading("Issues", level=1),
                link("New Issue", to="/new"),
                link("Settings", to="/settings")
            ) {gap: "md", align: "center", justify: "between"},
            FilterBar,
            when(filteredIssues(issues, filter).is-empty,
                text("No issues")),
            column(
                for id in filteredIssues(issues, filter)
                    IssueCard(id) {key: id.show}
            ) {gap: "md"}
        ) {gap: "lg", pad: "lg"}
    )

tile DetailStatusSelect in=IssueId =
    select(
        value=issues[$1].status,
        options=[
            {label: "Open", value: Open},
            {label: "In progress", value: InProgress},
            {label: "Done", value: Done}
        ]
    )

tile DetailPrioritySelect in=IssueId =
    select(
        value=issues[$1].priority,
        options=[
            {label: "Low", value: Low},
            {label: "Medium", value: Med},
            {label: "High", value: High}
        ]
    )

tile DetailAssigneeInput in=IssueId =
    input(value=issues[$1].assignee, placeholder="Assignee")

tile RemoveTagButton in=Text =
    button(text="Remove " + $1) {tag: $1}

tile TagItem in=Text =
    row(
        text($1),
        RemoveTagButton($1)
    ) {gap: "xs", align: "center"}

tile AddTagForm =
    form(
        row(
            input(bind=tagDraft, placeholder="Add a tag"),
            button(text="Add tag", type="submit")
        ) {gap: "sm"}
    )

tile DeleteIssueButton = button(text="Delete issue")

tile DeleteCommentButton in=Text =
    button(text="Delete comment") {commentId: $1}

tile CommentItem in=Text =
    card(
        column(
            row(
                text(comments[$1].author),
                text(comments[$1].createdAt.format("yyyy-MM-dd HH:mm")) {color: "muted"},
                DeleteCommentButton($1)
            ) {gap: "sm", wrap: true},
            text(comments[$1].body)
        ) {gap: "sm", pad: "md"}
    )

tile CommentForm =
    form(
        column(
            label("New comment") {for: "comment-body"},
            textarea(bind=commentDraft, id="comment-body", placeholder="Write a comment", required=true),
            button(text="Add comment", type="submit")
        ) {gap: "sm"}
    )

tile IssueDetail in=IssueId =
    column(
        link("Back to issues", to="/"),
        heading(issues[$1].title, level=1),
        row(
            column(
                label("Status"),
                DetailStatusSelect($1)
            ) {gap: "xs"},
            column(
                label("Priority"),
                DetailPrioritySelect($1)
            ) {gap: "xs"},
            column(
                label("Assignee"),
                DetailAssigneeInput($1)
            ) {gap: "xs"}
        ) {gap: "md", wrap: true},
        heading("Description", level=2),
        text(issues[$1].body),
        heading("Tags", level=2),
        row(
            for tag in issues[$1].tags
                TagItem(tag) {key: tag}
        ) {gap: "sm", wrap: true},
        AddTagForm,
        text("Created: " + issues[$1].createdAt.format("yyyy-MM-dd HH:mm")) {color: "muted"},
        text("Updated: " + issues[$1].updatedAt.format("yyyy-MM-dd HH:mm")) {color: "muted"},
        DeleteIssueButton,
        heading("Comments", level=2),
        when(commentsForIssue(comments, $1).is-empty,
            text("No comments yet")),
        column(
            for id in commentsForIssue(comments, $1)
                CommentItem(id) {key: id}
        ) {gap: "md"},
        CommentForm
    ) {gap: "md", pad: "lg"}

tile IssueDetailPage =
    page(
        match routeIssueId(route) with
        | Some(id) ->
            if issues.has(id) then IssueDetail(id)
            else column(
                heading("Issue not found", level=1),
                link("Back to issues", to="/")
            ) {gap: "md", pad: "lg"}
        | None -> column(
            heading("Issue not found", level=1),
            link("Back to issues", to="/")
        ) {gap: "md", pad: "lg"}
    )

tile NewIssueForm =
    form(
        column(
            label("Title") {for: "issue-title"},
            input(bind=draft.title, id="issue-title", placeholder="Issue title", required=true),
            label("Description") {for: "issue-body"},
            textarea(bind=draft.body, id="issue-body", placeholder="Describe the issue"),
            label("Priority") {for: "issue-priority"},
            select(
                bind=draft.priority,
                id="issue-priority",
                options=[
                    {label: "Low", value: Low},
                    {label: "Medium", value: Med},
                    {label: "High", value: High}
                ]
            ),
            label("Assignee") {for: "issue-assignee"},
            input(bind=draft.assignee, id="issue-assignee", placeholder="Assignee"),
            label("Tags, separated by commas") {for: "issue-tags"},
            input(bind=draft.tags, id="issue-tags", placeholder="bug, urgent"),
            row(
                button(text="Create issue", type="submit"),
                link("Cancel", to="/")
            ) {gap: "md"}
        ) {gap: "sm"}
    )

tile NewIssuePage =
    page(
        column(
            link("Back to issues", to="/"),
            heading("New issue", level=1),
            NewIssueForm
        ) {gap: "md", pad: "lg"}
    )

tile ThemeButton =
    button(text=if themeName == "Light" then "Switch to dark" else "Switch to light")

tile SettingsPage =
    page(
        column(
            link("Back to issues", to="/"),
            heading("Settings", level=1),
            heading("Appearance", level=2),
            text("Current theme: " + themeName),
            ThemeButton,
            heading("Current user", level=2),
            input(bind=currentUser, placeholder="Name")
        ) {gap: "md", pad: "lg"}
    )

tile NotFound =
    page(
        column(
            heading("Page not found", level=1),
            text("The page you requested does not exist."),
            link("Back to issues", to="/")
        ) {gap: "md", pad: "lg"}
    )

app IssueTracker
    caps=[storage.read, storage.write, nav.push]
    routes={
        "/" -> IssueListPage,
        "/issues/:id" -> IssueDetailPage,
        "/new" -> NewIssuePage,
        "/settings" -> SettingsPage,
        "/404" -> NotFound
    }
    init=[]
    theme=themeName
