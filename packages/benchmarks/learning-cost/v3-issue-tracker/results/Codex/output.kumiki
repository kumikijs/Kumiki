type IssueId = nominal Text where uuid
type Status = Open | InProgress | Done
type Priority = Low | Med | High
type Issue = {id: IssueId, title: Text, body: Text, status: Status, priority: Priority, assignee: Text, tags: List(Text), createdAt: Time, updatedAt: Time}
type Comment = {id: Text, issueId: IssueId, author: Text, body: Text, createdAt: Time}
type FilterState = {status: Option(Status), priority: Option(Priority), search: Text}
type IssueDraft = {title: Text, body: Text, priority: Priority, assignee: Text, tags: Text}

slot issues : Map(IssueId, Issue) = {}
slot comments : Map(Text, Comment) = {}
slot filter : FilterState = {status: None, priority: None, search: ""}
slot currentUser : Text = "me"
slot draft : IssueDraft = {title: "", body: "", priority: Med, assignee: "", tags: ""}
slot commentDraft : Text = ""
slot tagDraft : Text = ""
slot themeName : Text = "Light"
slot storageError : Text = ""

theme Light = {
  colors: {bg: "#f6f8fa", fg: "#1f2328", surface: "#ffffff", muted: "#59636e", primary: "#0969da", danger: "#cf222e", success: "#1a7f37", warning: "#9a6700"},
  spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px"},
  radius: {sm: "4px", md: "8px"},
  typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px"}, weight: {normal: "400", bold: "700"}}
}

theme Dark = {
  colors: {bg: "#0d1117", fg: "#e6edf3", surface: "#161b22", muted: "#9da7b3", primary: "#58a6ff", danger: "#ff7b72", success: "#3fb950", warning: "#d29922"},
  spacing: {xs: "4px", sm: "8px", md: "16px", lg: "24px"},
  radius: {sm: "4px", md: "8px"},
  typography: {family: "system-ui, sans-serif", size: {sm: "14px", md: "16px", lg: "20px"}, weight: {normal: "400", bold: "700"}}
}

effect saveIssues cap=storage.write
  in=Map(IssueId, Issue)
  out=Result(Unit, Text)
  policy=debounce(300ms)
  map-request={key: "issues", value: $1}

effect saveComments cap=storage.write
  in=Map(Text, Comment)
  out=Result(Unit, Text)
  policy=debounce(300ms)
  map-request={key: "comments", value: $1}

effect loadIssues cap=storage.read
  in=Unit
  out=Result(Option(Map(IssueId, Issue)), Text)
  policy=once
  map-request={key: "issues", decode: Decoder.Json(Map(IssueId, Issue))}

effect loadComments cap=storage.read
  in=Unit
  out=Result(Option(Map(Text, Comment)), Text)
  policy=once
  map-request={key: "comments", decode: Decoder.Json(Map(Text, Comment))}

fn statusLabel(s: Status) -> Text = match s with
  | Open -> "Open"
  | InProgress -> "In Progress"
  | Done -> "Done"

fn priorityLabel(p: Priority) -> Text = match p with
  | Low -> "Low"
  | Med -> "Med"
  | High -> "High"

fn priorityColor(p: Priority) -> Text = match p with
  | Low -> "muted"
  | Med -> "warning"
  | High -> "danger"

fn statusOptions() -> List({label: Text, value: Status}) = [
  {label: "Open", value: Open},
  {label: "In Progress", value: InProgress},
  {label: "Done", value: Done}
]

fn priorityOptions() -> List({label: Text, value: Priority}) = [
  {label: "Low", value: Low},
  {label: "Med", value: Med},
  {label: "High", value: High}
]

fn filterStatusOptions() -> List({label: Text, value: Option(Status)}) = [
  {label: "All", value: None},
  {label: "Open", value: Some(Open)},
  {label: "In Progress", value: Some(InProgress)},
  {label: "Done", value: Some(Done)}
]

fn filterPriorityOptions() -> List({label: Text, value: Option(Priority)}) = [
  {label: "All", value: None},
  {label: "Low", value: Some(Low)},
  {label: "Med", value: Some(Med)},
  {label: "High", value: Some(High)}
]

fn matchesFilter(issue: Issue, f: FilterState) -> Bool =
  (match f.status with | None -> true | Some(s) -> issue.status == s) &&
  (match f.priority with | None -> true | Some(p) -> issue.priority == p) &&
  issue.title.lower.contains(f.search.trim.lower)

fn filteredIssues(allIssues: Map(IssueId, Issue), f: FilterState) -> List(IssueId) =
  allIssues.filter(matchesFilter($2, f)).entries.sort-by($2.updatedAt).reverse.map($1)

fn commentsForIssue(allComments: Map(Text, Comment), issueId: IssueId) -> List(Text) =
  allComments.filter($2.issueId == issueId).entries.sort-by($2.createdAt).map($1)

fn parseTags(value: Text) -> List(Text) =
  value.split(",").map($1.trim).filter(!$1.is-empty).unique

fn routeIssueId(current: Route) -> Option(IssueId) =
  IssueId.parse(current.params.get-or("id", ""))

reducer loadFromStorage on=app.start do=
  emit loadIssues()
  emit loadComments()

reducer issuesLoaded on=loadIssues.ok($data, _) do=
  issues := $data.get-or({})

reducer commentsLoaded on=loadComments.ok($data, _) do=
  comments := $data.get-or({})

reducer issuesLoadFailed on=loadIssues.err($error, _) do=
  storageError := $error

reducer commentsLoadFailed on=loadComments.err($error, _) do=
  storageError := $error

reducer issuesSaveFailed on=saveIssues.err($error, _) do=
  storageError := $error

reducer commentsSaveFailed on=saveComments.err($error, _) do=
  storageError := $error

reducer openNewIssue on=ui.click(NewIssueBtn) do=
  draft := {title: "", body: "", priority: Med, assignee: "", tags: ""}
  emit navigate({path: "/new"})

reducer createIssue on=ui.submit(NewIssueForm) do=
  if !draft.title.trim.is-empty then {
    let id = IssueId.fresh()
    let created = now
    issues[id] := {id: id, title: draft.title.trim, body: draft.body, status: Open, priority: draft.priority, assignee: draft.assignee.trim, tags: parseTags(draft.tags), createdAt: created, updatedAt: created}
    draft := {title: "", body: "", priority: Med, assignee: "", tags: ""}
    emit saveIssues(issues)
    emit navigate({path: "/issues/{id}", params: {"id": id.show}})
  }

reducer cancelNewIssue on=ui.click(CancelBtn) do=
  emit navigate({path: "/"})

reducer backToIssues on=ui.click(BackBtn) do=
  emit navigate({path: "/"})

reducer setFilterStatus on=ui.change(FilterStatus) do=
  filter.status := $event.value

reducer setFilterPriority on=ui.change(FilterPriority) do=
  filter.priority := $event.value

reducer setSearch on=ui.input(FilterSearch) do=
  filter.search := $event.value

reducer clearFilter on=ui.click(ClearFilterBtn) do=
  filter := {status: None, priority: None, search: ""}

reducer updateStatus on=ui.change(DetailStatus) do=
  issues[$el.issueId].status := $event.value
  issues[$el.issueId].updatedAt := now
  emit saveIssues(issues)

reducer updatePriority on=ui.change(DetailPriority) do=
  issues[$el.issueId].priority := $event.value
  issues[$el.issueId].updatedAt := now
  emit saveIssues(issues)

reducer updateAssignee on=ui.input(DetailAssignee) do=
  issues[$el.issueId].assignee := $event.value
  issues[$el.issueId].updatedAt := now
  emit saveIssues(issues)

reducer addTag on=ui.click(AddTagBtn) do=
  if !tagDraft.trim.is-empty then {
    issues[$el.issueId].tags := issues[$el.issueId].tags.push(tagDraft.trim).unique
    issues[$el.issueId].updatedAt := now
    tagDraft := ""
    emit saveIssues(issues)
  }

reducer removeTag on=ui.click(RemoveTagBtn) do=
  issues[$el.issueId].tags := issues[$el.issueId].tags.filter($1 != $el.tag)
  issues[$el.issueId].updatedAt := now
  emit saveIssues(issues)

reducer addComment on=ui.click(AddCommentBtn) do=
  if !commentDraft.trim.is-empty then {
    let id = Text.fresh()
    comments[id] := {id: id, issueId: $el.issueId, author: currentUser, body: commentDraft.trim, createdAt: now}
    commentDraft := ""
    emit saveComments(comments)
  }

reducer deleteComment on=ui.click(DeleteCommentBtn) do=
  comments := comments.remove($el.commentId)
  emit saveComments(comments)

reducer deleteIssue on=ui.click(DeleteIssueBtn) do=
  issues := issues.remove($el.issueId)
  comments := comments.filter($2.issueId != $el.issueId)
  tagDraft := ""
  commentDraft := ""
  emit saveIssues(issues)
  emit saveComments(comments)
  emit navigate({path: "/"})

reducer useLightTheme on=ui.click(LightBtn) do= themeName := "Light"
reducer useDarkTheme on=ui.click(DarkBtn) do= themeName := "Dark"

tile NewIssueBtn = button(text="New Issue") {bg: "primary"}
tile BackBtn = button(text="Back")
tile CancelBtn = button(text="Cancel", type="button")
tile ClearFilterBtn = button(text="Clear filters")

tile FilterStatus = select(value=filter.status, options=filterStatusOptions(), id="filter-status")
tile FilterPriority = select(value=filter.priority, options=filterPriorityOptions(), id="filter-priority")
tile FilterSearch = input(value=filter.search, id="filter-search", placeholder="Search titles")

tile FilterBar = column(
  row(
    column(label("Status") {for: "filter-status"}, FilterStatus) {gap: "xs"},
    column(label("Priority") {for: "filter-priority"}, FilterPriority) {gap: "xs"},
    column(label("Search") {for: "filter-search"}, FilterSearch) {gap: "xs"},
    ClearFilterBtn
  ) {gap: "md", align: "end"}
) {bg: "surface", pad: "md", radius: "md"}

tile IssueCard in=IssueId = card(
  column(
    link(issues[$1].title, to="/issues/" + $1.show) {size: "lg", weight: "bold"},
    row(
      text(statusLabel(issues[$1].status)) {color: "success"},
      text(priorityLabel(issues[$1].priority)) {color: priorityColor(issues[$1].priority)},
      text("Assignee: " + issues[$1].assignee) {color: "muted"}
    ) {gap: "md"},
    row(for tag in issues[$1].tags text(tag) {bg: "bg", pad: "xs", radius: "sm"}) {gap: "xs"},
    text("Created " + issues[$1].createdAt.format("yyyy-MM-dd HH:mm")) {color: "muted", size: "sm"}
  ) {gap: "sm"}
) {bg: "surface", pad: "md", radius: "md"}

tile IssueListPage = page(
  column(
    row(heading("Issues"), NewIssueBtn, link("Settings", to="/settings")) {gap: "md", align: "center"},
    when(!storageError.is-empty, text("Storage: " + storageError) {color: "danger"}),
    FilterBar,
    when(filteredIssues(issues, filter).is-empty, text("No issues")),
    column(for id in filteredIssues(issues, filter) IssueCard(id) {key: id.show}) {gap: "sm"}
  ) {gap: "md", pad: "lg"}
) {bg: "bg", color: "fg"}

tile NewIssueForm = form(
  column(
    label("Title") {for: "new-title"},
    input(bind=draft.title, id="new-title", placeholder="Issue title"),
    label("Description") {for: "new-body"},
    textarea(bind=draft.body, id="new-body", rows=6, placeholder="Describe the issue"),
    label("Priority") {for: "new-priority"},
    select(bind=draft.priority, options=priorityOptions(), id="new-priority"),
    label("Assignee") {for: "new-assignee"},
    input(bind=draft.assignee, id="new-assignee"),
    label("Tags (comma-separated)") {for: "new-tags"},
    input(bind=draft.tags, id="new-tags"),
    row(button(text="Create issue", type="submit") {bg: "primary"}, CancelBtn) {gap: "sm"}
  ) {gap: "sm", bg: "surface", pad: "md", radius: "md"}
)

tile NewIssuePage = page(
  column(heading("New issue"), NewIssueForm) {gap: "md", pad: "lg"}
) {bg: "bg", color: "fg"}

tile DetailStatus in=Issue = select(value=$1.status, options=statusOptions(), id="detail-status") {issueId: $1.id}
tile DetailPriority in=Issue = select(value=$1.priority, options=priorityOptions(), id="detail-priority") {issueId: $1.id}
tile DetailAssignee in=Issue = input(value=$1.assignee, id="detail-assignee") {issueId: $1.id}
tile AddTagBtn in=IssueId = button(text="Add tag") {issueId: $1}
tile RemoveTagBtn in={issueId: IssueId, tag: Text} = button(text="Remove tag") {issueId: $1.issueId, tag: $1.tag}
tile AddCommentBtn in=IssueId = button(text="Add comment") {issueId: $1}
tile DeleteCommentBtn in=Text = button(text="Delete comment") {commentId: $1}
tile DeleteIssueBtn in=IssueId = button(text="Delete issue") {issueId: $1, color: "danger"}

tile TagItem in={issueId: IssueId, tag: Text} = row(
  text($1.tag),
  RemoveTagBtn($1)
) {gap: "xs", bg: "bg", pad: "xs", radius: "sm"}

tile CommentItem in=Text = card(
  column(
    row(
      text(comments[$1].author) {weight: "bold"},
      text(comments[$1].createdAt.format("yyyy-MM-dd HH:mm")) {color: "muted", size: "sm"}
    ) {gap: "sm"},
    text(comments[$1].body),
    DeleteCommentBtn($1)
  ) {gap: "sm"}
) {bg: "surface", pad: "md", radius: "md"}

tile IssueContent in=Issue = column(
  row(BackBtn, heading($1.title), DeleteIssueBtn($1.id)) {gap: "md", align: "center"},
  row(
    column(label("Status") {for: "detail-status"}, DetailStatus($1)) {gap: "xs"},
    column(label("Priority") {for: "detail-priority"}, DetailPriority($1)) {gap: "xs"},
    column(label("Assignee") {for: "detail-assignee"}, DetailAssignee($1)) {gap: "xs"}
  ) {gap: "md"},
  card(column(heading("Description", level=2), text($1.body)) {gap: "sm"}) {bg: "surface", pad: "md", radius: "md"},
  column(
    heading("Tags", level=2),
    row(for tag in $1.tags TagItem({issueId: $1.id, tag: tag}) {key: tag}) {gap: "sm"},
    row(input(bind=tagDraft, id="tag-input", placeholder="Add a tag"), AddTagBtn($1.id)) {gap: "sm"}
  ) {gap: "sm"},
  row(
    text("Created " + $1.createdAt.format("yyyy-MM-dd HH:mm")),
    text("Updated " + $1.updatedAt.format("yyyy-MM-dd HH:mm"))
  ) {gap: "md", color: "muted"},
  column(
    heading("Comments", level=2),
    column(for id in commentsForIssue(comments, $1.id) CommentItem(id) {key: id}) {gap: "sm"},
    row(input(bind=commentDraft, id="comment-input", placeholder="Write a comment"), AddCommentBtn($1.id)) {gap: "sm"}
  ) {gap: "sm"}
) {gap: "md", pad: "lg"}

tile IssueById in=IssueId = match issues.get($1) with
  | Some(issue) -> IssueContent(issue)
  | None -> NotFound

tile IssueDetailPage = page(
  match routeIssueId(route) with
    | Some(id) -> IssueById(id)
    | None -> NotFound
) {bg: "bg", color: "fg"}

tile LightBtn = button(text="Light")
tile DarkBtn = button(text="Dark")
tile SettingsPage = page(
  column(
    BackBtn,
    heading("Settings"),
    heading("Theme", level=2),
    text("Current theme: " + themeName),
    row(LightBtn, DarkBtn) {gap: "sm"}
  ) {gap: "md", pad: "lg"}
) {bg: "bg", color: "fg"}

tile NotFound = column(
  heading("Not found"),
  text("This issue or page could not be found."),
  BackBtn
) {gap: "md", pad: "lg"}

app IssueTracker
  caps=[storage.read, storage.write, nav.push]
  routes={"/" -> IssueListPage, "/issues/:id" -> IssueDetailPage, "/new" -> NewIssuePage, "/settings" -> SettingsPage, "/404" -> NotFound}
  init=[]
  theme=themeName
