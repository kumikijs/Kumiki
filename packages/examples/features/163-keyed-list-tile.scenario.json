{
  "steps": [
    {
      "label": "a keyed call to a for-bodied tile renders every node of its list",
      "expect": {
        "noErrors": true,
        "domIncludes": ["tag:a", "tag:b", "x/x1", "x/x2", "y/y1", "end"]
      }
    },
    {
      "label": "reordering the outer list keeps every node of each group",
      "do": { "clickText": "flip" },
      "expect": {
        "noErrors": true,
        "state": {
          "groups": [{ "name": "y", "tags": ["y1"] }, { "name": "x", "tags": ["x1", "x2"] }]
        },
        "domIncludes": ["x/x1", "x/x2", "y/y1"]
      }
    },
    {
      "label": "reordering the list inside the explicitly keyed call keeps every tag",
      "do": { "clickText": "swap" },
      "expect": {
        "noErrors": true,
        "state": { "tags": ["b", "a"] },
        "domIncludes": ["tag:a", "tag:b"]
      }
    }
  ]
}
