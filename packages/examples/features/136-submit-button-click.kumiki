# Feature (forms.md §5.2.2): a click reducer on a submit button and the
# form's `ui.submit` are independent — clicking "Log in" runs both. So does a
# click reducer lifted onto the button from a tile that wraps it (`Outer`), an
# `onClick=` argument, and a button with no `type`, which is `submit` by the
# HTML default. A `type="button"` button with a click reducer does not submit:
# `type` is what keeps a button in a form from submitting it.

slot email   : Text = ""
slot clicks  : Int  = 0
slot submits : Int  = 0

reducer clicked    on=ui.click(LoginBtn)   do= clicks := clicks + 1
reducer doLogin    on=ui.submit(LoginForm) do= submits := submits + 1
reducer wrapped    on=ui.click(Outer)      do= clicks := clicks + 10
reducer doWrap     on=ui.submit(WrapForm)  do= submits := submits + 10
reducer argClick   on=ui.click(ArgBtn)     do= clicks := clicks + 100
reducer doArg      on=ui.submit(ArgForm)   do= submits := submits + 100
reducer cancel     on=ui.click(CancelBtn)  do= clicks := clicks + 1000
reducer plainClick on=ui.click(PlainBtn)   do= clicks := clicks + 10000
reducer doPlain    on=ui.submit(PlainForm) do= submits := submits + 10000

tile LoginBtn  = button(text="Log in", type="submit")
tile LoginForm = form(column(input(bind=email, id="em"), LoginBtn, CancelBtn))
tile CancelBtn = button(text="Cancel", type="button")

tile InnerBtn = button(text="Wrapped", type="submit")
tile Outer    = box(InnerBtn)
tile WrapForm = form(Outer)

tile ArgBtn  = button(text="By arg", type="submit", onClick=argClick)
tile ArgForm = form(ArgBtn)

tile PlainBtn  = button(text="No type")
tile PlainForm = form(PlainBtn)

tile App = column(LoginForm, WrapForm, ArgForm, PlainForm, text("clicks=" + clicks.show + " submits=" + submits.show))

app SubmitButtonClick
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
