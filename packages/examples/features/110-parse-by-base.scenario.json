{
  "steps": [
    {
      "label": "nothing parsed yet",
      "expect": {
        "noErrors": true,
        "state": {
          "total": 12,
          "wait": 100,
          "quiet": { "_tag": "None" },
          "below": { "_tag": "Some", "_0": 1 }
        },
        "domIncludes": ["total 12", "wait 100ms", "quiet unset", "slug unset", "below 1"]
      }
    },
    {
      "label": "a nominal Int parses to a number, so the sum adds",
      "do": { "click": "#add" },
      "expect": { "noErrors": true, "state": { "total": 24 }, "domIncludes": ["total 24"] }
    },
    {
      "label": "a Duration parses to milliseconds, so the sum adds",
      "do": { "click": "#extend" },
      "expect": { "noErrors": true, "state": { "wait": 600 }, "domIncludes": ["wait 600ms"] }
    },
    {
      "label": "false is false, and a nominal Text keeps its text",
      "do": { "click": "#read" },
      "expect": {
        "noErrors": true,
        "state": {
          "quiet": { "_tag": "Some", "_0": false },
          "slug": { "_tag": "Some", "_0": "a-b" }
        },
        "domIncludes": ["quiet off", "slug a-b"]
      }
    },
    {
      "label": "a reading the refinement refuses is None",
      "do": { "click": "#refuse" },
      "expect": {
        "noErrors": true,
        "state": { "below": { "_tag": "None" } },
        "domIncludes": ["below refused"]
      }
    }
  ]
}
