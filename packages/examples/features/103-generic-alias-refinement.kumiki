# Feature: a refinement written on a generic alias gates the slot the generic
# declares (spec/language.md §1.3.1, §1.3.6 inv. 2).
#
# `NonEmpty(T)` hands its parameter back with a `where` on it, so
# `NonEmpty(Text)` is `Text where nonempty` and `NonEmpty(Short)` carries
# Short's `len-lt(7)` first and then `nonempty` — the generic is an edge of the
# chain the type denotes, exactly as an alias is. Codegen used to stop at the
# application and emit no check at all, so `name := ""` landed on a slot whose
# type says it cannot be empty, with `check` and `build` both silent (#439).
#
# Each button's first click writes a value the type accepts, and every click
# after that one it refuses: `smoke` clicks once and treats any reported error
# as fatal, and the scenario beside this file clicks again and asserts the
# refusal — the write is discarded and the predicate it failed is named.

type NonEmpty(T) = T where nonempty
type Short       = Text where len-lt(7)

slot name : NonEmpty(Text)  = "ada"
slot tag  : NonEmpty(Short) = "ku"

reducer clearName on=ui.click(ClearBtn) do= name := if name == "ada" then "grace" else ""
reducer growTag   on=ui.click(GrowBtn)  do= tag := tag + "kiki"

tile ClearBtn = button(text="rename", onClick=clearName)
tile GrowBtn  = button(text="grow",   onClick=growTag)

tile App = column(
             heading("name: " + name),
             text("tag: " + tag),
             row(ClearBtn, GrowBtn) {gap: "sm"})
           {pad: "lg", gap: "md"}

app GenericAliasRefinement
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []

# A refused write leaves every slot at its `given` value in this tier.

test clearing-the-name-is-refused =
    reducer-test clearName
        given  = {slots: {name: "grace"}, event: {type: ui.click, target: ClearBtn}}
        expect = {slots: {name: "grace"}, effects: []}

test tag-past-its-bound-is-refused =
    reducer-test growTag
        given  = {slots: {tag: "kukiki"}, event: {type: ui.click, target: GrowBtn}}
        expect = {slots: {tag: "kukiki"}, effects: []}
