# Feature: a conditional whose later branch *adds* a universally-lifted handler.
#
# `onFocus` / `onBlur` / `onKeyDown` / `onMouseEnter` are lifted onto every tile
# kind by the runtime rather than by a per-kind renderer, and they dispatch
# through one shared per-element slot. The native listeners that read that slot
# were registered only when the tile carried a handler at create time — so a
# branch that introduces one later had nowhere to land: the element is reused,
# the slot is refreshed with the new handler, and no listener was ever
# registered to read it.
#
# The neighbouring case (62) swaps one handler for another. That was fixed
# earlier and works now, which is what made this one hard to see from the
# outside: both are "a conditional that changes a handler", and only one of
# them fired.
#
# `onClick` is unaffected — its listener is registered unconditionally by the
# button renderer. All four are wired here, and the scenario fires all four
# through the DOM.
#
# The log below is the assertion. Firing any of the four before the branch
# arms must do nothing; firing them after it must reach the reducers.

slot armed : Bool = false
slot log   : Text = ""

reducer arm     on=ui.click(ArmBtn) do= armed := true
reducer noted   on=ui.focus(Field)  do= log := log + "F"
reducer left    on=ui.blur(Field)   do= log := log + "B"
reducer typed   on=ui.key(Field)    do= log := log + "K"
reducer hovered on=ui.hover(Field)  do= log := log + "M"

tile ArmBtn = button(text="arm", onClick=arm)

# `Field` is declared and never rendered. What actually fires the reducers is
# the inline `input` below naming all four through `onFocus=` / `onBlur=` /
# `onKeyDown=` / `onMouseEnter=`; the implicit subscription `ui.focus(Field)`
# sets up matches on the enclosing rendered tile, which is `App`, so it never
# fires at all. `Field` exists so those selectors have a name to resolve — and
# its *kind* matters too: `ui.focus` / `ui.blur` / `ui.key` only lift onto
# input-like tiles, so a `text` here would be W0212 "the handler is silently
# dropped". `ui.hover` is not restricted that way and would be content with
# any kind.
tile Field = input(value="")

tile App = column(
             ArmBtn,
             if armed then input(value="", onFocus=noted, onBlur=left,
                                          onKeyDown=typed, onMouseEnter=hovered)
                      else input(value=""),
             text("log=[" + log + "] armed=" + armed.show))
           {pad: "lg", gap: "sm"}

app ConditionalAddsUniversalHandler
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
