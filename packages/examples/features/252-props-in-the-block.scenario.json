{
  "steps": [
    {
      "label": "the page starts on the slot's value",
      "expect": { "noErrors": true, "domIncludes": ["picked: a"] }
    },
    {
      "label": "the options the block supplies can be chosen",
      "do": { "choose": "#fruit", "value": "Pear" },
      "expect": { "noErrors": true, "state": { "pick": "p" }, "domIncludes": ["picked: p"] }
    },
    {
      "label": "show sets the slot the note's block reads",
      "do": { "click": "#show" },
      "expect": { "noErrors": true, "state": { "showing": true } }
    },
    {
      "label": "and hide clears it",
      "do": { "click": "#hide" },
      "expect": { "noErrors": true, "state": { "showing": false } }
    }
  ]
}
