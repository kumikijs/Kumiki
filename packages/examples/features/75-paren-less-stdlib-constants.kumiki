# Feature: stdlib constants written without parentheses.
# `Decoder.Text` / `Decoder.Bytes` / `Decoder.None` and `EffectId.none` read
# as values, and the spec writes them bare. What the compiler reads is a call
# given no arguments — the constant is what a member with no arguments to take
# evaluates to. Every constant below is in the bare form on purpose.
#
# A request with no decoder is decoded as JSON, so a decoder that lowered to
# nothing would parse the body. Each response here is one JSON cannot decode:
# `kumiki`, `日本語`, and a 204 with no body at all. No effect declares an
# `.err` reducer, deliberately: an error the app does not consume is what
# `kumiki smoke` reports, so a wrong lowering fails there and not only in a
# unit test.
#
# `Decoder.Bytes` delivers the body's bytes, as `Bytes`. `日本語` is three
# characters and nine UTF-8 bytes, and `raw` shows the value one number per
# byte: nine numbers, where a text would show its three characters.

slot handle : EffectId = EffectId.none
slot note   : Text     = "idle"
slot pinged : Bool     = false
slot raw    : Text     = ""

effect loadNote  cap=http.get
                 in=Unit
                 out=Result(Text, HttpError)
                 policy=latest
                 map-request={url: "/api/note", decode: Decoder.Text}

effect ping      cap=http.post
                 in=Unit
                 out=Result(Unit, HttpError)
                 map-request={url: "/api/ping", body: Empty, decode: Decoder.None}

effect loadRaw   cap=http.get
                 in=Unit
                 out=Result(Bytes, HttpError)
                 map-request={url: "/api/raw", decode: Decoder.Bytes}

effect drop      cap=http.cancel in=EffectId out=Unit

reducer load    on=ui.click(LoadBtn)      do= let h = emit loadNote()
                                              handle := h
                                              emit ping()
                                              emit loadRaw()
reducer noteOk  on=loadNote.ok($body, _)  do= note   := $body
                                              handle := EffectId.none
reducer pingOk  on=ping.ok(_, _)          do= pinged := true
reducer rawOk   on=loadRaw.ok($bytes, _)  do= raw    := $bytes.show
reducer cancel  on=ui.click(CancelBtn)    do= emit drop(handle)
                                              handle := EffectId.none

tile LoadBtn   = button(text="Load", onClick=load)
tile CancelBtn = button(text="Cancel", onClick=cancel)
tile App = column(
             LoadBtn,
             CancelBtn,
             text("note: " + note),
             text("pinged: " + pinged.show),
             text("raw: " + raw))
           {pad: "lg", gap: "md"}

app ParenLessStdlibConstants
    caps   = [http.get, http.post, http.cancel]
    routes = {"/" -> App, "/404" -> App}
    init   = []
