# Feature: stdlib constants written without parentheses.
# `Decoder.Text` / `Decoder.Bytes` / `Decoder.None` (http.md §6.1.4) and
# `EffectId.none` (stdlib.md §2.1.1.1) are values, not calls, and the spec
# writes them bare. Written that way they used to parse as a field read on a
# variant named after the qualifier and emit `undefined` — invisible at run
# time, because the built-in HTTP handler ignores every decoder except `json`.
# Every constant below is in the bare form on purpose.

slot handle : EffectId = EffectId.none
slot note   : Text     = "idle"
slot blob   : Int      = 0
slot pinged : Bool     = false

effect loadNote  cap=http.get
                 in=Unit
                 out=Result(Text, HttpError)
                 policy=latest
                 map-request={url: "/api/note", decode: Decoder.Text}

effect loadBlob  cap=http.get
                 in=Unit
                 out=Result(Bytes, HttpError)
                 map-request={url: "/api/blob", decode: Decoder.Bytes}

effect ping      cap=http.post
                 in=Unit
                 out=Result(Unit, HttpError)
                 map-request={url: "/api/ping", body: Empty, decode: Decoder.None}

effect drop      cap=http.cancel in=EffectId out=Unit

reducer load    on=ui.click(LoadBtn)      do= let h = emit loadNote()
                                              handle := h
                                              emit loadBlob()
                                              emit ping()
reducer noteOk  on=loadNote.ok($body, _)  do= note   := $body
                                              handle := EffectId.none
reducer noteErr on=loadNote.err(_, _)     do= note   := "failed"
                                              handle := EffectId.none
reducer blobOk  on=loadBlob.ok($body, _)  do= blob   := $body.length
reducer pingOk  on=ping.ok(_, _)          do= pinged := true
reducer cancel  on=ui.click(CancelBtn)    do= emit drop(handle)
                                              handle := EffectId.none

tile LoadBtn   = button(text="Load", onClick=load)
tile CancelBtn = button(text="Cancel", onClick=cancel)
tile App = column(
             LoadBtn,
             CancelBtn,
             text("note: " + note),
             text("blob: " + blob.show),
             text("pinged: " + pinged.show))
           {pad: "lg", gap: "md"}

app ParenLessStdlibConstants
    caps   = [http.get, http.post, http.cancel]
    routes = {"/" -> App, "/404" -> App}
    init   = []
