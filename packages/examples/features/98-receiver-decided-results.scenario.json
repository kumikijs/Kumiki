{
  "steps": [
    {
      "label": "nothing read yet",
      "expect": {
        "noErrors": true,
        "state": { "first": { "_tag": "None" }, "count": 0, "found": false }
      }
    },
    {
      "label": "head answers an Option of the element, and a non-empty list gives a Some",
      "do": { "click": "#head" },
      "expect": {
        "noErrors": true,
        "state": { "first": { "_tag": "Some", "_0": 3 } },
        "domIncludes": ["first: 3"]
      }
    },
    {
      "label": "keys answers a List of the key type, so two entries give two keys",
      "do": { "click": "#keys" },
      "expect": {
        "noErrors": true,
        "state": { "keys": ["ada", "bea"] },
        "domIncludes": ["keys: 2"]
      }
    },
    {
      "label": "sort answers the receiver's own type back",
      "do": { "click": "#sort" },
      "expect": { "noErrors": true, "state": { "sorted": [1, 2, 3] }, "domIncludes": ["sorted: 3"] }
    },
    {
      "label": "to-list crosses from a Set to a List of the same element",
      "do": { "click": "#listed" },
      "expect": { "noErrors": true, "state": { "listed": [7, 8] }, "domIncludes": ["listed: 2"] }
    },
    {
      "label": "get-err answers the error type, not the ok type",
      "do": { "click": "#err" },
      "expect": {
        "noErrors": true,
        "state": { "reason": "not a number" },
        "domIncludes": ["reason: not a number"]
      }
    },
    {
      "label": "a fixed Int and a fixed Bool, whatever the receiver's arguments are",
      "do": { "click": "#count" },
      "expect": {
        "noErrors": true,
        "state": { "count": 2, "found": true },
        "domIncludes": ["count: 2", "found: true"]
      }
    },
    {
      "label": "the Option is unwrapped where an Int is wanted, rather than assumed",
      "do": { "click": "#unwrap" },
      "expect": { "noErrors": true, "state": { "count": 3 }, "domIncludes": ["count: 3"] }
    }
  ]
}
