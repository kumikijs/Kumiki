{
  "steps": [
    {
      "label": "the pair starts at its declared value",
      "expect": { "noErrors": true, "domIncludes": ["pair: a -1", "hits: 0"] }
    },
    {
      "label": "put writes the pair back and counts the write",
      "do": { "click": "#put" },
      "expect": {
        "noErrors": true,
        "domIncludes": ["pair: a -1", "hits: 1"],
        "state": { "pair": ["a", -1], "hits": 1 }
      }
    },
    {
      "label": "lower moves the second half further below zero",
      "do": { "click": "#lower" },
      "expect": {
        "noErrors": true,
        "domIncludes": ["pair: a -2", "hits: 1"],
        "state": { "pair": ["a", -2], "hits": 1 }
      }
    }
  ]
}
