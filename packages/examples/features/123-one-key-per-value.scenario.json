{
  "steps": [
    {
      "label": "adding one variant to a Set leaves the others out",
      "do": { "click": "#red" },
      "expect": { "noErrors": true, "domIncludes": ["picked: 1 red=true green=false blue=false"] }
    },
    {
      "label": "toggling another variant adds it beside the first",
      "do": { "click": "#green" },
      "expect": { "noErrors": true, "domIncludes": ["picked: 2 red=true green=true blue=false"] }
    },
    {
      "label": "an index write counts one variant",
      "do": { "click": "#vote-red" },
      "expect": { "noErrors": true, "domIncludes": ["votes: 1 red=1 green=0 blue=0"] }
    },
    {
      "label": "an insert counts another, separately",
      "do": { "click": "#vote-green" },
      "expect": { "noErrors": true, "domIncludes": ["votes: 2 red=1 green=1 blue=0"] }
    },
    {
      "label": "a record key is one entry whatever order its fields were written in",
      "do": { "click": "#mark" },
      "expect": { "noErrors": true, "domIncludes": ["cells: 2 above=above! origin=origin"] }
    },
    {
      "label": "the readers hand structured keys back as the values they were written from",
      "do": { "click": "#read" },
      "expect": {
        "noErrors": true,
        "state": {
          "pickedList": [{ "_tag": "Red" }, { "_tag": "Green" }],
          "voteKeys": [{ "_tag": "Red" }, { "_tag": "Green" }],
          "cellPairs": [[{ "x": 0, "y": 0 }, "origin"], [{ "x": 0, "y": 1 }, "above!"]]
        }
      }
    },
    {
      "label": "remove takes out the entry that add and insert put in, whatever the key's type",
      "do": { "click": "#remove" },
      "expect": {
        "noErrors": true,
        "domIncludes": [
          "picked: 1 red=false green=true",
          "votes: 1 red=1 green=0",
          "items: 1 has1=false",
          "nums: 1 has1=false",
          "ids: 1 has1=false",
          "flags: 1 true=false",
          "words: 1 x=false"
        ]
      }
    }
  ]
}
