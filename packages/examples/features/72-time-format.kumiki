# Feature: `Time.format(pattern)` renders an instant the way the caller asked.
#
# A `Time` is a millisecond number, and `format` is the only way to show one.
# The pattern was ignored: whatever was written, the ISO date came back — so
# "yyyy-MM-dd HH:mm" lost its time, and the date was the UTC one rather than
# the reader's. `yyyy MM dd HH mm ss` are the fields; everything else in the
# pattern is copied through, and the fields are the reader's local ones.
#
# The instant is parsed from a fixed string rather than taken from `Time.now`,
# so what renders depends only on the formatter.
#
# Two things the pattern does NOT do: it has no escape, so a token inside a
# word is still a token (`"summer dd"` renders `su05er 14`); and text that
# names no instant is `None` rather than a date — the arm below renders it.

slot iso  : Text = "2026-08-14T21:05:09"
slot junk : Text = "not a date"

fn at(text: Text) -> Option(Time) = Time.parse(text)
fn ymd(t: Time)  -> Text = t.format("yyyy-MM-dd")
fn stamp(t: Time) -> Text = t.format("yyyy-MM-dd HH:mm")
fn wordy(t: Time) -> Text = t.format("dd/MM/yyyy")
fn junkDay(s: Text) -> Text = match at(s) with | Some(t) -> ymd(t) | None -> "none"
# `mm` is a token wherever it appears, including inside `summer`.
fn shown(s: Text) -> Text = match at(s) with | Some(t) -> t.format("summer dd") | None -> "?"

tile App = column(
             match at(iso) with
             | Some(t) -> column(
                            text("ymd: " + ymd(t)),
                            text("stamp: " + stamp(t)),
                            text("wordy: " + wordy(t)),
                            text("year: " + t.format("yyyy")),
                            text("literal: " + t.format("[on] dd")))
             | None -> text("unparsed"),
             text("junk: " + junkDay(junk)),
             text("literal: " + shown(iso)))

app TimeFormat
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
