{
  "steps": [
    {
      "label": "both 28-deep nests render a node per outer and inner element, in order",
      "expect": {
        "noErrors": true,
        "domIncludes": ["a/1a/2b/1b/2", "a.1a.2b.1b.2"]
      }
    },
    {
      "label": "reversing the outermost list moves both nests' nodes into the new order",
      "do": { "click": "#flip-outer" },
      "expect": {
        "noErrors": true,
        "state": { "outer": ["b", "a"] },
        "domIncludes": ["b/1b/2a/1a/2", "b.1b.2a.1a.2"]
      }
    },
    {
      "label": "reversing the innermost list moves both nests' nodes into the new order",
      "do": { "click": "#flip-inner" },
      "expect": {
        "noErrors": true,
        "state": { "inner": ["2", "1"] },
        "domIncludes": ["b/2b/1a/2a/1", "b.2b.1a.2a.1"]
      }
    }
  ]
}
