# Feature: every field of `PanicInfo` is a value a program can read
# (spec/lifecycle.md §7.2.3).
#
# A panic reaches a program two ways — an `error-boundary` fallback takes it as
# `$1`, and an `app.error` reducer takes it as `$event` — and both are given the
# same five fields. This example reads all five on both paths, side by side, so
# a field that stopped being supplied on one of them shows up as a difference
# on the page rather than as the word `undefined` inside a sentence.
#
# `episode-id` is the join to the episode log: it names the episode the panic
# happened in, which is what `kumiki replay` / `kumiki_episode_tail` read. It is
# `Option(Text)` because an episode is not always open — a host that attached no
# episode logger has none to name, which is what this example shows (`kumiki
# run` attaches none, so both paths report `(none)` here). `cause` is the
# nearest `Error.cause` message when the throw carried one; the full chain, and
# the stack with it, stays in the episode log.
#
# The `app.error` half is driven by entering `/boom` rather than by a button.
# A reducer panic is reported on the error channel by design (§7.3: the
# verification tiers watch it), and `smoke` drives every button and fails on
# anything that reaches that channel. A scenario can claim the error with
# `errorIncludes`; `smoke` never navigates, so the route is its own arming.

slot secret      : Option(Text) = None
slot breakRender : Bool         = false

slot caught      : Text         = "-"
slot caughtAt    : Text         = "-"
slot caughtCat   : Text         = "-"
slot caughtEp    : Option(Text) = None
slot caughtCause : Option(Text) = None

# `secret` is None, so `.get` panics — the controlled signal §7.2.2 defines.
# Under `Guarded` that is a render panic the boundary catches; inside a reducer
# body it rolls the dispatch back and fires `app.error`.
tile Body = column(when(breakRender, text("secret: " + secret.get)))

tile Guarded
    error-boundary = Fallback
    = column(
        text("guarded: ready"),
        Body)

tile Fallback
    in=PanicInfo
    = column(
        text("fallback message: " + $1.message),
        text("fallback location: " + $1.location),
        text("fallback category: " + $1.category),
        text("fallback episode: " + $1.episode-id.get-or("(none)")),
        text("fallback cause: " + $1.cause.get-or("(none)")))
      {color: "danger"}

tile BreakRenderBtn = button(text="break render", onClick=breakRenderNow) {id: "break-render"}

tile App
    = column(
        heading("PanicInfo fields"),
        Guarded,
        BreakRenderBtn,
        text("error message: " + caught),
        text("error location: " + caughtAt),
        text("error category: " + caughtCat),
        text("error episode: " + caughtEp.get-or("(none)")),
        text("error cause: " + caughtCause.get-or("(none)")))
      {pad: "lg", gap: "md"}

reducer breakRenderNow on=ui.click(BreakRenderBtn) do= breakRender := true

reducer breakOnEnter on=route.enter("/boom") do= caught := secret.get

reducer onPanic
    on=app.error
    do= caught      := $event.message
        caughtAt    := $event.location
        caughtCat   := $event.category
        caughtEp    := $event.episode-id
        caughtCause := $event.cause

app PanicInfoFields
    caps   = []
    routes = {"/" -> App, "/boom" -> App, "/404" -> App}
    init   = []
