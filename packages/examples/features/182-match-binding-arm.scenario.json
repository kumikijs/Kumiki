{
  "steps": [
    {
      "label": "Blue is no arm's variant, so the binding arm takes it and names it",
      "expect": {
        "noErrors": true,
        "domIncludes": ["swatch: Blue", "label: Blue", "points: 0", "alarm: false", "seen: "]
      }
    },
    {
      "label": "the reducer's value and statement matches take the binding arm too, and read it",
      "do": { "click": "#judge" },
      "expect": {
        "noErrors": true,
        "state": { "points": 2, "alarm": false, "seen": "Blue" },
        "domIncludes": ["points: 2", "alarm: false", "seen: Blue"]
      }
    },
    {
      "label": "Red is the first arm's, in every match",
      "do": { "click": "#paint" },
      "expect": {
        "noErrors": true,
        "state": { "color": { "_tag": "Red" } },
        "domIncludes": ["swatch: red", "label: stop"]
      }
    },
    {
      "label": "the Red arm's night | rain is a bool OR that rain decides, ended by the arm after it",
      "do": { "click": "#judge" },
      "expect": {
        "noErrors": true,
        "state": { "points": 10, "alarm": true, "seen": "Blue" },
        "domIncludes": ["points: 10", "alarm: true"]
      }
    }
  ]
}
