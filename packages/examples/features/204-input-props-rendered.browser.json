{
  "steps": [
    {
      "label": "the fieldsets are real <fieldset>s, and the slider starts at the slot's value",
      "expect": {
        "noErrors": true,
        "visible": ["I agree to the terms", "Terms", "Mode: a"],
        "elementState": {
          "[data-kumiki-tile='fieldset']": { "tagName": "FIELDSET" },
          "input[type='range']": { "value": "10" }
        }
      }
    },
    {
      "label": "a reducer that writes the slot moves the thumb",
      "do": { "clickText": "Louder" },
      "expect": {
        "noErrors": true,
        "state": { "vol": 20 },
        "elementState": { "input[type='range']": { "value": "20" } }
      }
    },
    {
      "label": "a reducer that caps what the slider wrote moves the thumb back, though the slider keeps focus",
      "do": { "fill": "input[type='range']", "value": "80" },
      "expect": {
        "noErrors": true,
        "state": { "vol": 50 },
        "focused": "input[type='range']",
        "elementState": { "input[type='range']": { "value": "50" } }
      }
    }
  ]
}
