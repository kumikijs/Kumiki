{
  "steps": [
    {
      "label": "ui.focus: DOM focus event on NameInput fires onFocus reducer",
      "do": { "focus": "#name-input" },
      "expect": { "noErrors": true, "state": { "focusedField": "name" } }
    },
    {
      "label": "ui.blur: first DOM blur event increments blurCount to 1",
      "do": { "blur": "#name-input" },
      "expect": { "noErrors": true, "state": { "blurCount": 1 } }
    },
    {
      "label": "ui.blur: second DOM blur event increments to 2",
      "do": { "blur": "#name-input" },
      "expect": { "noErrors": true, "state": { "blurCount": 2 } }
    }
  ]
}
