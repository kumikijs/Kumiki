{
  "steps": [
    {
      "label": "the app starts at zero",
      "expect": {
        "noErrors": true,
        "state": { "count": 0 },
        "domIncludes": ["n=0"]
      }
    },
    {
      "label": "the renamed reducer runs on a click",
      "do": { "clickText": "+" },
      "expect": {
        "noErrors": true,
        "state": { "count": 1 },
        "domIncludes": ["n=1"]
      }
    }
  ]
}
