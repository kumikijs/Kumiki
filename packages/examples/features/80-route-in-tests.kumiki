# Feature (testing.md §8): a reducer that reads the router-maintained `route`
# slot is testable. `route` is the runtime's slot — no program declares one —
# so the harness seeds it exactly as `mount` does, and a test may replace it
# through `given.slots`, naming only the fields it cares about.

slot seen  : Text = ""
slot at    : Text = ""

reducer noticed  on=ui.click(Go) do= seen := route.path
reducer patterned on=ui.click(Go) do= at := route.pattern + "#" + route.params.get-or("id", "-")

tile Go    = button(text="go")
tile Where = text("at " + route.path)

tile App
    = column(
        heading("the route slot in tests"),
        Go,
        Where,
        text("seen: " + seen),
        text("at: " + at))
      {pad: "lg", gap: "md"}

app RouteInTests
    caps   = []
    routes = {"/" -> App, "/posts/:id" -> App, "/404" -> App}
    init   = []

# Naming no route at all: the reducer runs against the same empty route a fresh
# mount starts from, rather than panicking on an absent slot.
test route-defaults-to-empty =
    reducer-test noticed
        given  = {slots: {seen: ""}, event: {type: ui.click, target: Go}}
        expect = {slots: {seen: "/"}}

test seeded-route-drives-reducer =
    reducer-test patterned
        given  = {slots: {at: "",
                          route: {path: "/posts/7", pattern: "/posts/:id",
                                  params: {"id": "7"}, query: {}, hash: None}},
                  event: {type: ui.click, target: Go}}
        expect = {slots: {at: "/posts/:id#7"}}

# A route named in part takes the empty route's values for the rest, so an
# abbreviation cannot hand the reducer an undefined field.
test partial-route-takes-defaults =
    reducer-test patterned
        given  = {slots: {at: "", route: {path: "/posts/7"}},
                  event: {type: ui.click, target: Go}}
        expect = {slots: {at: "/#-"}}

# `expect.slots` compares only the keys it names, so the seeded route is
# assertable without every other test having to mention one.
test seeded-route-is-comparable =
    reducer-test noticed
        given  = {slots: {seen: "", route: {path: "/posts/7"}},
                  event: {type: ui.click, target: Go}}
        expect = {slots: {seen: "/posts/7", route: {path: "/posts/7", pattern: "/",
                                                    params: {}, query: {}, hash: None}}}

# The same seam serves a tile-test: the tile reads the slot, not an argument.
test tile-reads-the-route =
    tile-test Where
        given  = {slots: {route: {path: "/posts/7"}}}
        expect = text("at /posts/7")

# ...and `run-reducer` inside a property test, where step two starts from step
# one's output.
test run-reducer-sees-route =
    property-test
        for-all  = {n: Int}
        given    = {slots: {seen: "", route: {path: "/posts/7"}},
                    event: {type: ui.click, target: Go}}
        invariant = run-reducer(noticed).run-reducer(noticed).slots.seen == "/posts/7"
