{
  "steps": [
    {
      "label": "initial render — none of the three has fired",
      "expect": {
        "noErrors": true,
        "state": { "keys": 0, "focuses": 0, "blurs": 0 },
        "domIncludes": ["keys: 0", "focuses: 0", "blurs: 0"]
      }
    },
    {
      "label": "focusing the editable runs the ui.focus reducer",
      "do": { "focus": "#ed" },
      "expect": {
        "noErrors": true,
        "state": { "focuses": 1, "keys": 0, "blurs": 0 },
        "domIncludes": ["focuses: 1"]
      }
    },
    {
      "label": "a keystroke runs the ui.key reducer, and only that one",
      "do": { "key": "#ed", "value": "a" },
      "expect": {
        "noErrors": true,
        "state": { "keys": 1, "focuses": 1, "blurs": 0 },
        "domIncludes": ["keys: 1"]
      }
    },
    {
      "label": "a second keystroke counts again — the handler is not a one-shot",
      "do": { "key": "#ed", "value": "b" },
      "expect": { "noErrors": true, "state": { "keys": 2, "focuses": 1, "blurs": 0 } }
    },
    {
      "label": "typing still writes the bind — ui.input coexists with the three, and moves none of them",
      "do": { "fill": "#ed", "value": "abc" },
      "expect": {
        "noErrors": true,
        "state": { "note": "abc", "keys": 2, "focuses": 1, "blurs": 0 },
        "domIncludes": ["note: abc"]
      }
    },
    {
      "label": "leaving the editable runs the ui.blur reducer",
      "do": { "blur": "#ed" },
      "expect": {
        "noErrors": true,
        "state": { "blurs": 1, "keys": 2, "focuses": 1 },
        "domIncludes": ["blurs: 1"]
      }
    },
    {
      "label": "a keystroke on another tile does not count — keydown bubbles, so this also catches a handler lifted onto the enclosing column",
      "do": { "key": "#away", "value": "c" },
      "expect": { "noErrors": true, "state": { "keys": 2, "focuses": 1, "blurs": 1 } }
    },
    {
      "label": "focusing another tile does not count — button is itself in the focus lift set, so this catches codegen gating on tile kind instead of on the selector's tile",
      "do": { "focus": "#away" },
      "expect": { "noErrors": true, "state": { "keys": 2, "focuses": 1, "blurs": 1 } }
    },
    {
      "label": "blurring another tile does not count either",
      "do": { "blur": "#away" },
      "expect": { "noErrors": true, "state": { "keys": 2, "focuses": 1, "blurs": 1 } }
    }
  ]
}
