{
  "steps": [
    {
      "label": "initial render — none of the three has fired",
      "expect": {
        "noErrors": true,
        "state": { "keys": 0, "focuses": 0, "blurs": 0 },
        "domIncludes": ["keys: 0", "focuses: 0", "blurs: 0"]
      }
    },
    {
      "label": "focusing the editable runs the ui.focus reducer",
      "do": { "focus": "#ed" },
      "expect": {
        "noErrors": true,
        "state": { "focuses": 1, "keys": 0, "blurs": 0 },
        "domIncludes": ["focuses: 1"]
      }
    },
    {
      "label": "a keystroke runs the ui.key reducer",
      "do": { "key": "#ed", "value": "a" },
      "expect": {
        "noErrors": true,
        "state": { "keys": 1, "focuses": 1, "blurs": 0 },
        "domIncludes": ["keys: 1"]
      }
    },
    {
      "label": "a second keystroke counts again — the handler is not a one-shot",
      "do": { "key": "#ed", "value": "b" },
      "expect": { "noErrors": true, "state": { "keys": 2 } }
    },
    {
      "label": "leaving the editable runs the ui.blur reducer",
      "do": { "blur": "#ed" },
      "expect": {
        "noErrors": true,
        "state": { "blurs": 1, "keys": 2, "focuses": 1 },
        "domIncludes": ["blurs: 1"]
      }
    },
    {
      "label": "the three are wired to this tile alone — another tile's events do not count",
      "do": { "click": "#away" },
      "expect": {
        "noErrors": true,
        "state": { "keys": 2, "focuses": 1, "blurs": 1 }
      }
    }
  ]
}
