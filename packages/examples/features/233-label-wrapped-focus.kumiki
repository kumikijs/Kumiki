# Feature (W0212): which `ui.<ev>` selectors reach a `check`, a
# `switch` or a `radio`. Each renders a <label> around its <input>, and the
# listener a selector asks for goes on the <label>:
#
#   ui.change / ui.click   the renderer calls them when the <input> changes
#   ui.key                 a keydown in the focused <input> bubbles up to the
#                          <label>
#   ui.focus / ui.blur     the <input> fires them, but neither bubbles, so the
#                          <label> never receives them
#
# So `ui.focus(Agree)` is W0212, and its message gives that reason: the
# <input> fires "focus", which does not bubble to the <label> the listener is
# on. `Note` is an `input`, which takes focus itself, so its `ui.focus` /
# `ui.blur` reducers run.

type Size = Small | Large

slot agreed : Bool = false
slot lit    : Bool = false
slot size   : Size = Small
slot note   : Text = ""
slot log    : Text = ""

reducer agreeChange on=ui.change(Agree) do= log := log + "ac "
reducer agreeKey    on=ui.key(Agree)    do= log := log + "ak "
reducer litChange   on=ui.change(Lit)   do= log := log + "wc "
reducer sizeChange  on=ui.change(Big)   do= log := log + "rc "
reducer noteFocus   on=ui.focus(Note)   do= log := log + "nf "
reducer noteBlur    on=ui.blur(Note)    do= log := log + "nb "

tile Agree = check(bind=agreed) {id: "agree"}
tile Lit   = switch(bind=lit) {id: "lit"}
tile Big   = radio(group="size", bind=size, value=Large) {label: "Large", id: "big"}
tile Note  = input(bind=note) {id: "note"}

tile App
    = column(
        heading("what reaches a check, a switch and a radio"),
        Agree,
        Lit,
        Big,
        Note,
        text("log: " + log))
      {pad: "lg", gap: "md"}

app LabelWrappedFocus
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
