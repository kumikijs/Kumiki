# Feature: what a definition written in terms of itself looks like instead.
#
# A tile that expands into itself is E0005, a `fn` that calls itself is E0006,
# a `type` that resolves to itself is E0009, and a slot whose initial value
# reads a slot is E0304 (spec/errors.md). Each shape below is the accepted form
# of one of those mistakes — the rejected forms used to crash the compiler, run
# against the invariant, break the mounted app, or, for the type, be accepted
# outright: it built and it ran, with the slot declared by it never checked
# against anything.

type Node = {label: Text, depth: Int}

# E0009: `type Thread = Thread` — and the pair `type A = B` / `type B = A`, and
# `type Alias(T) = T` with `type Thread = Alias(Thread)` — comes back to a name
# already on the alias chain with no body ever reached, so it denotes nothing.
# A type that names itself *through a record* is the accepted form and stays
# legal: the record is where the chain stops. Comparing two of them terminates
# because the relation is read over the types as written, not because their
# values are finite — `type Node = {value: Int, next: Node}` has none at all
# and is legal too (language.md §1.3.6, inv. 4). This is the one of the four
# shapes where the self-reference is kept rather than replaced.
type Thread = {label: Text, replies: List(Thread)}

# E0304: `slot total : Int = nodes.length` reads a slot. Derived values belong
# in the fn layer — a slot read in an initial value is emitted as a lookup in
# the live-value table, which does not exist yet while the slot table is built.
slot nodes : List(Node) = [
    {label: "root",   depth: 0},
    {label: "child",  depth: 1},
    {label: "leaf",   depth: 2}
]
slot picked : Int = 0

slot thread : Thread = {
    label:   "why a recursive type is fine",
    replies: [
        {label: "the record is where the chain stops", replies: []},
        {label: "so comparing two terminates",        replies: []}
    ]
}

# E0006: `fn depthOf(n: Int) -> Int = if n <= 0 then 0 else depthOf(n - 1) + 1`
# is direct recursion. Folding over the data terminates by construction, which
# is what the invariant is protecting.
fn deepest(xs: List(Node)) -> Int = xs.fold(0, if $2.depth > $1 then $2.depth else $1)
fn labelAt(xs: List(Node), i: Int) -> Text =
    xs.filter($1.depth == i).map($1.label).join(", ")

# E0005: `tile Row = row(text("x"), Row)` expands into itself, and so does a
# pair of tiles that name each other. Repetition over a collection is `for`,
# which draws one child per element and stops.
tile NodeRow in=Node = row(
                         text($1.label),
                         text("depth " + $1.depth.show) {color: "muted"})
                       {gap: "sm"}

tile NextBtn = button(text="next", onClick=advance)

reducer advance on=ui.click(NextBtn)
    do= picked := (picked + 1) % nodes.length

# A `Thread` is drawn one level at a time, because the tile that drew it at
# every depth would be E0005 and the `fn` that flattened it would be E0006.
tile ReplyRow in=Thread = text("- " + $1.label)

tile App = column(
             heading("nodes"),
             column(for n in nodes NodeRow(n) {key: n.label}) {gap: "xs"},
             text("deepest: " + deepest(nodes).show),
             text("picked: " + labelAt(nodes, picked)),
             NextBtn,
             heading(thread.label),
             column(for r in thread.replies ReplyRow(r) {key: r.label}) {gap: "xs"})
           {pad: "lg", gap: "md"}

app SelfReference
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
