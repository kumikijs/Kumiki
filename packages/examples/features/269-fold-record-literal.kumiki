# Feature (stdlib.md): a `fold` whose fragment is a record or map literal
# builds the next accumulator from that literal.
#
#   xs.fold({n: 0}, {n: $1.n + $2})            # $1 : {n: Int}, the record so far
#   xs.fold({"sum": 0}, {"sum": $1.get-or("sum", 0) + $2})
#
# Each step answers a new record (or Map) for the next step to read. A
# fragment is any expression, and a literal written in braces is one too.

slot xs      : List(Int) = [1, 2, 3]
slot n       : Int       = 0
slot prev    : Int       = 0
slot fromMap : Int       = 0

reducer go on=ui.click(Go)
    do= n       := xs.fold({n: 0}, {n: $1.n + $2}).n
        prev    := xs.fold({n: 0, prev: 0}, {n: $2, prev: $1.n}).prev
        fromMap := xs.fold({"sum": 0}, {"sum": $1.get-or("sum", 0) + $2}).get-or("sum", 0)

tile Go = button(text="go") {id: "go"}

tile App = column(
  Go,
  text("n: " + n.show),
  text("prev: " + prev.show),
  text("from map: " + fromMap.show))

app FoldRecordLiteral
  caps   = []
  routes = {"/" -> App, "/404" -> App}
  init   = []
