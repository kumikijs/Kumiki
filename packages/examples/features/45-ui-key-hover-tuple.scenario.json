{
  "steps": [
    {
      "label": "ui.key: a real keydown on the input reaches onSearchKey with the key it carried",
      "do": { "key": "#search-input", "value": "Enter" },
      "expect": { "noErrors": true, "state": { "lastKey": "Enter" }, "domIncludes": ["Enter"] }
    },
    {
      "label": "ui.key: the next keydown replaces it, so the listener is live and not a one-shot",
      "do": { "key": "#search-input", "value": "a" },
      "expect": { "noErrors": true, "state": { "lastKey": "a" } }
    },
    {
      "label": "ui.hover: a real mouseenter on the card increments to 1",
      "do": { "hover": "#hover-card" },
      "expect": { "noErrors": true, "state": { "hoverHits": 1 } }
    },
    {
      "label": "ui.hover: second mouseenter increments to 2",
      "do": { "hover": "#hover-card" },
      "expect": { "noErrors": true, "state": { "hoverHits": 2 } }
    },
    {
      "label": "tuple pattern: zipped rows render the name half of each Tuple(Text, Int)",
      "expect": {
        "noErrors": true,
        "domIncludes": ["alpha", "beta", "gamma"]
      }
    }
  ]
}
