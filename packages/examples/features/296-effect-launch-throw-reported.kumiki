# Feature: a throw past a request's launch is an error of the app, under every
# policy (spec/runtime.md).
#
# `sendA` and `sendB` each queue a write of `record` under `policy=queue`.
# `done` appends what each `.ok` hands it to `log`, and `onCrash` counts what
# `app.error` is told and keeps the last one.
#
# Something outside the reducers can throw while a request is launched or its
# result is recorded, such as a host's episode logger. That is an error of the
# app, so `app.error` fires with category "effect" and location
# `effect "record"`, and the write queued behind it still runs.
#
# The scenario walks the queue with nothing throwing.
# `packages/tests/src/effect-launch-throw-reported.test.ts` mounts this app
# with an episode logger whose `onEpisode` hook throws once, as the first
# click's episode commits after its write.

slot log     : Text = ""
slot crashes : Int  = 0
slot crash   : Text = ""

effect record cap=log.write
              in=Text
              out=Unit
              policy=queue

reducer sendA   on=ui.click(SendA)      do= emit record("a")
reducer sendB   on=ui.click(SendB)      do= emit record("b")
reducer done    on=record.ok(_, $sent)  do= log := log + $sent
reducer failed  on=record.err(_, _)     do= log := log + "!"
reducer onCrash on=app.error            do= crashes := crashes + 1
                                           crash   := $event.category + " in " + $event.location

tile SendA = button(text="Send a", onClick=sendA) {id: "send-a"}
tile SendB = button(text="Send b", onClick=sendB) {id: "send-b"}

tile App = column(
    SendA,
    SendB,
    text("log=" + log),
    text("app.error x" + crashes.show + ": " + crash)
) {pad: "lg", gap: "md"}

app LaunchThrowReported
    caps   = [log.write]
    routes = {"/" -> App, "/404" -> App}
    init   = []
