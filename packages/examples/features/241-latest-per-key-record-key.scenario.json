{
  "steps": [
    {
      "label": "nothing has been loaded yet",
      "expect": { "noErrors": true, "state": { "pages": [] } }
    },
    {
      "label": "one click starts both pages, and both answers arrive",
      "do": { "click": "#both" },
      "expect": {
        "noErrors": true,
        "state": { "pages": ["page 1", "page 2"] },
        "domIncludes": ["pages: page 1, page 2"]
      }
    }
  ],
  "effects": {
    "loadPage": [{ "outcome": "ok", "value": "page 1" }, { "outcome": "ok", "value": "page 2" }]
  }
}
