# Feature (spec/stdlib.md §2.4.5): `fmt(template, ...args)` substitutes
# `{0}` … `{n}`.
#
# The substitution used to not happen at all: the runtime carried no `fmt`
# helper, so codegen's `_s.fmt ? … : template` guard always took the else
# branch and a call evaluated to its own template. `check`, `build` and
# `smoke` were green throughout — a template is a `Text`, exactly like the
# formatted result it was standing in for, so nothing downstream could tell
# the two apart. Only a scenario that names the substituted string can.
#
# Each slot below pins one rule of §2.4.5. The last three are the ones the
# spec used to leave open — an index the arguments do not reach, an argument
# no placeholder names, and a `{` that opens no placeholder.

slot who      : Text = "Ada"
slot unread   : Int  = 3

# A template that is an **expression** rather than a literal. §2.4.5's rules
# for a disagreeing call are written for exactly this case: a literal template
# is counted against its arguments at check time (W0214), and a slot carries no
# placeholder set to count, so what follows is the runtime's answer alone.
slot template : Text = "{0} {1}"

slot greeting : Text = ""
slot reordered: Text = ""
slot rendered : Text = ""
slot missing  : Text = ""
slot extra    : Text = ""
slot literal  : Text = ""

reducer render on=ui.click(RenderBtn)
    do= greeting  := fmt("Hello {0}, you have {1}", who, unread)
        # An index may repeat and may appear out of order.
        reordered := fmt("{1} {0} {1}", "a", "b")
        # An argument is rendered the way `+` renders it — the `show` equivalent.
        rendered  := fmt("{0} and {1}", unread, true)
        # One argument for two placeholders: `{1}` stays as written rather than
        # rendering empty, so the reader can see which index went missing.
        missing   := fmt(template, "a")
        # The other direction: `"c"` is named by no placeholder and is dropped,
        # leaving a result identical to the correct call's. That is the half
        # with no trace anywhere, and why W0214 exists for literal templates.
        extra     := fmt(template, "a", "b", "c")
        # There is no escape. `{}` and `{a}` are text; in `{{0}}` the inner
        # `{0}` is the placeholder and the braces around it are text.
        literal   := fmt("{} {a} {{0}}", "x")

tile RenderBtn = button(text="render", onClick=render)

tile App
    = column(
        heading("string formatting"),
        RenderBtn,
        text("greeting=" + greeting),
        text("reordered=" + reordered),
        text("rendered=" + rendered),
        text("missing=" + missing),
        text("extra=" + extra),
        text("literal=" + literal))
      {pad: "lg", gap: "md"}

app StringFormatting
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
