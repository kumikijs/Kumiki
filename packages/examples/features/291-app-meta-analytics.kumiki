# Feature: two app-level blocks that need no code of their own (spec/runtime.md).
#
# `app.meta` puts the page's head metadata (title / description / og-image /
# favicon) under the app's control, applied at mount. `app.analytics` gives the
# `analytics.send` capability a default sink, so `track` has somewhere to go
# without a host SDK wired in.

slot clicks : Int = 0

effect track cap=analytics.send
              in={event: Text, count: Int}
              out=Unit

reducer add on=ui.click(Bump) do= clicks := clicks + 1
                                  emit track({event: "bump", count: clicks + 1})

tile Bump = button(text="Bump")
tile App  = column(
              heading("Clicks: " + clicks),
              Bump) {pad: "lg", gap: "md"}

app MetaAnalyticsDemo
    caps   = [analytics.send]
    routes = {"/" -> App, "/404" -> App}
    init   = []
    meta   = {
        title: "Kumiki meta demo",
        description: "Demonstrates app.meta and app.analytics",
        og-image: "/og.png",
        favicon: "/favicon.ico"
    }
    analytics = {
        provider: "console",
        app-id: "meta-analytics-demo"
    }
