{
  "steps": [
    {
      "label": "the lists as declared",
      "expect": {
        "noErrors": true,
        "state": { "xs": [1, 2, 3] },
        "domIncludes": ["length: 3", "head: 1", "sum: 6"]
      }
    },
    {
      "label": "an index write replaces one element and leaves a List",
      "do": { "click": "#first" },
      "expect": {
        "noErrors": true,
        "state": { "xs": [7, 2, 3] },
        "domIncludes": ["length: 3", "head: 7", "sum: 12"]
      }
    },
    {
      "label": "through a List of records and a List of Lists, every level keeps its shape",
      "do": { "click": "#nested" },
      "expect": {
        "noErrors": true,
        "state": {
          "rows": [{ "name": "a", "n": 1 }, { "name": "b", "n": 9 }],
          "grid": [[1, 2], [0, 4]]
        },
        "domIncludes": ["second row: 9", "grid: 2"]
      }
    },
    {
      "label": "a for loop writes each index it names, each write seeing the one before",
      "do": { "click": "#zero-ends" },
      "expect": {
        "noErrors": true,
        "state": { "xs": [0, 2, 0] },
        "domIncludes": ["length: 3", "head: 0", "sum: 2"]
      }
    },
    {
      "label": "a write past the end panics, and the reducer's earlier write rolls back with it",
      "do": { "navigate": "/outside" },
      "expect": {
        "state": { "xs": [0, 2, 0], "tries": 0 },
        "domIncludes": [
          "length: 3",
          "tries: 0",
          "failed: Index 3 is out of range for a List of length 3"
        ],
        "errorIncludes": ["panic in reducer \"write-outside\""]
      }
    },
    {
      "label": "a negative index panics the same way",
      "do": { "navigate": "/negative" },
      "expect": {
        "state": { "xs": [0, 2, 0], "tries": 0 },
        "domIncludes": ["tries: 0", "failed: Index -1 is out of range for a List of length 3"],
        "errorIncludes": ["panic in reducer \"write-negative\""]
      }
    },
    {
      "label": "a read past the end panics too, rather than reading undefined",
      "do": { "navigate": "/read-outside" },
      "expect": {
        "state": { "picked": 0, "tries": 0 },
        "domIncludes": ["tries: 0", "failed: Index 7 is out of range for a List of length 3"],
        "errorIncludes": ["panic in reducer \"read-outside\""]
      }
    }
  ]
}
