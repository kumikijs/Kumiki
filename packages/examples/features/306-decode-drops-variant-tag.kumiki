# Feature (http.md): `Decoder.Json(T)` removes a `_tag` key from each record
# position it reads. The runtime tells a variant from a record by that field
# (errors.md, E0240), so a record that kept it would read as a variant: `show`
# would render `{"_tag": "a", "n": 1}` as `a`. Any other key the type does not
# declare is kept as it came.
#
# The fixture beside this file answers `/api/item` with
# `{"_tag": "a", "n": 1, "note": "kept"}`. That is an `Item`, so `.ok` runs, on
# `{n: 1, note: "kept"}`: the page shows that record, and `n` reads `1`.
#
# `smoke` makes the request through the real HTTP path against
# `306-decode-drops-variant-tag.http.json`; packages/tests/src/http-decode-shape.test.ts
# checks what `.ok` receives there.

type Item = {n: Int}

slot item : Text = "loading"

effect loadItem cap=http.get
                in=Unit
                out=Result(Item, HttpError)
                map-request={url: "/api/item", decode: Decoder.Json(Item)}

reducer boot    on=app.start              do= emit loadItem()
reducer gotItem on=loadItem.ok($i, _)     do= item := $i.show + ", n is " + $i.n.show
reducer badItem on=loadItem.err($e, _)    do= item := $e.message

tile App = column(text("item: " + item)) {pad: "lg", gap: "md"}

app DecodeDropsVariantTag
    caps   = [http.get]
    routes = {"/" -> App, "/404" -> App}
    init   = []
