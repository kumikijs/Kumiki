# Feature: which parents can key-match their children (spec/runtime.md §10.3.10).
#
# Keys are necessary but not sufficient. `overlay` stacks its layers by putting
# every child after the first inside a positioning wrapper, so the reconciler
# does not hold those slots — it cannot move a layer without tearing the child
# out of its wrapper. It notices, declines the keyed match, and diffs the layers
# by position instead. Correct either way; what is lost is reorder-stable
# element identity, which is why `kumiki dev` reports one `wrapped-children`
# diagnostic per flip here and none for the keyed `column` in
# `unkeyed-conditional-rebuild`.
#
# The takeaway for authoring: put a keyed list under a plain container
# (`column` / `row` / `list`), and use `overlay` for stacking a fixed set of
# layers rather than a reorderable one.

slot layers : List(Text) = ["backdrop", "sheet", "badge"]

reducer flip on=ui.click(FlipBtn) do= layers := layers.reverse

tile FlipBtn = button(text="flip stacking order", onClick=flip)
tile Layer in=Text = card(text($1)) {pad: "sm"}

# Every child carries a key (the `for` binding supplies it), yet the layers
# after the first sit inside overlay-owned wrappers.
tile Stack = overlay(for l in layers Layer(l)) {align: "center"}

tile App = column(
             heading("keyed layers under a wrapping parent"),
             FlipBtn,
             Stack)
           {pad: "lg", gap: "md"}

app OverlayKeyedLayers
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
