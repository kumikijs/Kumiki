{
  "steps": [
    {
      "label": "the pattern decides the output, not the formatter",
      "expect": {
        "noErrors": true,
        "domIncludes": ["ymd: 2026-08-14", "wordy: 14/08/2026", "year: 2026", "literal: [on] 14"]
      }
    },
    {
      "label": "\"HH:mm\" keeps the time the ISO-date-only formatter used to drop",
      "expect": {
        "noErrors": true,
        "domIncludes": ["stamp: 2026-08-14 21:05"]
      }
    }
  ]
}
