{
  "steps": [
    {
      "label": "mocked Ok, nothing stored: the payload is a None, stored as the Option it is",
      "expect": {
        "noErrors": true,
        "state": { "session": { "_tag": "None" } },
        "domIncludes": ["signed out"]
      }
    },
    {
      "label": "mocked Ok after a save: the payload is a Some, rendered through the match",
      "do": { "click": "#sign-in" },
      "expect": {
        "noErrors": true,
        "state": { "session": { "_tag": "Some", "_0": { "email": "a@example.com" } } },
        "domIncludes": ["signed in as a@example.com"]
      }
    },
    {
      "label": "mocked err, shaped as the {message} record the storage handler delivers: the reducer reads $e.message and leaves the session alone",
      "do": { "click": "#reload" },
      "expect": {
        "noErrors": true,
        "state": {
          "problem": "SecurityError: storage blocked",
          "session": { "_tag": "Some", "_0": { "email": "a@example.com" } }
        },
        "domIncludes": ["problem: SecurityError: storage blocked"]
      }
    }
  ],
  "effects": {
    "loadSession": [
      { "outcome": "ok", "value": { "_tag": "None" } },
      { "outcome": "ok", "value": { "_tag": "Some", "_0": { "email": "a@example.com" } } },
      { "outcome": "err", "value": { "message": "SecurityError: storage blocked" } }
    ],
    "saveSession": [{ "outcome": "ok", "value": null }]
  }
}
