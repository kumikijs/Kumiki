{
  "steps": [
    {
      "label": "no click has committed an episode yet",
      "expect": { "noErrors": true, "state": { "count": 0 }, "domIncludes": ["count=0"] }
    },
    {
      "label": "each click commits one episode",
      "do": { "click": "#inc" },
      "expect": { "noErrors": true, "state": { "count": 1 } }
    },
    {
      "do": { "click": "#inc" },
      "expect": { "noErrors": true, "state": { "count": 2 } }
    },
    {
      "label": "three clicks, three lines in the log",
      "do": { "click": "#inc" },
      "expect": { "noErrors": true, "state": { "count": 3 }, "domIncludes": ["count=3"] }
    }
  ]
}
