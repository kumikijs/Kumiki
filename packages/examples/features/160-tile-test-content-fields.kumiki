# Feature (testing.md §8.4): a tile-test compares every field its expected
# node states — `src`, `to`, `value`, `checked`, `options` — not only `text`.
#
# Each test below states the one field its tile is about. A snapshot that
# compared only `kind`, `text` and `children` passed every one of them with
# that field written wrong: an image with the wrong `src`, a link to the
# wrong page. What stays out of the comparison is what §8.4 names — class
# names and styles (`{pad: …}`, `variant=`) — and any field the expected
# node leaves out: `name-field` does not state a `placeholder`, so the one
# `Name` renders is not compared.
#
# `packages/tests/tile-test-content-fields.test.ts` runs these tests, then
# writes each stated field wrong and asserts the test fails naming it.

slot agreed : Bool = true
slot name   : Text = "Ada"
slot size   : Text = "s"

tile Pic   = image(src="/avatar.png", alt="avatar")
tile Nav   = link(text="Home", to="/home")
tile Agree = check(value=agreed)
tile Name  = input(value=name, placeholder="your name")
tile Size  = select(options=[{label: "S", value: "s"}, {label: "L", value: "l"}], value=size)
tile Card  = column(Pic, Nav) {pad: "lg", gap: "md"}

tile App
    = column(
        heading("tile-test content fields"),
        Card,
        Agree,
        Name,
        Size,
        text("agreed=" + agreed.show + " name=" + name + " size=" + size))
      {pad: "lg", gap: "md"}

app TileTestContentFields
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []

test pic-src =
    tile-test Pic
        given  = {slots: {}}
        expect = image(src="/avatar.png", alt="avatar")

test nav-to =
    tile-test Nav
        given  = {slots: {}}
        expect = link(text="Home", to="/home")

test agree-checked =
    tile-test Agree
        given  = {slots: {agreed: true}}
        expect = check(value=true)

test name-field =
    tile-test Name
        given  = {slots: {name: "Grace"}}
        expect = input(value="Grace")

test size-options =
    tile-test Size
        given  = {slots: {size: "l"}}
        expect = select(options=[{label: "S", value: "s"}, {label: "L", value: "l"}], value="l")

test card-children =
    tile-test Card
        given  = {slots: {}}
        expect = column(image(src="/avatar.png", alt="avatar"), link(text="Home", to="/home"))
