# Feature: a tile-test compares every content field its expected node states —
# the fields a builtin lifts (`src`, `to`, `value`, a toggle's checked state,
# `options`) and the named arguments it keeps in props (`alt`, `disabled`, each
# `aria-*` attribute) — not only `text`.
#
# A snapshot that compared only `kind`, `text` and `children` passed every
# test below with its subject written wrong: an image with the wrong `src` or
# `alt`, a link to the wrong page, a button that is not disabled. What stays
# out of the comparison is the `{…}` block — `go-disabled` states a different
# `variant` from the one `Go` renders, and still passes — the identity and
# wiring a node carries (`key` from `for`, `bind`), and any field the
# expected node leaves out: `name-field` does not state a `placeholder`, so
# the one `Name` renders is not compared, and `people-list` keys its rows
# implicitly while `People` keys them by id. `close-aria` and
# `close-block-aria` state one of the two `aria-*` attributes their tile
# renders (as arguments in `Close`, in the `{…}` block in `CloseBlock`): each
# attribute is a field of its own.
#
# `packages/tests/src/tile-test-content-fields.test.ts` runs these tests, then
# writes each stated field wrong and asserts the test fails naming it.

type Person = {id: Int, name: Text}

slot agreed : Bool = true
slot name   : Text = "Ada"
slot size   : Text = "s"
slot people : List(Person) = [{id: 1, name: "Ada"}, {id: 2, name: "Grace"}]

tile Pic   = image(src="/avatar.png", alt="avatar")
tile Nav   = link(text="Home", to="/home")
tile Agree = check(value=agreed)
tile Name  = input(value=name, placeholder="your name")
tile Size  = select(options=[{label: "S", value: "s"}, {label: "L", value: "l"}], value=size)
tile Card  = column(Pic, Nav) {pad: "lg", gap: "md"}
tile Go    = button(text="Go", disabled=true) {variant: "ghost"}
tile People = column(for p in people text(p.name) {key: p.id.show})
tile Close = button(text="x", aria-label="Close", aria-describedby="hint")
tile CloseBlock = button(text="x") {aria-label: "Close", aria-describedby: "hint"}

tile App
    = column(
        heading("tile-test content fields"),
        Card,
        Agree,
        Name,
        Size,
        Go,
        People,
        Close,
        CloseBlock,
        text("agreed=" + agreed.show + " name=" + name + " size=" + size))
      {pad: "lg", gap: "md"}

app TileTestContentFields
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []

test pic-src =
    tile-test Pic
        given  = {slots: {}}
        expect = image(src="/avatar.png", alt="avatar")

test nav-to =
    tile-test Nav
        given  = {slots: {}}
        expect = link(text="Home", to="/home")

test agree-checked =
    tile-test Agree
        given  = {slots: {agreed: true}}
        expect = check(value=true)

test name-field =
    tile-test Name
        given  = {slots: {name: "Grace"}}
        expect = input(value="Grace")

test size-options =
    tile-test Size
        given  = {slots: {size: "l"}}
        expect = select(options=[{label: "S", value: "s"}, {label: "L", value: "l"}], value="l")

test card-children =
    tile-test Card
        given  = {slots: {}}
        expect = column(image(src="/avatar.png", alt="avatar"), link(text="Home", to="/home"))

test go-disabled =
    tile-test Go
        given  = {slots: {}}
        expect = button(text="Go", disabled=true) {variant: "primary"}

test people-list =
    tile-test People
        given  = {slots: {}}
        expect = column(for p in people text(p.name))

test close-aria =
    tile-test Close
        given  = {slots: {}}
        expect = button(text="x", aria-label="Close")

test close-block-aria =
    tile-test CloseBlock
        given  = {slots: {}}
        expect = button(text="x", aria-label="Close")
