{
  "steps": [
    {
      "label": "nothing has been asked for yet, and the handle is the empty sentinel",
      "expect": {
        "noErrors": true,
        "state": { "handle": "", "note": "idle", "blob": 0, "pinged": false }
      }
    },
    {
      "label": "one click fires all three decoders",
      "do": { "clickText": "Load" },
      "expect": {
        "noErrors": true,
        "state": { "note": "kumiki", "blob": 10, "pinged": true },
        "domIncludes": ["note: kumiki", "blob: 10", "pinged: true"]
      }
    },
    {
      "label": "cancelling a request that already landed puts the sentinel back",
      "do": { "clickText": "Cancel" },
      "expect": { "noErrors": true, "state": { "handle": "" } }
    }
  ],
  "effects": {
    "loadNote": [{ "outcome": "ok", "value": "kumiki" }],
    "loadBlob": [{ "outcome": "ok", "value": [107, 117, 109, 105, 107, 105, 46, 100, 101, 118] }],
    "ping": [{ "outcome": "ok", "value": null }]
  }
}
