# Feature (forms.md §5.1.1): an `input` bound to an `Int` / `Float` slot reads
# its text as a number, and one bound to a `Time` slot with `type="date"`
# reads it as an instant — the way `Int.parse` / `Float.parse` / `Time.parse`
# read text (stdlib.md §2.4.3). Text that spells no value of the type (`""`,
# `"1.5"` for an Int) is refused like a refinement violation: the slot keeps
# its last value and the field keeps what was typed. Before this, the field's
# string was written as-is, so `age + 1` rendered `51`.

type Order = {qty: Int, note: Text}

slot age   : Int   = 0
slot price : Float = 1.5
slot order : Order = {qty: 1, note: ""}
slot day   : Time  = Time.parse("2026-01-01").get-or(now)

tile NextDayBtn = button(text="next day") {id: "nextDay"}

reducer nextDay on=ui.click(NextDayBtn) do= day := day.plus(Duration.h(24))

tile App = column(
    input(bind=age, type="number", id="age"),
    input(bind=price, type="number", id="price"),
    input(bind=order.qty, type="number", id="qty"),
    input(bind=day, type="date", id="day"),
    NextDayBtn,
    text("next=" + (age + 1).show),
    text("double=" + (price * 2.0).show),
    text("qty+1=" + (order.qty + 1).show),
    text("day=" + day.format("yyyy-MM-dd")))

app TypedInputBind
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
