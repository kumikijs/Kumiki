# Feature (forms.md §5.6): a `bind` into one field of a record slot is judged
# at that field. A sibling that fails its own refinement — here the pristine
# `email: ""`, which a declared default is allowed to hold — does not refuse
# the write, so the form fills in any order. A value the bound field's own
# predicate refuses still is refused. Before this, the whole record was gated,
# and typing a name before the email was silently dropped.

type Signup = {email: Text where email, name: Text where nonempty, nick: Option(Text where len-lt(6))}

slot signup : Signup = {email: "", name: "", nick: Some("")}

tile App = column(
    input(bind=signup.name, id="name"),
    input(bind=signup.nick.get, id="nick"),
    input(bind=signup.email, id="email"),
    error(field=signup),
    text("name=" + signup.name),
    text("nick=" + signup.nick.get-or("-")),
    text("email=" + signup.email))

app RecordFieldBind
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
