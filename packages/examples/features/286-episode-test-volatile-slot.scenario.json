{
  "steps": [
    {
      "label": "the app starts at zero",
      "expect": {
        "noErrors": true,
        "state": { "count": 0, "lastClick": "" },
        "domIncludes": ["n=0"]
      }
    },
    {
      "label": "a click runs inc, which writes both slots",
      "do": { "clickText": "+" },
      "expect": {
        "noErrors": true,
        "state": { "count": 1, "lastClick": "clicked" },
        "domIncludes": ["n=1"]
      }
    }
  ]
}
