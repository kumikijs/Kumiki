{
  "steps": [
    {
      "label": "equal values compare equal, different ones do not",
      "expect": {
        "noErrors": true,
        "domIncludes": [
          "list-empty: true",
          "list-eq: true",
          "list-order: false",
          "rec-eq: true",
          "rec-ne: true",
          "tuple-eq: true",
          "opt-int-eq: true",
          "opt-rec-eq: true",
          "nested-opt: true",
          "nested-opt-ne: false"
        ]
      }
    },
    {
      "label": "contains and unique compare the way == does",
      "expect": {
        "noErrors": true,
        "domIncludes": [
          "is-admin: true",
          "is-viewer: false",
          "has-pt: true",
          "has-none: true",
          "has-pair: true",
          "unique-roles: 2",
          "unique-roles2: 2",
          "unique-first: true",
          "unique-pts: 2",
          "unique-opts: 2",
          "unique-pairs: true",
          "text-contains: true"
        ]
      }
    },
    {
      "label": "a List slot compares with == after a reducer writes it",
      "do": { "click": "#add" },
      "expect": { "noErrors": true, "domIncludes": ["items: 1"], "state": { "items": [1] } }
    }
  ]
}
