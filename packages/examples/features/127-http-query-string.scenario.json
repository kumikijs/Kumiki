{
  "steps": [
    {
      "label": "nothing has been searched yet",
      "expect": { "noErrors": true, "state": { "status": "idle" } }
    },
    {
      "label": "the click searches, and the answer renders",
      "do": { "click": "#search" },
      "expect": {
        "noErrors": true,
        "state": { "status": "found 2" },
        "domIncludes": ["status: found 2"]
      }
    }
  ],
  "effects": {
    "search": [{ "outcome": "ok", "value": [{ "name": "one" }, { "name": "two" }] }]
  }
}
