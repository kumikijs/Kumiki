# Feature (http.md): `Decoder.Json(T)` hands on only what `T` declares. Each
# record position keeps its fields and loses every other key, and each variant
# keeps its tag and its payloads, so `show` and `==` see a value of `T`. That
# matters most for `_tag`: the runtime tells a variant from a record by that
# field (errors.md, E0240), so a record that kept it would read as a variant,
# and `show` would render `{"_tag": "a", "n": 1}` as `a`.
#
# The fixture beside this file answers `/api/item` with
# `{"_tag": "a", "n": 1, "note": "dropped"}`. That is an `Item`, so `.ok` runs,
# on `{n: 1}`: the page shows that record, equal to the `{n=1}` the program
# builds.
#
# `smoke` makes the request through the real HTTP path against
# `306-decode-drops-undeclared-keys.http.json`; packages/tests/src/http-decode-shape.test.ts
# checks what `.ok` receives there.

type Item = {n: Int}

slot item : Text = "loading"

effect loadItem cap=http.get
                in=Unit
                out=Result(Item, HttpError)
                map-request={url: "/api/item", decode: Decoder.Json(Item)}

reducer boot    on=app.start          do= emit loadItem()
reducer gotItem on=loadItem.ok($i, _) do= item := $i.show + ", equal to {n=1}: " + ($i == {n=1}).show
reducer badItem on=loadItem.err($e, _) do= item := $e.message

tile App = column(text("item: " + item)) {pad: "lg", gap: "md"}

app DecodeDropsUndeclaredKeys
    caps   = [http.get]
    routes = {"/" -> App, "/404" -> App}
    init   = []
