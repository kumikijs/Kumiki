# Feature: opening the database is part of one indexed-* effect's call, not a
# state the page stays in.
#
# The first effect that runs opens `app.indexed-db`, and the effects after it
# share that connection. An open that another connection blocks (another tab
# still holding version 1 while this one asks for 2) waits, with no timeout,
# until that connection closes, then reads; the runtime warns while it waits.
# An open that fails is that load's `.err`, and the next load opens again.
# When another tab opens a newer `version`, this page closes its connection so
# that tab's upgrade is not blocked. Its next load reopens at version 2, which
# the upgraded database refuses, so every load is `.err` (`VersionError: …`)
# until the page reloads. A connection the browser closes on its own is not
# kept either, and the next load opens again.
#
# The scenario scripts `loadNote`: a failed load, then one that reads the
# note. The integration test mounts this file against an IndexedDB double
# that reports `blocked`, fails, sends `versionchange`, refuses a reopen with
# `VersionError`, and closes a connection the way the browser does.

type Note = {id: Text, body: Text}

slot status : Text = "idle"

effect loadNote cap=indexed.read
                in=Text
                out=Result(Option(Note), Text)
                map-request={store: "notes", key: $1, decode: Decoder.Json(Note)}

reducer go     on=ui.click(LoadBtn)   do= status := "loading"
                                          emit loadNote("a")
reducer loaded on=loadNote.ok($o, _)  do= status := "loaded " + $o.map($1.body).get-or("-")
reducer failed on=loadNote.err($e, _) do= status := "err: " + $e

tile LoadBtn = button(text="Load") {id: "load"}
tile App = column(LoadBtn, text("status: " + status)) {pad: "lg", gap: "md"}

app IndexedDbOpenRetry
    caps   = [indexed.read]
    routes = {"/" -> App, "/404" -> App}
    init   = []
    indexed-db = {
        name:    "notes",
        version: 2,
        stores:  [{name: "notes", key: "id"}]
    }
