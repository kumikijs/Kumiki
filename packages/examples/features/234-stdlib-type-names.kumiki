# Feature (stdlib.md §2.1.3, language.md §1.3.6 inv. 6): a standard-library
# type name means the standard library's type in every program. The fallback
# declares `in=PanicInfo` and reads the record the runtime builds — `$1.message`,
# `$1.location` — and the program's own panic type takes a name of its own,
# `AppPanic`. Declaring it as `type PanicInfo = …` is E0231 (errors.md): the
# runtime would still bind the standard record to `$1`.

type AppPanic = {origin: Text, reason: Text}

fn summarize(p: AppPanic) -> Text = p.reason + " at " + p.origin

slot secret : Option(Text) = None
slot reveal : Bool         = false

tile Risky error-boundary=Recovered = when(reveal, text(secret.get))

tile Recovered
    in=PanicInfo
    = column(
        text("recovered: " + $1.message),
        text("location: " + $1.location),
        text("summary: " + summarize({origin: $1.location, reason: $1.message})))

tile RevealBtn = button(text="reveal") {id: "reveal"}

reducer doReveal on=ui.click(RevealBtn) do= reveal := true

tile App = column(Risky, RevealBtn)

app StdlibTypeNames
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
