# Feature: two reducers on one event both fire, in source order (spec/runtime.md).
#
# `save` and `audit` both subscribe to ui.click(SaveBtn): first `save` bumps
# `version`, then `audit` advances `log`, so both slots move together.

slot version : Int = 0
slot log     : Int = 0

reducer save  on=ui.click(SaveBtn) do= version := version + 1
reducer audit on=ui.click(SaveBtn) do= log     := log     + 1

tile SaveBtn = button(text="Save")

tile App = column(
             heading("Multi-subscribe demo"),
             row(text("version: " + version.show),
                 text("log: " + log.show)) {gap: "md"},
             SaveBtn)

app MultiSubscribe
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
