{
  "steps": [
    {
      "label": "nothing has fired yet",
      "expect": {
        "noErrors": true,
        "state": { "count": 0 },
        "domIncludes": ["builtin", "bare", "call", "braces", "count: 0"]
      }
    },
    {
      "label": "the props-block form on a builtin binds the reducer",
      "do": { "clickText": "builtin" },
      "expect": { "noErrors": true, "state": { "count": 1 } }
    },
    {
      "label": "the bare name on a user tile binds it",
      "do": { "clickText": "bare" },
      "expect": { "noErrors": true, "state": { "count": 2 } }
    },
    {
      "label": "the argument-less call on a user tile binds it",
      "do": { "clickText": "call" },
      "expect": { "noErrors": true, "state": { "count": 3 } }
    },
    {
      "label": "the props-block form on a user tile binds it too",
      "do": { "clickText": "braces" },
      "expect": { "noErrors": true, "state": { "count": 4 }, "domIncludes": ["count: 4"] }
    },
    {
      "label": "and so does the props-block form on a value builtin",
      "do": { "fill": "#ed", "value": "hi" },
      "expect": { "noErrors": true, "state": { "note": "hi", "count": 5 } }
    }
  ]
}
