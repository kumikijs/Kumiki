# Feature: every value field of app.http reads a live slot, and every one of
# them is evaluated per request. "Use backup" changes where the next request
# goes; "Tighten" changes what it carries and how long it waits. Neither needs
# a remount.

slot endpoint    : Text = "https://api.example.com"
slot timeoutMs   : Int  = 5000
slot sendCookies : Text = "include"
slot quote       : Text = ""
slot status      : Text = "idle"

effect fetchQuote cap=http.get
                  in=Unit
                  out=Result(Text, HttpError)
                  map-request={url: "/quote", decode: Decoder.Text}

reducer load      on=ui.click(LoadBtn)       do= status := "loading"
                                                 emit fetchQuote()
reducer loaded    on=fetchQuote.ok($q, _)    do= quote  := $q
                                                 status := "ready"
reducer failed    on=fetchQuote.err($e, _)   do= status := "error"
reducer useBackup on=ui.click(SwapBtn)       do= endpoint := "https://backup.example.com"
reducer tighten   on=ui.click(TightenBtn)    do= timeoutMs   := 20
                                                 sendCookies := "omit"

tile LoadBtn    = button(text="Load quote", onClick=load)
tile SwapBtn    = button(text="Use backup", onClick=useBackup)
tile TightenBtn = button(text="Tighten", onClick=tighten)

tile App = column(
             text("endpoint: " + endpoint),
             text("status: " + status),
             LoadBtn,
             SwapBtn,
             TightenBtn,
             text(quote))
           {pad: "lg", gap: "md"}

app HttpConfigFromSlots
    caps   = [http.get]
    routes = {"/" -> App, "/404" -> App}
    init   = []
    http   = {
        base-url:    endpoint,
        headers:     { "X-Endpoint": endpoint },
        timeout:     timeoutMs,
        credentials: sendCookies
    }
