{
  "steps": [
    {
      "label": "the tag ten steps down renders, read through the path rename writes",
      "expect": { "noErrors": true, "domIncludes": ["tag: kumi"], "domExcludes": ["tag: kumiki"] }
    },
    {
      "label": "the ten-step write lands on that tag, and every predicate accepts it",
      "do": { "click": "#rename" },
      "expect": {
        "noErrors": true,
        "domIncludes": ["tag: kumiki"],
        "state": {
          "world": { "boards": [{ "rows": [{ "cells": [{ "pins": [{ "tags": ["kumiki"] }] }] }] }] }
        }
      }
    }
  ]
}
