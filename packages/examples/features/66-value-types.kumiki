# Feature: value-level type checking — the shapes the compiler now rejects.
#
# Everything below is the *accepted* form of a mistake that used to compile and
# then misbehave at runtime. Each comment names the diagnostic the wrong form
# produces (spec/errors.md E0201 / E0213 / E0214 / E0215 / E0216 / E0217).

type Status  = Idle | Loading | Done(Int)

# Two `nominal` declarations over one base are two types, identified by the name
# they are declared under (§1.3.5). Putting a `Fahrenheit` where a `Celsius` is
# required is E0201 — it used to compile, and 70 degrees of weather arrived as
# 70 degrees of room.
type Celsius    = nominal Int where between(-90, 60)
type Fahrenheit = nominal Int where between(-130, 140)

# Two id types over one base, which is the shape `nominal` is most often written
# in. `TypeName.fresh()` is a `TypeName` and `TypeName.parse(t)` an
# `Option(TypeName)` (stdlib §2.4.1 / §2.4.3), so the call that *mints* an id is
# judged like every other expression rather than being the one position the
# identity could not reach. Both spellings used to compile — the qualifier was
# read by the lowering and by nothing else. The rejected forms are named at the
# `latestId` slot and the `remint` reducer below, where the names exist.
type ReadingId = nominal Text where uuid
type SampleId  = nominal Text where uuid

type Reading = {label: Text, celsius: Celsius, id: ReadingId}

# The shared base is the bridge, so no cast form is needed: a base value goes
# into any nominal over it, which is why `slot forecast : Fahrenheit = 70` needs
# no wrapping and why `celsius + 1` below stands.
#
# What brings this body back to that base is `.round`, not the arithmetic —
# `/` is Float (§1.9.4), and `-> Celsius = (f - 32) * 5 / 9` is E0201 for the
# same reason `toFahrenheit` has to be declared `-> Float`.
fn toCelsius(f: Fahrenheit) -> Celsius = ((f - 32) * 5 / 9).round

# `-> Float`, because `/` is Float even between two Ints (§1.9.4). Declaring
# `-> Int` here is E0201 — and used to render `69.8` from a whole-number promise.
fn toFahrenheit(c: Celsius) -> Float = c * 9 / 5 + 32

# The identity reaches the comparison operators, not only assignment (§1.9.4):
# `r.celsius == f` and `r.celsius < f` are both E0201, the same mistake as
# `r.celsius := f` in the spelling a lookup or a router is written in. So the
# forecast goes through the same conversion the `adopt` reducer uses, and what
# is compared is two `Celsius`.
fn forecastMatches(r: Reading, f: Fahrenheit) -> Bool = r.celsius == toCelsius(f)

# A nominal compares with the base it is declared over, exactly as it assigns —
# so a bare literal needs no wrapping here either.
fn isFreezing(c: Celsius) -> Bool = c <= 0

# `.parse` carries the qualifier's type through the `Option`, so the declared
# return type is what holds it: writing `-> Option(SampleId)` on this body is
# E0201, and so is `-> ReadingId` for the unwrapped shape.
fn readingIdOf(t: Text) -> Option(ReadingId) = ReadingId.parse(t)

# The base is still the bridge one level down: a `ReadingId` renders through the
# `Text` its declaration is over, with nothing to unwrap.
fn shortId(id: ReadingId) -> Text = id.slice(0, 8)

# A record literal must name every declared field and no others: a missing one
# is E0214, an extra one E0215, a mistyped one E0201.
slot reading : Reading      = {label: "outside", celsius: 21, id: "00000000-0000-7000-8000-000000000000"}
# A fresh id of the slot's own type; `SampleId.fresh()` here is E0201.
slot latestId : ReadingId   = ReadingId.fresh()
# What `readingIdOf` answers, at the type it answers with — one level in,
# `SampleId.parse("a")` here is E0201 naming both `Option` types.
slot found   : Option(ReadingId) = None
# A union slot takes one of its own tags; `Warming` would be E0216.
slot status  : Status       = Idle
# `Option(Int)` takes `None` / `Some(n)`, never a bare `n` (E0201).
slot lastRun : Option(Int)  = None
# Every element is checked against the declared element type (E0201 at the element).
slot samples : List(Int)    = [18, 19, 21]
# An Int literal past 2^53-1 is E0217: it would be rounded on the way in.
slot budget  : Int          = 9007199254740991
# A base literal needs no wrapping to reach a nominal slot.
slot forecast : Fahrenheit  = 70

# `.copy(f=v)` is a patch, so naming a subset is the point — but naming a field
# the type does not have is E0215, and a wrong replacement type is E0201.
reducer warmer on=ui.click(WarmBtn)
    do= reading := reading.copy(celsius=reading.celsius + 1)
        status  := Done(reading.celsius)

# `reading.copy(celsius=forecast)` is the E0201 this pair exists to catch, so
# the forecast goes through the conversion that names both types.
reducer adopt on=ui.click(AdoptBtn)
    do= reading := reading.copy(label="forecast", celsius=toCelsius(forecast))
        status  := Loading

reducer reset on=ui.click(ResetBtn)
    do= reading := {label: "outside", celsius: 21, id: latestId}
        status  := Idle
        lastRun := Some(budget)

# Minting an id is the position the identity matters most in, and the one that
# used to be unchecked: `latestId := SampleId.fresh()` is E0201 here.
reducer remint on=ui.click(RemintBtn)
    do= let next = ReadingId.fresh()
        latestId := next
        found    := readingIdOf(next)
        reading  := reading.copy(id=next)

# A tile that declares `in=` is applied like a one-parameter function. Calling
# `Sample` with no argument is E0213 — and used to die at mount with
# `_d_1 is not defined`.
tile Sample in=Int = text($1.show + "°C") {color: "muted"}

tile WarmBtn   = button(text="+1°C", onClick=warmer)
tile AdoptBtn  = button(text="use forecast", onClick=adopt)
tile ResetBtn  = button(text="reset", onClick=reset)
tile RemintBtn = button(text="new id", onClick=remint)

tile App = column(
             heading(reading.label),
             text(reading.celsius.show + "°C = " + toFahrenheit(reading.celsius).show + "°F"),
             text(match status with
                    | Idle       -> "idle"
                    | Loading    -> "loading"
                    | Done(n)    -> "done at " + n.show),
             row(for s in samples Sample(s)) {gap: "sm"},
             text("forecast " + forecast.show + "°F"),
             # Rendered as relations rather than as the ids themselves: a uuid
             # is different every run, so "same" / "len" are what a scenario can
             # assert. `latestId == reading.id` is also the comparison half of
             # the identity (§1.9.4) reading two minted `ReadingId`s.
             text("same " + (latestId == reading.id).show) {color: "muted"},
             text("len " + shortId(reading.id).length.show) {color: "muted"},
             text("parsed " + (match found with
                                 | Some(id) -> shortId(id).length.show
                                 | None     -> "none")) {color: "muted"},
             text(if forecastMatches(reading, forecast) then "matches the forecast"
                  else if isFreezing(reading.celsius) then "freezing"
                  else "above freezing") {color: "muted"},
             row(WarmBtn, AdoptBtn, ResetBtn, RemintBtn) {gap: "sm"})

app ValueTypes
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
