# Feature (routing.md): a `link` or `navigate` target that
# is not a path resolves against the current location, the way a browser
# resolves an href against the page it is on, and the memory router an embed
# mounts with resolves it as the history router does. On `/docs/intro`,
# `?page=2` goes to `/docs/intro?page=2`, `install` to `/docs/install` and
# `../guide` to `/guide`.
#
# `#faq` there is an in-page jump: `route.hash` becomes `Some("faq")`, the FAQ
# heading (`{id: "faq"}`) scrolls into view, and `route.enter` does not run
# again. A query-only move such as `?page=2` stays on the route as well, and
# does run `route.enter` again.
#
# `kumiki run` mounts the history router, which is what this scenario drives;
# packages/tests/src/relative-route-target.test.ts runs the same targets under the
# memory router too.

slot enters : Int = 0

reducer countEnter on=route.enter("/docs/:page") do= enters := enters + 1
reducer toInstall  on=ui.click(InstallBtn)
    do= emit navigate({path: "install", params: {}})

tile InstallBtn = button(text="Install, by navigate", onClick=toInstall)

tile Docs = page(
    heading("Docs " + route.params.get-or("page", "?") + ", page " + route.query.get-or("page", "1")),
    text("hash: " + route.hash.get-or("none")),
    text("entered: " + enters.show),
    link(to="?page=2") {text: "Next page"},
    link(to="#faq") {text: "Jump to FAQ"},
    link(to="install") {text: "Install"},
    link(to="../guide") {text: "Guide"},
    InstallBtn,
    heading("FAQ") {id: "faq"})
tile Guide    = page(heading("Guide"), link(to="docs/intro") {text: "Back to the docs"})
tile NotFound = page(heading("Not found " + route.path))

app MemoryRouterRelativeLink
    caps   = [nav.push]
    routes = {"/docs/:page" -> Docs, "/guide" -> Guide, "/404" -> NotFound}
    init   = []
