# Feature (language.md): an index reads a List or a Map, and a value with no
# places is read by its own member.
#
#   word.slice(0, 1)         not word[0]
#   (score.get-or(0) + 1)    not score[0] + 1
#
# An index names a place — an entry of a Map, a position of a List — so
# `xs[0]` and `ages["ada"]` read a value, and so does a record through a
# literal key, `cfg["label"]`, which is the field the key names. A Text, an
# Int, an Option, a Result, a Tuple and a union have no place an index
# names: reading `word[0]` on a Text is E0238, and writing through it E0602.
# Each is read another way: part of a Text by its member `.slice`, an
# Option's payload by `.get-or`, and the members of a Tuple by a `match`
# that takes them apart.
#
# A read whose receiver the checker cannot decide still runs. A record read
# through a computed key, `cfg[key]`, is a value of no type, so `cfg[key][0]`
# is not reported, and it panics when it runs, showing the value the index
# reached: `Index 0 reaches no List or Map, but "go"` for the Text in the
# field, and `Key "zz" is not in {"label":"go"}` for a key that names no
# field. Those reads are armed by entering a route rather than by a button,
# because `smoke` drives every button and fails on any reported panic.

type Cfg = { label: Text }

slot word   : Text             = "abc"
slot score  : Option(Int)      = Some(1)
slot pair   : Tuple(Text, Int) = ("ada", 36)
slot xs     : List(Int)        = [10, 20]
slot ages   : Map(Text, Int)   = {"ada": 36}
slot cfg    : Cfg              = { label: "go" }
slot key    : Text             = "label"
slot stray  : Text             = "zz"
slot failed : Text             = "-"

reducer bump on=ui.click(Bump)
    do= score := Some(score.get-or(0) + 1)
        xs[0] := xs[0] + 1

reducer read-field on=route.enter("/read-field")
    do= word := cfg[key][0]

reducer read-stray on=route.enter("/read-stray")
    do= word := cfg[stray]

reducer on-panic on=app.error
    do= failed := $event.message

tile Bump = button(text="bump") {id: "bump"}

tile App = column(
  Bump,
  text("first: " + word.slice(0, 1)),
  text("next score: " + (score.get-or(0) + 1).show),
  text("pair: " + match pair with | (name, age) -> name + " is " + age.show),
  text("xs: " + xs[0].show + " ada: " + ages["ada"].show),
  text("label: " + cfg["label"]),
  text("failed: " + failed))

app IndexReadReceivers
  caps   = []
  routes = {"/" -> App, "/read-field" -> App, "/read-stray" -> App, "/404" -> App}
  init   = []
