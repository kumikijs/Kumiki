{
  "effects": {
    "loadTodos": [{ "outcome": "ok", "value": { "_tag": "None" } }]
  },
  "steps": [
    {
      "label": "storage answers 'nothing stored yet', so the list is ready and empty",
      "expect": {
        "noErrors": true,
        "state": { "ready": true, "draft": "" },
        "domIncludes": ["Todos", "0 items left"]
      }
    },
    {
      "label": "a blank draft",
      "do": { "fill": "input[type='text']", "value": "   " }
    },
    {
      "label": "adds nothing, and reports nothing either",
      "do": { "clickText": "Add" },
      "expect": { "noErrors": true, "state": { "todos": {} }, "domIncludes": ["0 items left"] }
    },
    {
      "label": "typing goes into the draft slot, not into the list",
      "do": { "fill": "input[type='text']", "value": "buy milk" },
      "expect": {
        "noErrors": true,
        "state": { "draft": "buy milk" },
        "domExcludes": ["1 items left"]
      }
    },
    {
      "label": "the Add button submits the form, which adds the todo",
      "do": { "clickText": "Add" },
      "expect": {
        "noErrors": true,
        "state": { "draft": "" },
        "domIncludes": ["buy milk", "1 items left"]
      }
    },
    {
      "label": "checking the row marks it done",
      "do": { "click": "input[type='checkbox']" },
      "expect": { "noErrors": true, "domIncludes": ["0 items left"] }
    },
    {
      "label": "and clearing completed removes it",
      "do": { "clickText": "Clear completed" },
      "expect": { "noErrors": true, "domExcludes": ["buy milk"] }
    },
    {
      "label": "a second todo, so the delete button has something to delete",
      "do": { "fill": "input[type='text']", "value": "walk dog" },
      "expect": { "noErrors": true, "state": { "draft": "walk dog" } }
    },
    {
      "label": "submitting the form without the button (Enter) adds it too",
      "do": { "submit": "form" },
      "expect": { "noErrors": true, "domIncludes": ["walk dog", "1 items left"] }
    },
    {
      "label": "the row's own x button removes the todo (the delete path the steps above never take)",
      "do": { "clickText": "x" },
      "expect": { "noErrors": true, "domExcludes": ["walk dog"], "domIncludes": ["0 items left"] }
    },
    {
      "label": "a draft at the length limit is refused, and the form says why",
      "do": {
        "fill": "input[type='text']",
        "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "noErrors": true,
        "state": { "draft": "" },
        "domIncludes": ["Must be less than 280 characters"]
      }
    },
    {
      "label": "and the form holds the submit back",
      "do": { "submit": "form" },
      "expect": {
        "noErrors": true,
        "actionErrorIncludes": ["the field bound to draft fails its validation"],
        "domIncludes": ["0 items left"]
      }
    }
  ]
}
