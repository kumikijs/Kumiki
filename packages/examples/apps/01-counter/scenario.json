{
  "steps": [
    {
      "label": "the count starts at its lower bound",
      "expect": { "noErrors": true, "state": { "count": 0 }, "domIncludes": ["Count: 0"] }
    },
    {
      "label": "decrementing at 0 is refused by the reducer's own guard, not by the type",
      "do": { "clickText": "-" },
      "expect": { "noErrors": true, "state": { "count": 0 }, "domIncludes": ["Count: 0"] }
    },
    {
      "label": "+ counts up",
      "do": { "clickText": "+" },
      "expect": { "noErrors": true, "state": { "count": 1 }, "domIncludes": ["Count: 1"] }
    },
    {
      "label": "and again",
      "do": { "clickText": "+" },
      "expect": { "noErrors": true, "state": { "count": 2 }, "domIncludes": ["Count: 2"] }
    },
    {
      "label": "- counts back down",
      "do": { "clickText": "-" },
      "expect": { "noErrors": true, "state": { "count": 1 }, "domIncludes": ["Count: 1"] }
    },
    {
      "label": "reset returns to zero",
      "do": { "clickText": "reset" },
      "expect": { "noErrors": true, "state": { "count": 0 }, "domIncludes": ["Count: 0"] }
    }
  ]
}
