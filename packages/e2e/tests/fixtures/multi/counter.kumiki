# Multi-mount fixture: minimal click-driven counter (no theme, no custom caps)
# co-mounted with binder.kumiki to verify two apps on one page stay isolated.

slot count : Int = 0

reducer inc on=ui.click(IncBtn) do= count := count + 1

tile IncBtn = button(text="+1", onClick=inc)
tile App = column(heading("Count: " + count.show), IncBtn)

app MultiCounter
    caps   = []
    routes = {"/" -> App, "/404" -> App}
    init   = []
