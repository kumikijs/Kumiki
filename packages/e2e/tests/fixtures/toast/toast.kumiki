# The `toast` effect's banner in a real browser: an `info` toast goes after its
# kind's default of 3000ms, and an `error` toast stays until it is dismissed. The
# page is twice the viewport's height, so a banner that is not fixed to the
# viewport lands below the fold.

reducer info  on=ui.click(InfoBtn)  do= emit toast({kind: "info", text: "Saved"})
reducer error on=ui.click(ErrorBtn) do= emit toast({kind: "error", text: "Failed"})

tile InfoBtn  = button(text="Show info", onClick=info)
tile ErrorBtn = button(text="Show error", onClick=error)
tile App      = column(InfoBtn, ErrorBtn) {min-h: "200vh"}

app Toasts
    caps   = [notification.show]
    routes = {"/" -> App, "/404" -> App}
    init   = []
